import { createContext, useContext, useState, useCallback, type ReactNode } from "react"
import { callOperation } from "./records"

interface User {
  id: string
  [key: string]: unknown
}

interface AuthState {
  token: string | null
  user: User | null
  loading: boolean
}

interface AuthContextValue extends AuthState {
  login: (credentials: Record<string, string>) => Promise<void>
  logout: () => void
  isAuthenticated: boolean
}

const AuthContext = createContext<AuthContextValue | null>(null)

const TOKEN_KEY = "admin_token"
const USER_KEY = "admin_user"
{% set identity = context.entities.values() | selectattr("serves_login") | first %}

function getStored(): { token: string | null; user: User | null } {
  try {
    const token = localStorage.getItem(TOKEN_KEY)
    const raw = localStorage.getItem(USER_KEY)
    const user = raw ? JSON.parse(raw) : null
    return { token, user }
  } catch {
    return { token: null, user: null }
  }
}

export function AuthProvider({ children }: { children: ReactNode }) {
  const stored = getStored()
  const [state, setState] = useState<AuthState>({
    token: stored.token,
    user: stored.user,
    loading: false,
  })

  const login = useCallback(async (credentials: Record<string, string>) => {
    setState((s) => ({ ...s, loading: true }))
{% if identity %}
    const res = await callOperation("{{ identity.name }}", "login", {
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(credentials),
    })
    if (!res.ok) {
      setState((s) => ({ ...s, loading: false }))
      const body = await res.json().catch(() => ({}))
      throw new Error(body.detail || "Invalid credentials")
    }
    const data = await res.json()
    const token = data.token || data.access_token
    const user = data.user || data
    localStorage.setItem(TOKEN_KEY, token)
    localStorage.setItem(USER_KEY, JSON.stringify(user))
    setState({ token, user, loading: false })
{% else %}
    throw new Error("No identity serves login")
{% endif %}
  }, [])

  const logout = useCallback(() => {
    localStorage.removeItem(TOKEN_KEY)
    localStorage.removeItem(USER_KEY)
    setState({ token: null, user: null, loading: false })
  }, [])

  const value = { ...state, login, logout, isAuthenticated: !!state.token }

  return (
    <AuthContext.Provider value={value}>
      {children}
    </AuthContext.Provider>
  )
}

export function useAuth() {
  const ctx = useContext(AuthContext)
  if (!ctx) throw new Error("useAuth must be used within AuthProvider")
  return ctx
}

export function getAuthToken(): string | null {
  return localStorage.getItem(TOKEN_KEY)
}
