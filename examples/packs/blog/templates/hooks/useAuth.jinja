import { callOperation, readJson } from "../records"

const send = (body: Record<string, unknown>) => ({
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify(body),
})

export function use{{ entity.name | pascal_case }}Auth() {
  return {
{% for operation in ("login", "register") if operation in entity.operations %}
    {{ operation }}: (body: Record<string, unknown>) =>
      callOperation("{{ entity.name }}", "{{ operation }}", send(body)).then(readJson),
{% endfor %}
  }
}
