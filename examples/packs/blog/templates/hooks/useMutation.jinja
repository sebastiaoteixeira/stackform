import { callOperation } from "../records"
import { authHeaders } from "../lib/api"

const send = (body: Record<string, unknown>) => ({ headers: authHeaders(), body: JSON.stringify(body) })

export function use{{ entity.name | pascal_case }}Mutation() {
  return {
{% if "create" in entity.operations %}
    create: (data: Record<string, unknown>) => callOperation("{{ entity.name }}", "create", send(data)),
{% endif %}
{% if entity.edit_operation %}
    update: (id: string, data: Record<string, unknown>) =>
      callOperation("{{ entity.name }}", "{{ entity.edit_operation }}", { id, ...send(data) }),
{% endif %}
{% if "delete" in entity.operations %}
    remove: (id: string) => callOperation("{{ entity.name }}", "delete", { id, headers: authHeaders() }),
{% endif %}
  }
}
