import { apiFetch } from "../lib/api"

export function use{{ entity.name | pascal_case }}Mutation() {
  return {
    create: async (data: Record<string, unknown>) => {
      return apiFetch("/{{ entity.repository_name }}", {
        method: "POST",
        body: JSON.stringify(data),
      })
    },
    update: async (id: string, data: Record<string, unknown>) => {
      return apiFetch(`/{{ entity.repository_name }}/${id}`, {
        method: "PATCH",
        body: JSON.stringify(data),
      })
    },
    remove: async (id: string) => {
      return apiFetch(`/{{ entity.repository_name }}/${id}`, {
        method: "DELETE",
      })
    },
  }
}
