import json
import os
import re
from typing import Any

from dependencies.mongodb import connect_db, close_db, get_database
{% for col_name in collections %}
from repositories.{{ col_name }} import {{ col_name | capitalize_collection }}Repository
from services.{{ col_name }} import {{ col_name | capitalize_collection }}Service
{% endfor %}
from services.exceptions import NotFoundError, ValidationError
{% if ctx.auth.enabled %}
from dependencies.auth import resolve_principal
{% endif %}
{% if ctx.auth.has_password_auth %}
from dependencies.auth import verify_password
from dependencies.jwt_utils import create_jwt_token
{% endif %}
import validation


_INVALID_JSON: Any = object()
_PREFIX = "{{ ctx.app.base_path }}{% if ctx.app.api_version %}/{{ ctx.app.api_version }}{% endif %}"


{% set crud_routes = routes | rejectattr("operation", "equalto", "login") | list %}
{% for route in crud_routes %}
{% set handler_name = "handle_" ~ route.operation ~ "_" ~ route.collection %}
async def {{ handler_name }}(url_params: dict, body: dict | None, headers: dict[str, str]) -> tuple[int, Any]:
    db = get_database()
    repo = {{ route.collection | capitalize_collection }}Repository(db)
    service = {{ route.collection | capitalize_collection }}Service(repo)
{% if route.needs_auth %}
    principal = await resolve_principal(headers, db)
    if principal is None:
        return 401, {"detail": "Unauthorized"}
{% endif %}
    try:
{% if route.operation == "list" %}
        documents = await service.list()
        return 200, documents
{% elif route.operation == "get" %}
        document = await service.get(url_params["id"])
        return 200, document
{% elif route.operation == "create" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ route.collection }}_create(body)
        document = await service.create(data)
        return 200, document
{% elif route.operation == "update" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ route.collection }}_update(body)
        document = await service.update(url_params["id"], data)
        return 200, document
{% elif route.operation == "replace" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ route.collection }}_replace(body)
        document = await service.replace(url_params["id"], data)
        return 200, document
{% elif route.operation == "delete" %}
        document = await service.delete(url_params["id"])
        return 200, document
{% endif %}
    except NotFoundError:
        return 404, {"detail": "Resource not found"}
    except ValidationError as exc:
        return 422, {"detail": exc.message}

{% endfor %}

{% for identity in ctx.auth.identity_collections %}
{% if "password" in identity.via and identity.identifier %}
async def handle_login_{{ identity.name }}(url_params: dict, body: dict | None, headers: dict[str, str]) -> tuple[int, Any]:
    if body is None:
        return 422, {"detail": "Request body is required"}
    try:
        data = validation.validate_{{ identity.name }}_login(body)
    except ValueError as exc:
        return 422, {"detail": str(exc)}

    db = get_database()
    col = db["{{ identity.name }}"]
    cursor = col.find({})
    docs = await cursor.to_list(length=None)

    for doc in docs:
        if str(doc.get("{{ identity.identifier }}", "")) != data[{{ identity.identifier | tojson }}]:
            continue
        stored_hash = doc.get("passwordHash")
        if not isinstance(stored_hash, str):
            continue
        if not verify_password(data["password"], stored_hash):
            continue

        subject = doc.get("{{ identity.id_field }}")
        if subject is None:
            continue

        token = create_jwt_token(str(subject), "{{ identity.name }}")
        safe_user = {
            k: v for k, v in doc.items()
            if k not in ("password", "passwordHash", "_id")
        }
        return 200, {"token": token, "user": safe_user}

    return 401, {"detail": "Invalid credentials"}

{% endif %}
{% endfor %}

ROUTES: dict[str, list[tuple[re.Pattern[str], Any]]] = {}
{% for route in crud_routes %}
{% set handler_name = "handle_" ~ route.operation ~ "_" ~ route.collection %}
ROUTES.setdefault("{{ route.method }}", []).append((re.compile(r"^" + _PREFIX + r"{{ route.path | path_to_regex }}$"), {{ handler_name }}))
{% endfor %}
{% for identity in ctx.auth.identity_collections %}
{% if "password" in identity.via and identity.identifier %}
ROUTES.setdefault("POST", []).append((re.compile(r"^" + _PREFIX + r"/{{ identity.name }}/login$"), handle_login_{{ identity.name }}))
{% endif %}
{% endfor %}


class ASGIApp:
    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] == "lifespan":
            await self._handle_lifespan(scope, receive, send)
            return
        if scope["type"] == "http":
            await self._handle_http(scope, receive, send)
            return

    async def _handle_lifespan(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        while True:
            message = await receive()
            if message["type"] == "lifespan.startup":
                connect_db()
                await send({"type": "lifespan.startup.complete"})
            elif message["type"] == "lifespan.shutdown":
                close_db()
                await send({"type": "lifespan.shutdown.complete"})
                return

    async def _handle_http(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        method = scope["method"].upper()
        path = scope["path"]

        handler, url_params = self._match_route(method, path)
        if handler is None:
            await self._send_json(send, 404, {"detail": "Not found"})
            return

        body = await self._read_body(receive)
        if body is _INVALID_JSON:
            await self._send_json(send, 400, {"detail": "Invalid JSON body"})
            return

        headers = {
            k.decode("latin-1"): v.decode("latin-1")
            for k, v in scope.get("headers", [])
        }

        try:
            status, data = await handler(url_params, body, headers)
        except ValueError as exc:
            await self._send_json(send, 422, {"detail": str(exc)})
            return

        await self._send_json(send, status, data)

    @staticmethod
    def _match_route(method: str, path: str) -> tuple[Any, dict[str, str]]:
        entries = ROUTES.get(method, [])
        for pattern, handler in entries:
            match = pattern.match(path)
            if match:
                return handler, match.groupdict()
        return None, {}

    @staticmethod
    async def _read_body(receive: Any) -> dict[str, Any] | None:
        body = b""
        while True:
            message = await receive()
            body += message.get("body", b"")
            if not message.get("more_body", False):
                break
        if not body:
            return None
        try:
            return json.loads(body)
        except (json.JSONDecodeError, UnicodeDecodeError):
            return _INVALID_JSON

    @staticmethod
    async def _send_json(send: Any, status: int, data: Any) -> None:
        body = json.dumps(data, default=str).encode("utf-8")
        await send({
            "type": "http.response.start",
            "status": status,
            "headers": [
                [b"content-type", b"application/json"],
                [b"content-length", str(len(body)).encode("latin-1")],
            ],
        })
        await send({"type": "http.response.body", "body": body})


app = ASGIApp()

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        "app:app",
        host=os.environ.get("HOST", "127.0.0.1"),
        port=int(os.environ.get("PORT", "8000")),
        reload=True,
    )
