from typing import Any

from fastapi import APIRouter, Form, HTTPException, Request
from fastapi.responses import RedirectResponse, Response
from onelogin.saml2.auth import OneLogin_Saml2_Auth
from onelogin.saml2.idp_metadata_parser import OneLogin_Saml2_IdPMetadataParser

from dependencies.mongodb import get_database
from dependencies.jwt_utils import create_jwt_token

router = APIRouter()


def _build_saml_settings(
    idp_metadata_url: str,
    sp_entity_id: str,
    acs_url: str,
    sls_url: str,
) -> dict[str, Any]:
    idp_data = OneLogin_Saml2_IdPMetadataParser.parse_remote(idp_metadata_url)
    return {
        **idp_data,
        "sp": {
            "entityId": sp_entity_id,
            "assertionConsumerService": {"url": acs_url, "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"},
            "singleLogoutService": {"url": sls_url, "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"},
            "NameIDFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        },
        "strict": True,
        "debug": False,
        "security": {"requestedAuthnContext": False},
    }


async def _prepare_saml_request(request: Request) -> dict[str, Any]:
    form = await request.form() if request.method == "POST" else {}
    return {
        "https": "on" if request.url.scheme == "https" else "off",
        "http_host": request.headers.get("host", ""),
        "server_port": str(request.url.port or ""),
        "script_name": request.url.path,
        "get_data": dict(request.query_params),
        "post_data": dict(form),
    }


{% for col in auth.identity_collections %}
{% for binding in col.bindings %}
{% set provider = auth.providers.get(binding.provider) %}
{% if provider and provider.type == "saml" %}
{% set provider_name = binding.provider %}

@router.get("/{{ col.name }}/auth/{{ provider_name }}")
async def saml_{{ col.name }}_{{ provider_name }}_login(request: Request) -> RedirectResponse:
    base = str(request.base_url).rstrip("/")
    acs_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/callback"
    sls_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/logout"
    settings = _build_saml_settings(
        "{{ provider.idp_metadata_url }}",
        "{{ provider.sp_entity_id }}",
        acs_url,
        sls_url,
    )
    req = await _prepare_saml_request(request)
    saml_auth = OneLogin_Saml2_Auth(req, settings)
    return RedirectResponse(url=saml_auth.login())


@router.post("/{{ col.name }}/auth/{{ provider_name }}/callback")
async def saml_{{ col.name }}_{{ provider_name }}_callback(
    request: Request, SAMLResponse: str = Form(...)
) -> Any:
    base = str(request.base_url).rstrip("/")
    acs_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/callback"
    sls_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/logout"
    settings = _build_saml_settings(
        "{{ provider.idp_metadata_url }}",
        "{{ provider.sp_entity_id }}",
        acs_url,
        sls_url,
    )
    req = await _prepare_saml_request(request)
    saml_auth = OneLogin_Saml2_Auth(req, settings)
    saml_auth.process_response()
    errors = saml_auth.get_errors()
    if errors:
        raise HTTPException(status_code=401, detail=f"SAML error: {', '.join(errors)}")
    if not saml_auth.is_authenticated():
        raise HTTPException(status_code=401, detail="SAML authentication failed")

    saml_attrs = saml_auth.get_attributes()
    name_id = saml_auth.get_nameid()

    claim_mapping: dict[str, str] = {{ binding.claim_mapping | tojson }}
    user_fields: dict[str, Any] = {}
    for local_field, saml_attr in claim_mapping.items():
        values = saml_attrs.get(saml_attr, [])
        if values:
            user_fields[local_field] = values[0]

    if "{{ binding.identifier }}" not in user_fields:
        user_fields["{{ binding.identifier }}"] = name_id

    db = get_database()
    collection = db["{{ col.name }}"]

    existing = await collection.find_one({"{{ binding.identifier }}": user_fields.get("{{ binding.identifier }}")})

    if existing is not None:
        subject = existing.get("{{ col.id_field }}")
        token = create_jwt_token(str(subject), "{{ col.name }}")
        safe_user = {k: v for k, v in existing.items() if k not in ("_id", "_auth")}
        return {"token": token, "user": safe_user}

    {% if binding.auto_provision %}
    import uuid as _uuid
    new_id = str(_uuid.uuid4())
    user_fields["{{ col.id_field }}"] = new_id
    await collection.insert_one(user_fields)
    token = create_jwt_token(new_id, "{{ col.name }}")
    safe_user = {k: v for k, v in user_fields.items() if k not in ("_id", "_auth")}
    return {"token": token, "user": safe_user}
    {% else %}
    raise HTTPException(status_code=403, detail="User not found and auto-provisioning is disabled")
    {% endif %}


@router.get("/{{ col.name }}/auth/{{ provider_name }}/metadata")
async def saml_{{ col.name }}_{{ provider_name }}_metadata(request: Request) -> Response:
    base = str(request.base_url).rstrip("/")
    acs_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/callback"
    sls_url = f"{base}/{{ col.name }}/auth/{{ provider_name }}/logout"
    settings = _build_saml_settings(
        "{{ provider.idp_metadata_url }}",
        "{{ provider.sp_entity_id }}",
        acs_url,
        sls_url,
    )
    req = await _prepare_saml_request(request)
    saml_auth = OneLogin_Saml2_Auth(req, settings)
    metadata = saml_auth.get_settings().get_sp_metadata()
    return Response(content=metadata, media_type="application/xml")

{% endif %}
{% endfor %}
{% endfor %}
