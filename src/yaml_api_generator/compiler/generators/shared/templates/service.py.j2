    def _validate_identity_fields(data: dict) -> None:
{% for field_name in identity_fields %}
        if not isinstance(data.get("{{ field_name }}"), str) or not data.get("{{ field_name }}", "").strip():
            raise ValidationError("{{ field_name }}", "Missing required field: {{ field_name }}")
{% endfor %}
