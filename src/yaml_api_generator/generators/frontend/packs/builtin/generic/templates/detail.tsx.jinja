interface {{ collection_name | pascal_case }}DetailProps {
  record: any;
  onEdit?: () => void;
  onDelete?: () => void;
}

export function {{ collection_name | pascal_case }}Detail({ record, onEdit, onDelete }: {{ collection_name | pascal_case }}DetailProps) {
  return (
    <div className="max-w-4xl mx-auto">
      <div className="mb-6 flex items-center justify-between">
        <h2 className="text-2xl font-semibold">{{ collection_name | title }} Details</h2>
        <div className="flex items-center gap-2">
          <button
            onClick={onEdit}
            className="px-3 py-1.5 border border-gray-300 rounded-md hover:bg-gray-50 text-sm"
          >
            Edit
          </button>
          <button
            onClick={onDelete}
            className="px-3 py-1.5 border border-red-300 text-red-600 rounded-md hover:bg-red-50 text-sm"
          >
            Delete
          </button>
        </div>
      </div>

      <div className="bg-white border border-gray-200 rounded-lg p-6 space-y-4">
        <div className="grid grid-cols-2 gap-4">
          <div>
            <span className="text-sm text-gray-500">ID</span>
            <div className="font-mono text-sm">{record.id}</div>
          </div>
          {% for field in detail_fields %}
          <div>
            <span className="text-sm text-gray-500">{{ field.label }}</span>
            <div className="font-medium">{record.{{ field.name }}}</div>
          </div>
          {% endfor %}
        </div>

        {% if relationships %}
        <div className="pt-6 border-t border-gray-200">
          <h3 className="font-medium mb-4">Related Records</h3>
          <div className="space-y-2">
            {% for rel in relationships %}
            <div className="text-sm">
              <span className="text-gray-500">{{ rel.label }}:</span>{' '}
              <span className="text-blue-600 hover:underline cursor-pointer">
                View {{ rel.count }} records
              </span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  );
}
