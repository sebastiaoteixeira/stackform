interface OnboardingStep {
  label: string;
  description: string;
  done: boolean;
  active?: boolean;
  action?: () => void;
}

interface EmptyOnboardingProps {
  title?: string;
  subtitle?: string;
  steps?: OnboardingStep[];
}

export function EmptyOnboarding({
  title = {{ props.title.value | tojson }},
  subtitle = 'A few steps and you\'re running.',
  steps = {{ props.steps.value | tojson }},
}: EmptyOnboardingProps) {
  return (
    <div className="flex justify-center px-4 py-10">
      <div className="w-full" style={{ "{{" }} maxWidth: '540px' {{ "}}" }}>
        <h2 className="font-title text-3xl text-wf-ink mb-1">{title}</h2>
        <p className="text-sm text-wf-ink-dim mb-8">{subtitle}</p>

        <div className="flex flex-col gap-2">
          {steps.map((step, index) => (
            <div
              key={index}
              className={`flex items-center gap-4 px-4 py-3 rounded-wf border-[1.5px] transition-colors ${
                step.active
                  ? 'border-wf-accent bg-wf-accent-soft'
                  : 'border-wf-line bg-wf-surface'
              } ${step.done ? 'opacity-50' : ''}`}
            >
              {/* Checkbox */}
              <div
                className={`flex-shrink-0 w-5 h-5 rounded border-[1.5px] flex items-center justify-center ${
                  step.done
                    ? 'bg-wf-accent border-wf-accent'
                    : 'border-wf-line-strong bg-wf-bg'
                }`}
              >
                {step.done && (
                  <svg className="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={3} d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </div>

              {/* Content */}
              <div className="flex-1 min-w-0">
                <div className={`text-sm font-medium ${step.done ? 'line-through text-wf-ink-faint' : 'text-wf-ink'}`}>
                  {step.label}
                </div>
                <div className="wf-mono text-xs text-wf-ink-dim mt-0.5 truncate">
                  {step.description}
                </div>
              </div>

              {step.active && step.action && !step.done && (
                <button onClick={step.action} className="wf-btn wf-btn-sm wf-btn-primary flex-shrink-0">
                  Start
                </button>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export default EmptyOnboarding;
