{% set roles = props.field_roles.value if props.field_roles is defined else {} %}
{% set image_field = entity.fields[roles.image] if roles.image is defined else none %}
{% set title_field = entity.fields[roles.title] if roles.title is defined else none %}
{% set status_field = entity.fields[roles.status] if roles.status is defined else none %}
{% set date_field = entity.fields[roles.date] if roles.date is defined else none %}
{% set author_field = entity.fields[roles.author] if roles.author is defined else none %}
import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../__generated__/App';
import { {% if title_field or status_field or author_field %}displayValue, {% endif %}listRecords } from '../__generated__/records';

interface {{ entity.name | pascal_case }} {
  {{ entity.pk_field }}: string;
  {% for field in entity.fields.values() %}
  {{ field.name }}: {% if field.type == 'string' %}string{% elif field.type == 'number' %}number{% elif field.type == 'boolean' %}boolean{% else %}any{% endif %};
  {% endfor %}
}

export default function {{ view.name | pascal_case }}() {
  const [items, setItems] = useState<{{ entity.name | pascal_case }}[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [viewMode, setViewMode] = useState<'grid' | 'list'>('grid');
  const { token } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    listRecords('{{ entity.name }}', headers)
      .then(data => {
        setItems(data);
        setLoading(false);
      })
      .catch(err => {
        setError(err.message);
        setLoading(false);
      });
  }, [token]);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-wf-ink-dim">Loading...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf p-4">
          <p className="text-wf-ink font-medium mb-1">Error loading data</p>
          <p className="text-wf-ink-dim text-sm">{error}</p>
        </div>
      </div>
    );
  }

  if (items.length === 0) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-center p-12 border-[1.5px] border-dashed border-wf-line rounded-lg max-w-md">
          <div className="w-[60px] h-[60px] mx-auto mb-4 border-[1.5px] border-dashed border-wf-line rounded-lg flex items-center justify-center">
            <span className="font-title text-2xl text-wf-ink-faint">∅</span>
          </div>
          <h3 className="font-title text-xl text-wf-ink mb-2">No {{ entity.name | lower }}s yet</h3>
          <p className="text-wf-ink-dim text-sm mb-4">Create your first record to get started.</p>
          <button onClick={() => navigate('{{ view.path }}/new')} className="wf-btn wf-btn-primary">
            + New {{ entity.name | title }}
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="h-full flex flex-col">
      {/* Toolbar */}
      <div className="wf-toolbar px-6 pt-4">
        <h1 className="font-title text-2xl text-wf-ink">{{ entity.name | title }}</h1>
        <span className="wf-mono text-wf-ink-dim">{items.length} records</span>
        <div className="flex-1" />

        {/* View toggle */}
        <div className="flex border border-wf-line rounded-[5px] overflow-hidden">
          <button
            onClick={() => setViewMode('grid')}
            className={`px-2.5 py-1.5 text-sm transition-colors ${
              viewMode === 'grid'
                ? 'bg-wf-accent-soft text-wf-accent-ink'
                : 'bg-wf-surface text-wf-ink-dim hover:bg-wf-fill'
            }`}
            title="Grid view"
          >
            ▦
          </button>
          <button
            onClick={() => setViewMode('list')}
            className={`px-2.5 py-1.5 text-sm border-l border-wf-line transition-colors ${
              viewMode === 'list'
                ? 'bg-wf-accent-soft text-wf-accent-ink'
                : 'bg-wf-surface text-wf-ink-dim hover:bg-wf-fill'
            }`}
            title="List view"
          >
            ≡
          </button>
        </div>

        <button
          onClick={() => navigate('{{ view.path }}/new')}
          className="wf-btn wf-btn-primary"
        >
          + New
        </button>
      </div>

      <div className="flex-1 overflow-auto px-6 pb-6">
        {viewMode === 'grid' ? (
          {% raw %}<div className="grid gap-4" style={{ gridTemplateColumns: 'repeat(4, minmax(0, 1fr))' }}>{% endraw %}
            {items.map((item) => (
              <div
                key={item.{{ entity.pk_field }}}
                onClick={() => navigate(`{{ view.path }}/${item.{{ entity.pk_field }}}`)}
                className="wf-card cursor-pointer hover:border-wf-line-strong transition-colors group overflow-hidden p-0"
              >
                {/* Cover image */}
                {% if image_field %}
                <div className="aspect-video w-full bg-wf-fill overflow-hidden">
                  {item.{{ image_field.name }} ? (
                    <img
                      src={item.{{ image_field.name }}}
                      alt=""
                      className="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200"
                    />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center text-wf-ink-faint">
                      <svg className="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                </div>
                {% endif %}

                <div className="p-4">
                  <div className="flex items-start justify-between gap-2 mb-1.5">
                    <h3 className="font-title text-base text-wf-ink line-clamp-2 leading-snug">
                      {% if title_field %}
                      {displayValue(item.{{ title_field.name }})}
                      {% else %}
                      <span className="wf-mono text-sm">{String(item.{{ entity.pk_field }}).slice(0, 8)}…</span>
                      {% endif %}
                    </h3>
                    {% if status_field %}
                    <span className="wf-badge shrink-0">{displayValue(item.{{ status_field.name }})}</span>
                    {% endif %}
                  </div>

                  <div className="flex items-center justify-between mt-3 text-xs text-wf-ink-dim">
                    {% if date_field %}
                    <span className="wf-mono">
                      {new Date(item.{{ date_field.name }}).toLocaleDateString()}
                    </span>
                    {% endif %}
                    {% if author_field %}
                    <span className="truncate max-w-[80px]">{displayValue(item.{{ author_field.name }})}</span>
                    {% endif %}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          /* List fallback */
          <div className="border border-wf-line rounded-wf overflow-hidden bg-wf-surface">
            <table className="wf-table">
              <thead>
                <tr>
                  {% if title_field %}
                  <th>{{ title_field.name | title }}</th>
                  {% else %}
                  <th className="w-36">ID</th>
                  {% endif %}
                  {% if status_field %}
                  <th className="w-28">{{ status_field.name | title }}</th>
                  {% endif %}
                  {% if date_field %}
                  <th className="w-32">{{ date_field.name | title }}</th>
                  {% endif %}
                  {% if author_field %}
                  <th className="w-32">{{ author_field.name | title }}</th>
                  {% endif %}
                </tr>
              </thead>
              <tbody>
                {items.map((item) => (
                  <tr
                    key={item.{{ entity.pk_field }}}
                    onClick={() => navigate(`{{ view.path }}/${item.{{ entity.pk_field }}}`)}
                    className="cursor-pointer"
                  >
                    <td className="font-medium text-wf-ink">
                      {% if title_field %}
                      {displayValue(item.{{ title_field.name }})}
                      {% else %}
                      <span className="wf-mono">{String(item.{{ entity.pk_field }}).slice(0, 8)}…</span>
                      {% endif %}
                    </td>
                    {% if status_field %}
                    <td><span className="wf-badge">{displayValue(item.{{ status_field.name }})}</span></td>
                    {% endif %}
                    {% if date_field %}
                    <td>
                      <span className="wf-mono text-wf-ink-dim">
                        {new Date(item.{{ date_field.name }}).toLocaleDateString()}
                      </span>
                    </td>
                    {% endif %}
                    {% if author_field %}
                    <td className="text-wf-ink-dim">{displayValue(item.{{ author_field.name }})}</td>
                    {% endif %}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
