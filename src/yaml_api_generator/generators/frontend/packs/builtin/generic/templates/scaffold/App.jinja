{% set ns = namespace(login_view=none) %}
{% for view in views.values() %}
{% if view.path == '/login' %}
{% set ns.login_view = view %}
{% endif %}
{% endfor %}
{% set login_view = ns.login_view %}
{% set login_entity = context.entities.values() | selectattr('serves_login') | first %}
{% set account_entity = context.account_entity %}
{% set provider_entity = context.entities.values() | selectattr('auth_providers') | first %}
{% set signs_in = login_view or account_entity or provider_entity %}
{% set sign_in_page = login_view.name | pascal_case if login_view else 'LoginPage' %}
{% macro route(path, page, entity, operation) %}
{% if not entity %}
            <Route path="{{ path }}" element={<{{ page }} />} />
{% elif operation in entity.operations %}
            <Route path="{{ path }}" element={<Allowed entity={{ entity.name | tojson }} operation={{ operation | tojson }} fallback={<Denied />}><{{ page }} /></Allowed>} />
{% endif %}
{% endmacro %}
import { useState, {% if context.identity_entities %}useEffect, {% endif %}createContext, useContext, type ReactNode } from 'react';
import { Routes, Route, Link, {% if signs_in %}Navigate, {% endif %}{% if context.identity_entities %}useNavigate, {% endif %}useLocation } from 'react-router-dom';
import { API_BASE_URL } from './config';
import { ROLES, allows, grants, {% if login_entity %}callerOf, {% endif %}type Caller } from './access';
import { {% if account_entity %}callOperation, failure, {% endif %}type Operation } from './records';
{% if account_entity and not login_view %}
import { Auth } from './auth.tsx';
{% endif %}
{% for view in views.values() %}
import {{ view.name | pascal_case }} from '../pages/{{ view.name | pascal_case }}';
{% if view.name in crud_views %}
import {{ view.name | pascal_case }}Form from '../pages/{{ view.name | pascal_case }}Form';
import {{ view.name | pascal_case }}Detail from '../pages/{{ view.name | pascal_case }}Detail';
{% endif %}
{% endfor %}

interface AuthContextType {
  token: string | null;
  user: any | null;
  caller: Caller | null;
{% if login_entity %}
  login: (identifier: string, password: string) => Promise<void>;
{% endif %}
  logout: () => Promise<void>;
}

const AuthContext = createContext<AuthContextType | null>(null);

export function useAuth() {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error('useAuth must be inside AuthProvider');
  return ctx;
}

/** `children` when the server may serve `operation` on `entity` to the caller, else `fallback`. */
export function Allowed({ entity, operation, children, fallback = null }: {
  entity: string;
  operation: Operation;
  children: ReactNode;
  fallback?: ReactNode;
}) {
  const { caller } = useAuth();
  return <>{allows(entity, operation, caller) ? children : fallback}</>;
}

/** What a caller sees in place of a page the server refuses it{% if signs_in %}: an anonymous one signs in{% endif %}. */
export function Denied() {
{% if signs_in %}
  const { caller } = useAuth();
  if (!caller) return <Navigate to="/login" replace />;
{% endif %}
  return <div className="p-6 text-wf-ink-dim">You do not have access to this page.</div>;
}

/** The options of `identity`'s roles field; one the caller may not grant is disabled, as the server would drop it. */
export function RoleOptions({ identity }: { identity: string }) {
  const { caller } = useAuth();
  return (
    <>
      {ROLES[identity].values.map((role) => (
        <option key={role} value={role} disabled={!grants(caller, role)}>
          {role.charAt(0).toUpperCase() + role.slice(1)}
        </option>
      ))}
    </>
  );
}

{% if context.identity_entities %}
export function ExternalProviders({ collection }: { collection: string }) {
  const [providers, setProviders] = useState<{ name: string; type: string }[]>([]);
  useEffect(() => {
    fetch(`${API_BASE_URL}/${collection}/auth/providers`)
      .then(r => (r.ok ? r.json() : []))
      .then(setProviders)
      .catch(() => setProviders([]));
  }, [collection]);
  if (!providers.length) return null;
  return (
    <>
      <div style={{ "{{" }} textAlign: 'center', margin: '6px 0', color: 'var(--wf-ink-faint)', fontSize: 12 {{ "}}" }}>or</div>
      <div style={{ "{{" }} display: 'flex', flexDirection: 'column', gap: 8 {{ "}}" }}>
        {providers.map(p => (
          <button
            key={p.name}
            type="button"
            onClick={() => {
              localStorage.setItem('sso_logout_path', `${collection}/auth/${p.name}/logout`);
              window.location.href = `${API_BASE_URL}/${collection}/auth/${p.name}`;
            }}
            style={{ "{{" }} width: '100%', height: 36, borderRadius: 5, background: 'var(--wf-surface)', border: '1.5px solid var(--wf-line-strong)', color: 'var(--wf-ink)', fontSize: 14, cursor: 'pointer' {{ "}}" }}
          >
            Continue with {p.name.charAt(0).toUpperCase() + p.name.slice(1)}
          </button>
        ))}
      </div>
    </>
  );
}
{% endif %}

{% if signs_in and not login_view %}
function LoginPage() {
{% if account_entity %}
{% set both = account_entity.serves_login and account_entity.serves_register %}
  const [mode{% if both %}, setMode{% endif %}] = useState<'login' | 'register'>({{ ('login' if account_entity.serves_login else 'register') | tojson }});
  const [error, setError] = useState('');
  const [notice, setNotice] = useState('');
{% if login_entity %}
  const { login } = useAuth();
  const navigate = useNavigate();
{% endif %}

  const handleSubmit = async (formData: any) => {
    setError('');
    setNotice('');

    try {
{% if account_entity.serves_register %}
      if (mode === 'register') {
        const res = await callOperation('{{ account_entity.name }}', 'register', {
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
        if (!res.ok) throw await failure(res, 'Registration failed');
        setNotice('Account created');
{% if both %}
        setMode('login');
{% endif %}
        return;
      }
{% endif %}
{% if login_entity %}

      await login(formData.{{ login_entity.auth_identifier }}, formData.password);
      navigate('/');
{% endif %}
    } catch (err: any) {
      setError(err.message || `${mode === 'login' ? 'Login' : 'Registration'} failed`);
    }
  };
{% endif %}

  return (
    <>
{% if account_entity %}
      {(error || notice) && (
        <div className={`fixed top-4 right-4 max-w-md p-4 border-l-[3px] rounded-wf shadow-lg z-50 ${error ? 'bg-wf-danger-soft border-wf-danger' : 'bg-wf-accent-soft border-wf-accent'}`}>
          <p className="text-wf-ink text-sm">{error || notice}</p>
        </div>
      )}
      <Auth
        mode={mode}
        onSubmit={handleSubmit}
{% if both %}
        onToggleMode={() => setMode(mode === 'login' ? 'register' : 'login')}
{% endif %}
      />
{% endif %}
{% if provider_entity %}
      <ExternalProviders collection="{{ provider_entity.repository_name }}" />
{% endif %}
    </>
  );
}
{% endif %}

{% if context.identity_entities %}
function AuthCallback({ onToken }: { onToken: (t: string) => void }) {
  const navigate = useNavigate();
  useEffect(() => {
    const code = new URLSearchParams(window.location.search).get('code');
    if (!code) {
      navigate('/login', { replace: true });
      return;
    }
    fetch(`${API_BASE_URL}/auth/exchange`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    })
      .then((res) => (res.ok ? res.json() : Promise.reject()))
{% if context.session_delivery == 'cookie' %}
      .then(() => {
        onToken('cookie-session');
{% else %}
      .then((data) => {
        onToken(data.token);
{% endif %}
        navigate('/', { replace: true });
      })
      .catch(() => navigate('/login', { replace: true }));
  }, []);
  return null;
}
{% endif %}

function App() {
  {% if context.session_delivery == 'cookie' %}
  const [token, setToken] = useState<string | null>(() =>
    document.cookie.includes('csrf_token=') ? 'cookie-session' : null
  );
  {% else %}
  const [token, setToken] = useState<string | null>(() => localStorage.getItem('token'));
  {% endif %}
  const [user, setUser] = useState<any | null>(null);
  const [caller, setCaller] = useState<Caller | null>(() => (token ? JSON.parse(localStorage.getItem('caller') ?? '{}') : null));

{% if context.identity_entities %}
  const signIn = (signed: string, signer: Caller) => {
    localStorage.removeItem('sso_logout_path');
    {% if context.session_delivery != 'cookie' %}
    localStorage.setItem('token', signed);
    {% endif %}
    localStorage.setItem('caller', JSON.stringify(signer));
    setToken(signed);
    setCaller(signer);
  };

{% endif %}
  const logout = async () => {
    const ssoLogoutPath = localStorage.getItem('sso_logout_path');
    {% if context.session_delivery == 'cookie' %}
    await fetch(`${API_BASE_URL}/auth/logout`, { method: 'POST' }).catch(() => undefined);
    {% endif %}
    {% if context.session_delivery != 'cookie' %}
    localStorage.removeItem('token');
    {% endif %}
    localStorage.removeItem('sso_logout_path');
    localStorage.removeItem('caller');
    setToken(null);
    setUser(null);
    setCaller(null);
    if (ssoLogoutPath) {
      window.location.href = `${API_BASE_URL}/${ssoLogoutPath}`;
    }
  };

{% if login_entity %}
  const login = async (identifier: string, password: string) => {
    const res = await callOperation('{{ login_entity.name }}', 'login', {
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ {{ login_entity.auth_identifier }}: identifier, password }),
    });
    if (!res.ok) throw await failure(res, 'Invalid credentials');
    const data = await res.json();
    signIn({{ "'cookie-session'" if context.session_delivery == 'cookie' else 'data.token' }}, callerOf('{{ login_entity.name }}', data.user));
    setUser(data.user);
  };
{% endif %}

  {% if context.identity_entities %}
  {% if context.session_delivery == 'cookie' %}
  const handleExternalToken = () => signIn('cookie-session', {});
  {% else %}
  const handleExternalToken = (t: string) => signIn(t, {});
  {% endif %}
  {% endif %}

  return (
    <AuthContext.Provider value={{ "{{" }} token, user, caller, {% if login_entity %}login, {% endif %}logout {{ "}}" }}>
      <Routes>
        {% if context.identity_entities %}
        <Route path="/auth/callback" element={<AuthCallback onToken={handleExternalToken} />} />
        {% endif %}
        {% if signs_in %}
        <Route path="/login" element={<{{ sign_in_page }} />} />
        {% endif %}
        {% if signs_in and pack_config.get('require_auth', false) %}
        <Route path="/*" element={token ? <AppLayout /> : <{{ sign_in_page }} />} />
        {% else %}
        <Route path="/*" element={<AppLayout />} />
        {% endif %}
      </Routes>
    </AuthContext.Provider>
  );
}

function AppLayout() {
  {% if context.identity_entities %}
  const { token, logout } = useAuth();
  {% endif %}
  const location = useLocation();

  const navItems = [
    { path: '/', label: 'Dashboard', icon: '○' },
    {% for view in views.values() %}
    {% if view.path and view.path != '/' and view.path != '/login' %}
    { path: '{{ view.path }}', label: '{{ view.path.strip("/").replace("_", " ") | title }}', icon: '≡' },
    {% endif %}
    {% endfor %}
  ];

  return (
    <div className="flex h-screen bg-wf-bg">
      {/* Sidebar */}
      <aside className="wf-sidebar">
        {/* Brand */}
        <div className="flex items-center gap-2 px-2 py-3 border-b border-dashed border-wf-line mb-2">
          <div className="w-[22px] h-[22px] border-[1.5px] border-wf-line-strong rounded-[5px] bg-wf-surface flex items-center justify-center">
            <span className="text-xs font-bold text-wf-ink-dim">{{ pack_config.app_name[0] if pack_config.app_name else 'A' }}</span>
          </div>
          <span className="text-[13px] font-medium text-wf-ink font-title">{{ pack_config.app_name or 'myapp' }}</span>
        </div>

        {/* Section label */}
        <div className="text-2xs uppercase tracking-wider text-wf-ink-faint px-2 py-1.5">
          Collections
        </div>

        {/* Navigation */}
        <nav className="flex-1 flex flex-col gap-0.5 px-2 overflow-y-auto">
          {navItems.map((item) => (
            <Link
              key={item.path}
              to={item.path}
              className={`wf-sidebar-item ${location.pathname === item.path ? 'is-active' : ''}`}
            >
              <span className="w-4 text-center text-wf-ink-faint">{item.icon}</span>
              {item.label}
            </Link>
          ))}
        </nav>

        {/* Footer */}
        <div className="mt-auto border-t border-dashed border-wf-line px-2 py-2">
          {% if context.identity_entities %}
          {token ? (
            <button
              onClick={logout}
              className="wf-sidebar-item w-full"
            >
              <span className="w-4 text-center text-wf-ink-faint">↩</span>
              Logout
            </button>
          ) : {% if signs_in %}(
            <Link to="/login" className="wf-sidebar-item w-full">
              <span className="w-4 text-center text-wf-ink-faint">→</span>
              {{ 'Login' if login_entity or provider_entity else 'Register' }}
            </Link>
          ){% else %}null{% endif %}}
          {% endif %}
        </div>
      </aside>

      {/* Main content area */}
      <div className="flex-1 flex flex-col min-w-0">
        {/* Topbar */}
        <header className="flex items-center justify-between px-5 py-2.5 border-b border-wf-line bg-wf-surface min-h-[48px]">
          <div className="flex items-center gap-2 text-sm">
            <span className="text-wf-ink-dim">{{ pack_config.app_name or 'App' }}</span>
            <span className="text-wf-ink-faint">/</span>
            <span className="text-wf-ink font-medium">
              {navItems.find(i => i.path === location.pathname)?.label || 'Dashboard'}
            </span>
          </div>
          <div className="flex items-center gap-2.5">
            <div className="flex items-center gap-2 px-2.5 py-1.5 border border-wf-line rounded-[5px] bg-wf-bg min-w-[200px] text-wf-ink-faint text-sm">
              <span>⌕</span>
              <span>Search...</span>
            </div>
            <div className="w-7 h-7 rounded-full border-[1.5px] border-wf-line-strong bg-wf-fill" />
          </div>
        </header>

        {/* Page content */}
        <main className="flex-1 overflow-auto">
          <Routes>
            <Route path="/" element={
              <div className="p-6">
                <h1 className="font-title text-3xl text-wf-ink mb-2">Dashboard</h1>
                <p className="text-wf-ink-dim">Welcome to {{ pack_config.app_name or 'App' }}</p>
              </div>
            } />
            {% for view in views.values() if view.path and view.path != '/login' %}
            {% set page = view.name | pascal_case %}
            {% if view.name in crud_views %}
            {% set entity = view_entities.get(view.name) %}
{{ route(view.path, page, entity, 'list') }}
{{ route(view.path ~ '/new', page ~ 'Form', entity, 'create') }}
{{ route(view.path ~ '/:id', page ~ 'Detail', entity, 'get') }}
{{ route(view.path ~ '/:id/edit', page ~ 'Form', entity, entity.edit_operation if entity else 'update') }}
            {% else %}
            <Route path="{{ view.path }}" element={<{{ page }} />} />
            {% endif %}
            {% endfor %}
          </Routes>
        </main>
      </div>
    </div>
  );
}

export default App;
