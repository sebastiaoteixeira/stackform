import { useEffect, useState } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { useAuth } from '../__generated__/App';
import { callOperation, displayValue } from '../__generated__/records';
import { Button } from '../__generated__/components/Button';
import { Badge } from '../__generated__/components/Badge';
import { LoadingSpinner } from '../__generated__/components/LoadingSpinner';

interface {{ entity.name | pascal_case }}SchemaProps {
  basePath?: string;
}

export function {{ entity.name | pascal_case }}Schema({
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}SchemaProps) {
  const { id } = useParams<{ id: string }>();
  const [record, setRecord] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();
  const { token } = useAuth();

  useEffect(() => {
    if (!id) return;
    const fetchRecord = async () => {
      try {
        const headers: Record<string, string> = {};
        if (token) headers['Authorization'] = `Bearer ${token}`;
        const res = await callOperation('{{ entity.name }}', 'get', { id, headers });
        if (!res.ok) throw new Error(res.status === 404 ? 'Record not found' : `Error: ${res.status}`);
        setRecord(await res.json());
      } catch (err: any) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };
    fetchRecord();
  }, [id, token]);

  {% set roles = props.field_roles.value if props.field_roles is defined else {} %}
  {% set title_field = entity.fields[roles.title] if roles.title is defined else none %}
  {% set status_field = entity.fields[roles.status] if roles.status is defined else none %}

  if (loading) return <LoadingSpinner message="Loading..." />;

  if (error) {
    return (
      <div className="p-6">
        <div className="wf-card border-wf-danger bg-wf-danger-soft p-4">
          <p className="text-wf-ink text-sm">{error}</p>
        </div>
      </div>
    );
  }

  if (!record) return null;

  return (
    <div className="p-6 min-h-full bg-wf-bg">
      {/* Header */}
      <div className="mb-5 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <button onClick={() => navigate(-1)} className="text-wf-ink-dim hover:text-wf-ink text-sm">
            ← Back
          </button>
          <span className="text-wf-line">|</span>
          {% if title_field %}
          <h1 className="font-title text-xl text-wf-ink">{record.{{ title_field.name }}}</h1>
          {% else %}
          <h1 className="font-title text-xl text-wf-ink">{{ entity.name | title }}</h1>
          {% endif %}
          {% if status_field %}
          <Badge value={String(record.{{ status_field.name }})} size="sm" />
          {% endif %}
        </div>
        <Button size="sm" variant="secondary" onClick={() => navigate(`${basePath}/${id}/edit`)}>
          Edit
        </Button>
      </div>

      {/* Schema-aware field grid */}
      <div className="wf-card overflow-hidden p-0">
        {/* Table header */}
        <div
          className="grid items-center px-4 py-2 border-b border-wf-line bg-wf-fill"
          style={{ "{{" }} gridTemplateColumns: '140px 180px 1fr' {{ "}}" }}
        >
          <span className="text-2xs uppercase tracking-wider text-wf-ink-faint font-medium">Key</span>
          <span className="text-2xs uppercase tracking-wider text-wf-ink-faint font-medium">Type</span>
          <span className="text-2xs uppercase tracking-wider text-wf-ink-faint font-medium">Value</span>
        </div>

        {/* PK row */}
        <div
          className="grid items-start px-4 py-2.5 border-b border-wf-line hover:bg-wf-fill transition-colors"
          style={{ "{{" }} gridTemplateColumns: '140px 180px 1fr' {{ "}}" }}
        >
          <div className="flex items-center gap-1.5">
            <span className="text-sm text-wf-ink font-medium">{{ entity.pk_field }}</span>
            <span className="text-2xs px-1 bg-wf-accent-soft text-wf-accent-ink rounded">pk</span>
          </div>
          <span className="wf-mono">string</span>
          <span className="wf-mono text-wf-ink">{record.{{ entity.pk_field }}}</span>
        </div>

        {/* Field rows */}
        {% for field in entity.fields.values() %}
        {% if field.name != entity.pk_field %}
        <div
          className="grid items-start px-4 py-2.5 border-b border-wf-line last:border-0 hover:bg-wf-fill transition-colors"
          style={{ "{{" }} gridTemplateColumns: '140px 180px 1fr' {{ "}}" }}
        >
          <div className="flex items-center gap-1.5 flex-wrap">
            <span className="text-sm text-wf-ink">{{ field.name }}</span>
            {% if field.required %}
            <span className="text-2xs px-1 bg-wf-danger-soft text-wf-danger rounded">req</span>
            {% endif %}
            {% if field.unique %}
            <span className="text-2xs px-1 bg-wf-warn-soft text-wf-ink rounded">unique</span>
            {% endif %}
          </div>
          <span className="wf-mono">
            {{ field.type }}{% if field.type == 'enum' %}&lt;{% for v in field.values %}'{{ v }}'{% if not loop.last %}|{% endif %}{% endfor %}&gt;{% endif %}
          </span>
          <div className="text-sm text-wf-ink">
            {% if field.type == 'enum' %}
            <Badge value={String(record.{{ field.name }})} size="sm" />
            {% elif field.type in ['datetime', 'date'] or field.name in ['createdAt', 'updatedAt', 'publishedAt', 'date'] %}
            <span className="wf-mono">
              {record.{{ field.name }} ? new Date(record.{{ field.name }}).toISOString() : '—'}
            </span>
            {% elif field.type == 'boolean' %}
            <span className="wf-mono">{String(record.{{ field.name }})}</span>
            {% elif field.type == 'number' %}
            <span className="wf-mono">{displayValue(record.{{ field.name }})}</span>
            {% else %}
            <span className="whitespace-pre-wrap">{displayValue(record.{{ field.name }})}</span>
            {% endif %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}Schema;
