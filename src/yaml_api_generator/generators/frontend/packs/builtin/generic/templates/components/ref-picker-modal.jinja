import { useEffect, useState } from 'react';
import { useAuth } from '../__generated__/App';
import { listRecords } from '../__generated__/records';

interface RefOption {
  id: string;
  name: string;
  subtitle?: string;
  avatar?: string;
}

interface RefPickerModalProps {
  target?: string;
  value?: string | null;
  onSelect?: (id: string | null) => void;
  onClose?: () => void;
}

function Avatar({ src, name }: { src?: string; name: string }) {
  if (src) {
    return <img src={src} alt={name} className="w-8 h-8 rounded-full object-cover flex-shrink-0" />;
  }
  return (
    <span className="w-8 h-8 rounded-full bg-wf-accent-soft flex items-center justify-center text-sm font-medium text-wf-accent-ink flex-shrink-0">
      {name.charAt(0).toUpperCase()}
    </span>
  );
}

export function RefPickerModal({
  target = {{ props.target.value | tojson }},
  value,
  onSelect,
  onClose,
}: RefPickerModalProps) {
  const [query, setQuery] = useState('');
  const [selected, setSelected] = useState<string | null>(value ?? null);
  const [options, setOptions] = useState<RefOption[]>([]);
  const [loading, setLoading] = useState(true);
  const { token } = useAuth();

  useEffect(() => {
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    listRecords(target, headers)
      .then(setOptions)
      .catch(() => setOptions([]))
      .finally(() => setLoading(false));
  }, [token, target]);

  const filtered = options.filter((o) =>
    o.name.toLowerCase().includes(query.toLowerCase()) ||
    o.id.toLowerCase().includes(query.toLowerCase())
  );

  return (
    <div className="wf-overlay z-50">
      <div
        className="bg-wf-surface border-[1.5px] border-wf-line-strong rounded-lg shadow-xl overflow-hidden flex flex-col"
        style={{ "{{" }} width: '520px', maxHeight: '72vh' {{ "}}" }}
      >
        {/* Header */}
        <div className="flex items-center gap-3 px-5 py-4 border-b border-wf-line">
          <h2 className="font-title text-xl text-wf-ink flex-1">Pick {target}</h2>
          <button
            type="button"
            onClick={onClose}
            className="wf-btn wf-btn-ghost wf-btn-sm text-wf-ink-faint"
          >
            x
          </button>
        </div>

        {/* Search */}
        <div className="px-5 py-3 border-b border-wf-line">
          <input
            autoFocus
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder={`Search ${target}s...`}
            className="w-full wf-input text-sm text-wf-ink placeholder:text-wf-ink-faint outline-none"
          />
        </div>

        {/* Table */}
        <div className="flex-1 overflow-auto">
          {loading ? (
            <p className="px-5 py-8 text-sm text-wf-ink-dim text-center">Loading...</p>
          ) : filtered.length === 0 ? (
            <p className="px-5 py-8 text-sm text-wf-ink-dim text-center">No results</p>
          ) : (
            <table className="wf-table">
              <thead>
                <tr>
                  <th className="w-8"></th>
                  <th></th>
                  <th>Name</th>
                  <th>ID</th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((option) => (
                  <tr
                    key={option.id}
                    onClick={() => setSelected(option.id)}
                    className={`cursor-pointer ${selected === option.id ? 'is-selected' : ''}`}
                  >
                    <td>
                      <input
                        type="radio"
                        checked={selected === option.id}
                        onChange={() => setSelected(option.id)}
                        className="w-4 h-4 accent-wf-accent"
                      />
                    </td>
                    <td>
                      <Avatar src={option.avatar} name={option.name} />
                    </td>
                    <td>
                      <p className="font-medium text-wf-ink">{option.name}</p>
                      {option.subtitle && (
                        <p className="text-xs text-wf-ink-dim">{option.subtitle}</p>
                      )}
                    </td>
                    <td>
                      <span className="wf-mono">{option.id.slice(0, 12)}…</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center justify-end gap-2 px-5 py-4 border-t border-wf-line">
          <button type="button" onClick={onClose} className="wf-btn wf-btn-sm">
            Cancel
          </button>
          <button
            type="button"
            disabled={!selected}
            onClick={() => { onSelect?.(selected); onClose?.(); }}
            className="wf-btn wf-btn-sm wf-btn-primary disabled:opacity-50"
          >
            Select
          </button>
        </div>
      </div>
    </div>
  );
}

export default RefPickerModal;
