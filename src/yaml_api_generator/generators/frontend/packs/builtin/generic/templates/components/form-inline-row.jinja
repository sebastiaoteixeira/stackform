{% from 'macros/field_input.jinja' import field_input %}
import { useEffect, useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../__generated__/App';
import { displayValue, listRecords } from '../__generated__/records';
import { useRecordForm } from '../__generated__/useRecordForm';

interface {{ entity.name | pascal_case }} {
  {{ entity.pk_field }}: string;
  {% for field in entity.fields.values() %}
  {{ field.name }}: {% if field.type == 'string' %}string{% elif field.type == 'number' %}number{% elif field.type == 'boolean' %}boolean{% else %}unknown{% endif %};
  {% endfor %}
}

export default function {{ view.name | pascal_case }}() {
  const [items, setItems] = useState<{{ entity.name | pascal_case }}[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);
  const { token } = useAuth();
  const navigate = useNavigate();
  const { values, setValue, submit } = useRecordForm<{{ entity.name | pascal_case }}>({{ entity.name | tojson }}, editingId ?? undefined);

  useEffect(() => {
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    listRecords('{{ entity.name }}', headers)
      .then(data => {
        setItems(data);
        setLoading(false);
      })
      .catch(err => {
        setError(err instanceof Error ? err.message : 'Unknown error');
        setLoading(false);
      });
  }, [token]);

  const startEdit = (item: {{ entity.name | pascal_case }}) => setEditingId(item.{{ entity.pk_field }});

  const cancelEdit = () => setEditingId(null);

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingId) return;
    setSaving(true);

    try {
      const updated = await submit();
      setItems(prev => prev.map(i => i.{{ entity.pk_field }} === editingId ? updated : i));
      cancelEdit();
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-wf-ink-dim">Loading...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf p-4">
          <p className="text-wf-ink font-medium mb-1">Error loading data</p>
          <p className="text-wf-ink-dim text-sm">{error}</p>
        </div>
      </div>
    );
  }

  {% set roles = props.field_roles.value if props.field_roles is defined else {} %}
  {% set role_names = roles.values() | list %}
  {% set role_fields = [] %}
  {% for name in role_names %}
  {% if name in entity.fields %}{% if role_fields.append(entity.fields[name]) %}{% endif %}{% endif %}
  {% endfor %}
  {% set other_fields = entity.fields.values() | rejectattr('name', 'equalto', entity.pk_field) | rejectattr('readonly') | rejectattr('name', 'in', role_names) | list %}
  {% set display_fields = (role_fields + other_fields)[:4] %}
  {% set edit_fields = display_fields | rejectattr('name', 'in', ['content', 'body', 'description', 'excerpt', 'bio']) | list %}
  {% set col_count = [edit_fields | length, 4] | min %}

  return (
    <div className="h-full flex flex-col">
      {/* Toolbar */}
      <div className="wf-toolbar px-6 pt-4">
        <h1 className="font-title text-2xl text-wf-ink">{{ entity.name | title }}</h1>
        <span className="wf-mono">{items.length} records</span>
        <div className="flex-1" />
        <button
          onClick={() => navigate('{{ view.path }}/new')}
          className="wf-btn wf-btn-primary"
        >
          + New
        </button>
      </div>

      {/* Table with inline-edit rows */}
      <div className="flex-1 overflow-auto px-6 pb-6">
        <div className="border border-wf-line rounded-wf overflow-hidden bg-wf-surface">
          <table className="wf-table">
            <thead>
              <tr>
                <th className="w-24">ID</th>
                {% for field in display_fields %}
                <th>{{ field.name | title }}</th>
                {% endfor %}
                <th className="w-24"></th>
              </tr>
            </thead>
            <tbody>
              {items.map((item) => (
                editingId === item.{{ entity.pk_field }} ? (
                  /* Expanded inline-edit row */
                  <tr
                    key={item.{{ entity.pk_field }} + '-edit'}
                    style={{ "{{" }}
                      background: 'var(--wf-accent-soft)',
                      borderTop: '1.5px solid var(--wf-accent)',
                      borderBottom: '1.5px solid var(--wf-accent)'
                    {{ "}}" }}
                  >
                    <td colSpan={ {{ col_count + 2 }} } className="p-4">
                      <form onSubmit={handleSave}>
                        <div
                          className="grid gap-3 mb-4"
                          style={{ "{{" }} gridTemplateColumns: 'repeat({{ col_count }}, 1fr)' {{ "}}" }}
                        >
                          {% for field in edit_fields %}
                          {% if loop.index0 < 4 %}
                          {{ field_input(field, id_prefix='inline-') }}
                          {% endif %}
                          {% endfor %}
                        </div>
                        <div className="flex items-center gap-2">
                          <button type="submit" disabled={saving} className="wf-btn wf-btn-primary wf-btn-sm">
                            {saving ? 'Saving...' : 'Save'}
                          </button>
                          <button type="button" onClick={cancelEdit} className="wf-btn wf-btn-sm">
                            Cancel
                          </button>
                        </div>
                      </form>
                    </td>
                  </tr>
                ) : (
                  /* Normal read-only row */
                  <tr key={item.{{ entity.pk_field }}}>
                    <td>
                      <span className="wf-mono">{String(item.{{ entity.pk_field }}).slice(0, 8)}...</span>
                    </td>
                    {% for field in display_fields %}
                    <td>
                      {% if field.type == 'enum' %}
                      <span className="wf-badge">{displayValue(item.{{ field.name }})}</span>
                      {% else %}
                      {displayValue(item.{{ field.name }})}
                      {% endif %}
                    </td>
                    {% endfor %}
                    <td>
                      <div className="flex items-center gap-2">
                        <button
                          type="button"
                          onClick={() => startEdit(item)}
                          className="wf-btn wf-btn-sm wf-btn-ghost text-wf-accent"
                        >
                          Edit
                        </button>
                        <Link
                          to={`{{ view.path }}/${item.{{ entity.pk_field }}}`}
                          className="wf-btn wf-btn-sm wf-btn-ghost text-wf-ink-dim"
                        >
                          View
                        </Link>
                      </div>
                    </td>
                  </tr>
                )
              ))}
            </tbody>
          </table>
        </div>

        {items.length === 0 && (
          <div className="flex items-center justify-center h-full">
            <div className="text-center p-12 border-[1.5px] border-dashed border-wf-line rounded-lg max-w-md">
              <h3 className="font-title text-xl text-wf-ink mb-2">No {{ entity.name | lower }}s yet</h3>
              <p className="text-wf-ink-dim text-sm mb-4">Create your first record to get started.</p>
              <button onClick={() => navigate('{{ view.path }}/new')} className="wf-btn wf-btn-primary">
                + New {{ entity.name | title }}
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
