import { useState } from 'react';

interface {{ collection_name | pascal_case }}FormProps {
  mode?: 'create' | 'edit';
  initialData?: any;
  onSubmit?: (data: any) => void;
  onCancel?: () => void;
}

export function {{ collection_name | pascal_case }}Form({
  mode = 'create',
  initialData = {},
  onSubmit,
  onCancel
}: {{ collection_name | pascal_case }}FormProps) {
  const [formData, setFormData] = useState(initialData);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSubmit?.(formData);
  };

  return (
    <div className="max-w-2xl mx-auto">
      <div className="mb-6">
        <h2 className="text-2xl font-semibold">
          {mode === 'create' ? 'Create' : 'Edit'} {{ collection_name | title }}
        </h2>
      </div>

      <form onSubmit={handleSubmit} className="space-y-6 bg-white border border-gray-200 rounded-lg p-6">
        {% for field in form_fields %}
        <div>
          <label className="block text-sm font-medium text-gray-700 mb-1">
            {{ field.label }}{% if field.required %} *{% endif %}
          </label>
          {% if field.type == 'textarea' %}
          <textarea
            name="{{ field.name }}"
            value={formData.{{ field.name }} || ''}
            onChange={(e) => setFormData({ ...formData, {{ field.name }}: e.target.value })}
            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            rows={4}
            {% if field.required %}required{% endif %}
          />
          {% elif field.type == 'select' %}
          <select
            name="{{ field.name }}"
            value={formData.{{ field.name }} || ''}
            onChange={(e) => setFormData({ ...formData, {{ field.name }}: e.target.value })}
            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            {% if field.required %}required{% endif %}
          >
            <option value="">Select...</option>
            {% for option in field.options %}
            <option value="{{ option.value }}">{{ option.label }}</option>
            {% endfor %}
          </select>
          {% else %}
          <input
            type="{{ field.type or 'text' }}"
            name="{{ field.name }}"
            value={formData.{{ field.name }} || ''}
            onChange={(e) => setFormData({ ...formData, {{ field.name }}: e.target.value })}
            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            {% if field.required %}required{% endif %}
          />
          {% endif %}
        </div>
        {% endfor %}

        <div className="flex items-center gap-3 pt-4 border-t border-gray-200">
          <button
            type="submit"
            className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-medium"
          >
            {mode === 'create' ? 'Create' : 'Save'}
          </button>
          <button
            type="button"
            onClick={onCancel}
            className="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  );
}
