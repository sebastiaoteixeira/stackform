import { useState } from 'react';
import { Button } from '../__generated__/components/Button';
import { Input } from '../__generated__/components/Input';

interface AuthTabbedProps {
  onLogin?: (data: any) => void;
  onRegister?: (data: any) => void;
  appName?: string;
  providers?: string[];
}

export function AuthTabbed({
  onLogin,
  onRegister,
  appName = '{{ pack_config.app_name or "App" }}',
  providers = []
}: AuthTabbedProps) {
  const [activeTab, setActiveTab] = useState<'login' | 'register'>('login');
  const [formData, setFormData] = useState({ email: '', password: '', displayName: '' });

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (activeTab === 'login') {
      onLogin?.(formData);
    } else {
      onRegister?.(formData);
    }
  };

  const handleFieldChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-gray-50 px-4">
      <div className="w-full max-w-md">
        <div className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
          {/* Tabs */}
          <div className="grid grid-cols-2 border-b border-gray-200">
            <button
              onClick={() => setActiveTab('login')}
              className={`py-3 text-center font-medium transition-colors ${
                activeTab === 'login'
                  ? 'text-blue-600 border-b-2 border-blue-600 -mb-px'
                  : 'text-gray-600 hover:text-gray-900'
              }`}
            >
              Sign in
            </button>
            <button
              onClick={() => setActiveTab('register')}
              className={`py-3 text-center font-medium transition-colors ${
                activeTab === 'register'
                  ? 'text-blue-600 border-b-2 border-blue-600 -mb-px'
                  : 'text-gray-600 hover:text-gray-900'
              }`}
            >
              Sign up
            </button>
          </div>

          <div className="p-6">
            <form onSubmit={handleSubmit} className="space-y-4">
              {activeTab === 'register' && (
                <Input
                  label="Display name"
                  name="displayName"
                  type="text"
                  value={formData.displayName}
                  onChange={handleFieldChange}
                  required
                />
              )}

              <Input
                label="Email"
                name="email"
                type="email"
                value={formData.email}
                onChange={handleFieldChange}
                required
              />

              <Input
                label="Password"
                name="password"
                type="password"
                value={formData.password}
                onChange={handleFieldChange}
                required
              />

              <Button type="submit" variant="primary" className="w-full">
                {activeTab === 'login' ? 'Continue' : 'Create account'}
              </Button>
            </form>

            {% raw %}
            {providers && providers.length > 0 && (
              <>
                <div className="relative my-6">
                  <div className="absolute inset-0 flex items-center">
                    <div className="w-full border-t border-gray-200" />
                  </div>
                  <div className="relative flex justify-center text-sm">
                    <span className="px-2 bg-white text-gray-500">Or continue with</span>
                  </div>
                </div>
                <div className="space-y-2">
                  {providers.map((provider) => (
                    <Button
                      key={provider}
                      variant="secondary"
                      className="w-full"
                      onClick={() => {/* SSO login */}}
                    >
                      {provider}
                    </Button>
                  ))}
                </div>
              </>
            )}
            {% endraw %}
          </div>
        </div>
      </div>
    </div>
  );
}
