interface DeleteSimpleProps {
  entityLabel?: string;
  recordName?: string;
  onConfirm?: () => void;
  onCancel?: () => void;
  loading?: boolean;
}

export function DeleteSimple({
  entityLabel = '{{ entity.name | title }}',
  recordName,
  onConfirm,
  onCancel,
  loading = false,
}: DeleteSimpleProps) {
  return (
    <div className="wf-overlay">
      <div className="wf-modal max-w-md w-full">
        <div className="p-6">
          <h3 className="font-title text-xl text-wf-ink mb-2">
            Delete this {entityLabel}?
          </h3>
          <p className="text-sm text-wf-ink-dim mb-6">
            {recordName ? (
              <>
                <strong className="text-wf-ink">{recordName}</strong> will be permanently removed.
                This action cannot be undone.
              </>
            ) : (
              `This ${entityLabel} will be permanently removed. This action cannot be undone.`
            )}
          </p>
          <div className="flex items-center justify-end gap-2">
            <button onClick={onCancel} disabled={loading} className="wf-btn">
              Cancel
            </button>
            <button onClick={onConfirm} disabled={loading} className="wf-btn wf-btn-danger">
              {loading ? 'Deleting...' : 'Delete'}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export default DeleteSimple;
