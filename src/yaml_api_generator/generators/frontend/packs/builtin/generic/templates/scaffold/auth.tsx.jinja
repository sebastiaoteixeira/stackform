{% from 'macros/field_input.jinja' import field_input %}
{% set entity = context.entities.values() | selectattr('serves_login') | first %}
{% if entity %}
{% set login_fields = [entity.auth_identifier] + (entity.credential_fields | map(attribute='name') | list) %}
import { useState } from 'react';
import { SIGNUP_FIELDS, formValues, payload } from './fields';

const FIELDS = SIGNUP_FIELDS[{{ entity.name | tojson }}];

interface AuthProps {
  mode?: 'login' | 'register';
  onSubmit?: (data: any) => void;
  onToggleMode?: () => void;
  appName?: string;
  providers?: string[];
  defaultRole?: string;
}

export function Auth({
  mode = 'login',
  onSubmit,
  onToggleMode,
  appName = '{{ pack_config.app_name or "App" }}',
  providers = [],
  defaultRole{% if entity.roles %} = '{{ entity.roles.default }}'{% endif %}
}: AuthProps) {
  const [values, setValues] = useState(() => formValues(FIELDS));
  const [rememberMe, setRememberMe] = useState(false);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSubmit?.(payload(FIELDS, mode === 'login' ? { {% for name in login_fields %}{{ name | tojson }}: values[{{ name | tojson }}], {% endfor %}} : values));
  };

  const setValue = (name: string, value: unknown) => setValues(prev => ({ ...prev, [name]: value }));

  return (
    <div className="min-h-screen flex items-center justify-center bg-wf-bg px-4">
      <div className="w-full max-w-[360px]">
        <div className="bg-wf-surface border-[1.5px] border-wf-line-strong rounded-lg p-6">
          {/* Logo */}
          <div className="flex justify-center mb-6">
            <div className="w-9 h-9 border-[1.5px] border-wf-line-strong rounded-[5px] bg-wf-surface flex items-center justify-center">
              <span className="font-title text-lg text-wf-ink">{appName[0]}</span>
            </div>
          </div>

          {/* Header */}
          <div className="text-center mb-6">
            <h2 className="font-title text-2xl text-wf-ink">
              {mode === 'login' ? 'Sign in' : 'Create account'}
            </h2>
            <p className="mt-1 text-sm text-wf-ink-dim">
              {mode === 'login' ? 'Welcome back' : 'Get started with ' + appName}
            </p>
          </div>

          <form onSubmit={handleSubmit} className="flex flex-col gap-4">
{% for field in entity.signup_fields %}
            {% if field.name not in login_fields %}{mode === 'register' && ({% endif %}
            {{ field_input(field, id_prefix='auth-') }}
            {% if field.name not in login_fields %})}{% endif %}
{% endfor %}

            {mode === 'register' && defaultRole && (
              <div className="bg-wf-fill border border-dashed border-wf-line rounded-wf p-3">
                <div className="flex items-center justify-between text-sm">
                  <span className="text-wf-ink-dim">You'll be a</span>
                  <span className="wf-badge">{defaultRole}</span>
                </div>
              </div>
            )}

            {mode === 'login' && (
              <div className="flex items-center justify-between">
                <label className="flex items-center gap-2 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={rememberMe}
                    onChange={(e) => setRememberMe(e.target.checked)}
                    className="w-4 h-4 rounded border-wf-line-strong accent-wf-accent"
                  />
                  <span className="text-sm text-wf-ink-dim">Remember me</span>
                </label>
                <a href="#" className="text-sm text-wf-accent hover:text-wf-accent-ink font-title">
                  Forgot?
                </a>
              </div>
            )}

            <button type="submit" className="wf-btn wf-btn-primary w-full">
              {mode === 'login' ? 'Sign in' : 'Create account'}
            </button>
          </form>

          {providers && providers.length > 0 && (
            <>
              <div className="relative my-5">
                <div className="absolute inset-0 flex items-center">
                  <div className="w-full border-t border-dashed border-wf-line" />
                </div>
                <div className="relative flex justify-center text-sm">
                  <span className="px-2 bg-wf-surface text-wf-ink-faint">or</span>
                </div>
              </div>
              <div className="flex flex-col gap-2">
                {providers.map((provider) => (
                  <button
                    key={provider}
                    type="button"
                    className="wf-btn w-full"
                    onClick={() => {/* SSO login */}}
                  >
                    Continue with {provider.charAt(0).toUpperCase() + provider.slice(1)}
                  </button>
                ))}
              </div>
            </>
          )}

          {onToggleMode && (
            <div className="mt-5 pt-5 border-t border-dashed border-wf-line text-center">
              <p className="text-sm text-wf-ink-dim">
                {mode === 'login' ? 'New here?' : 'Already have an account?'}{' '}
                <button
                  onClick={onToggleMode}
                  type="button"
                  className="text-wf-accent hover:text-wf-accent-ink font-title"
                >
                  {mode === 'login' ? 'Create account' : 'Sign in'}
                </button>
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
{% endif %}
