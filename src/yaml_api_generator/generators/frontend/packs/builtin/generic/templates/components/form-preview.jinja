{% from 'macros/field_input.jinja' import field_input %}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useRecordForm } from '../__generated__/useRecordForm';

interface {{ entity.name | pascal_case }}PreviewFormProps {
  entityId?: string;
  basePath?: string;
}

{% set roles = props.field_roles.value if props.field_roles is defined else {} %}
{% set title_field = entity.fields[roles.title] if roles.title is defined else none %}
{% set content_field = entity.fields[roles.content] if roles.content is defined else none %}
{% set image_field = entity.fields[roles.image] if roles.image is defined else none %}
{% set status_field = entity.fields[roles.status] if roles.status is defined else none %}

export function {{ entity.name | pascal_case }}PreviewForm({
  entityId,
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}PreviewFormProps) {
  const { values, setValue, mode, submit } = useRecordForm({{ entity.name | tojson }}, '{{ entity.repository_name | kebab_case }}', entityId);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      const result = await submit();
      navigate(`${basePath}/${result.{{ entity.pk_field }}}`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-wf-bg">
      {/* Toolbar */}
      <div className="wf-toolbar px-5 py-3 border-b border-wf-line bg-wf-surface sticky top-0 z-10">
        <button type="button" onClick={() => navigate(-1)} className="wf-btn wf-btn-ghost text-wf-ink-dim">
          ←
        </button>
        <h1 className="font-title text-base text-wf-ink flex-1">
          {mode === 'create' ? 'New' : 'Edit'} {{ entity.name | title }}
        </h1>
        <button type="button" onClick={() => navigate(-1)} className="wf-btn">
          Cancel
        </button>
        <button type="submit" form="preview-form" disabled={submitting} className="wf-btn wf-btn-primary">
          {submitting ? 'Saving...' : (mode === 'create' ? 'Create' : 'Save')}
        </button>
      </div>

      {error && (
        <div className="mx-6 mt-4 p-4 bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf">
          <p className="text-wf-ink text-sm">{error}</p>
        </div>
      )}

      {/* Two-column layout: form + live preview */}
      <div className="p-6" style={{ "{{" }} display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px' {{ "}}" }}>
        {/* Form column */}
        <form id="preview-form" onSubmit={handleSubmit} className="space-y-4">
          {% for field in entity.fields.values() %}
          {% if field.name != entity.pk_field and not field.readonly %}
          {{ field_input(field) }}
          {% endif %}
          {% endfor %}
        </form>

        {/* Live preview column */}
        <div
          className="rounded-wf border border-wf-line sticky top-[61px] overflow-auto self-start"
          style={{ "{{" }} background: 'var(--wf-fill)', maxHeight: 'calc(100vh - 80px)' {{ "}}" }}
        >
          {/* Preview header */}
          <div className="flex items-center justify-between px-4 py-3 border-b border-wf-line">
            <span className="text-[11px] uppercase tracking-wide text-wf-ink-dim font-medium">Preview</span>
            <span className="wf-badge wf-badge-accent">live</span>
          </div>

          {/* Preview card */}
          <div className="p-4">
            <div className="wf-card overflow-hidden">
              {% if image_field %}
              {values.{{ image_field.name }} ? (
                <img
                  src={String(values.{{ image_field.name }})}
                  alt="Preview"
                  className="w-full h-44 object-cover rounded mb-4"
                />
              ) : (
                <div className="w-full h-44 bg-wf-fill-2 rounded mb-4 flex items-center justify-center">
                  <span className="text-wf-ink-faint text-xs">No image</span>
                </div>
              )}
              {% endif %}

              {% if status_field %}
              <div className="mb-3">
                <span className="wf-badge">
                  {String(values.{{ status_field.name }} || 'draft')}
                </span>
              </div>
              {% endif %}

              {% if title_field %}
              <h2 className="font-title text-xl text-wf-ink mb-2">
                {String(values.{{ title_field.name }} || 'Untitled')}
              </h2>
              {% endif %}

              {% if content_field %}
              <div className="text-wf-ink-dim text-sm whitespace-pre-wrap leading-relaxed">
                {values.{{ content_field.name }}
                  ? String(values.{{ content_field.name }})
                  : <span className="text-wf-ink-faint italic">No content yet</span>}
              </div>
              {% endif %}

              {% set preview_shown = [entity.pk_field] %}
              {% if title_field %}{% set _ = preview_shown.append(title_field.name) %}{% endif %}
              {% if content_field %}{% set _ = preview_shown.append(content_field.name) %}{% endif %}
              {% if image_field %}{% set _ = preview_shown.append(image_field.name) %}{% endif %}
              {% if status_field %}{% set _ = preview_shown.append(status_field.name) %}{% endif %}

              {% set remaining = entity.fields.values() | rejectattr('name', 'in', preview_shown) | list %}
              {% if remaining %}
              <hr className="my-4 border-wf-line" />
              <dl className="grid grid-cols-2 gap-3 text-xs">
                {% for field in remaining %}
                <div>
                  <dt className="text-wf-ink-faint mb-0.5">{{ field.name | title }}</dt>
                  <dd className="text-wf-ink">
                    {values.{{ field.name }} ? String(values.{{ field.name }}) : '—'}
                  </dd>
                </div>
                {% endfor %}
              </dl>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}PreviewForm;
