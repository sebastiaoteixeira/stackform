import { useEffect, useRef, useState } from 'react';
import { useAuth } from '../__generated__/App';
import { API_BASE_URL } from '../__generated__/config';

interface RefOption {
  id: string;
  name: string;
  subtitle?: string;
  avatar?: string;
}

interface RefDropdownProps {
  target: string;
  targetEndpoint: string;
  value?: string | null;
  onChange?: (id: string | null) => void;
  placeholder?: string;
  onCreate?: () => void;
}

function Avatar({ src, name }: { src?: string; name: string }) {
  if (src) {
    return <img src={src} alt={name} className="w-7 h-7 rounded-full object-cover flex-shrink-0" />;
  }
  return (
    <span className="w-7 h-7 rounded-full bg-wf-accent-soft flex items-center justify-center text-xs font-medium text-wf-accent-ink flex-shrink-0">
      {name.charAt(0).toUpperCase()}
    </span>
  );
}

export function RefDropdown({
  target,
  targetEndpoint,
  value,
  onChange,
  placeholder = `Pick a ${target}...`,
  onCreate,
}: RefDropdownProps) {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState('');
  const [options, setOptions] = useState<RefOption[]>([]);
  const [loading, setLoading] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);
  const { token } = useAuth();

  const selected = options.find((o) => o.id === value);

  useEffect(() => {
    if (!open) return;
    setLoading(true);
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    fetch(`${API_BASE_URL}${targetEndpoint}`, { headers })
      .then((r) => r.json())
      .then((data) => setOptions(Array.isArray(data) ? data : []))
      .catch(() => setOptions([]))
      .finally(() => setLoading(false));
  }, [open, token, targetEndpoint]);

  useEffect(() => {
    const handler = (e: MouseEvent) => {
      if (!containerRef.current?.contains(e.target as Node)) setOpen(false);
    };
    document.addEventListener('mousedown', handler);
    return () => document.removeEventListener('mousedown', handler);
  }, []);

  const filtered = options.filter((o) =>
    o.name.toLowerCase().includes(query.toLowerCase())
  );

  return (
    <div ref={containerRef} className="relative" style={{ "{{" }} width: '300px' {{ "}}" }}>
      {/* Trigger */}
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        className="wf-input w-full flex items-center gap-2 cursor-pointer"
      >
        {selected ? (
          <>
            <Avatar src={selected.avatar} name={selected.name} />
            <span className="flex-1 text-left text-sm text-wf-ink truncate">{selected.name}</span>
          </>
        ) : (
          <span className="flex-1 text-left text-sm text-wf-ink-faint">{placeholder}</span>
        )}
        <span className="text-wf-ink-faint text-xs">{open ? '▴' : '▾'}</span>
      </button>

      {/* Popover */}
      {open && (
        <div className="absolute top-full left-0 mt-1 w-full bg-wf-surface border-[1.5px] border-wf-line-strong rounded-wf shadow-xl z-50 overflow-hidden">
          {/* Search */}
          <div className="p-2 border-b border-wf-line">
            <input
              autoFocus
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search..."
              className="w-full px-2 py-1.5 text-sm bg-wf-fill rounded border border-wf-line text-wf-ink placeholder:text-wf-ink-faint outline-none focus:border-wf-accent"
            />
          </div>

          {/* Options */}
          <div className="max-h-52 overflow-auto">
            {loading ? (
              <p className="px-3 py-4 text-sm text-wf-ink-dim text-center">Loading...</p>
            ) : filtered.length === 0 ? (
              <p className="px-3 py-4 text-sm text-wf-ink-dim text-center">No results</p>
            ) : (
              filtered.map((option) => (
                <button
                  key={option.id}
                  type="button"
                  onClick={() => { onChange?.(option.id); setOpen(false); setQuery(''); }}
                  className="w-full flex items-center gap-2.5 px-3 py-2 hover:bg-wf-fill transition-colors text-left"
                >
                  <Avatar src={option.avatar} name={option.name} />
                  <div className="flex-1 min-w-0">
                    <p className="text-sm text-wf-ink truncate">{option.name}</p>
                    {option.subtitle && (
                      <p className="text-xs text-wf-ink-dim truncate">{option.subtitle}</p>
                    )}
                  </div>
                  {value === option.id && (
                    <span className="text-wf-accent text-sm">✓</span>
                  )}
                </button>
              ))
            )}
          </div>

          {/* Footer */}
          {onCreate && (
            <div className="border-t border-wf-line p-2">
              <button
                type="button"
                onClick={() => { onCreate(); setOpen(false); }}
                className="w-full text-left px-2 py-1.5 text-sm text-wf-accent hover:bg-wf-accent-soft rounded transition-colors"
              >
                + Create new {target}
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
