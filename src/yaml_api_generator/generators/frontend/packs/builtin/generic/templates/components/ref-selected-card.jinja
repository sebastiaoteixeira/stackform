import { useEffect, useState } from 'react';
import { useAuth } from '../__generated__/App';
import { API_BASE_URL } from '../__generated__/config';

interface RefRecord {
  id: string;
  name: string;
  subtitle?: string;
  avatar?: string;
}

interface RefSelectedCardProps {
  target: string;
  targetEndpoint: string;
  value?: string | null;
  onChange?: (id: string | null) => void;
  onSwap?: () => void;
}

export function RefSelectedCard({
  target,
  targetEndpoint,
  value,
  onChange,
  onSwap,
}: RefSelectedCardProps) {
  const [record, setRecord] = useState<RefRecord | null>(null);
  const [loading, setLoading] = useState(false);
  const { token } = useAuth();

  useEffect(() => {
    if (!value) { setRecord(null); return; }

    setLoading(true);
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    fetch(`${API_BASE_URL}${targetEndpoint}/${value}`, { headers })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => setRecord(data))
      .catch(() => setRecord(null))
      .finally(() => setLoading(false));
  }, [value, token, targetEndpoint]);

  if (!value) {
    return (
      <div className="wf-card border-dashed flex flex-col items-center justify-center py-6 text-center gap-2">
        <p className="text-sm text-wf-ink-dim">No {target} selected</p>
        <button type="button" onClick={onSwap} className="wf-btn wf-btn-sm wf-btn-primary">
          Pick {target}
        </button>
      </div>
    );
  }

  if (loading) {
    return (
      <div className="wf-card flex items-center gap-3 py-3">
        <div className="w-12 h-12 rounded-full bg-wf-fill animate-pulse flex-shrink-0" />
        <div className="flex-1 space-y-2">
          <div className="h-4 bg-wf-fill rounded animate-pulse w-32" />
          <div className="h-3 bg-wf-fill rounded animate-pulse w-24" />
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-1.5">
      <div className="wf-card flex items-center gap-3">
        {/* Large avatar */}
        {record?.avatar ? (
          <img
            src={record.avatar}
            alt={record?.name ?? ''}
            className="w-12 h-12 rounded-full object-cover flex-shrink-0"
          />
        ) : (
          <span className="w-12 h-12 rounded-full bg-wf-accent-soft flex items-center justify-center text-lg font-medium text-wf-accent-ink flex-shrink-0">
            {(record?.name ?? '?').charAt(0).toUpperCase()}
          </span>
        )}

        {/* Info */}
        <div className="flex-1 min-w-0">
          <p className="font-medium text-wf-ink text-sm truncate">{record?.name ?? '—'}</p>
          {record?.subtitle && (
            <p className="text-xs text-wf-ink-dim truncate">{record.subtitle}</p>
          )}
          <p className="wf-mono mt-0.5">{value}</p>
        </div>

        {/* Actions */}
        <div className="flex items-center gap-1.5 flex-shrink-0">
          <button
            type="button"
            onClick={onSwap}
            className="wf-btn wf-btn-sm"
          >
            Change
          </button>
          <button
            type="button"
            onClick={() => onChange?.(null)}
            className="wf-btn wf-btn-sm text-wf-ink-dim"
            title="Clear selection"
          >
            x
          </button>
        </div>
      </div>

      {/* Help text */}
      <p className="text-xs text-wf-ink-faint px-0.5">
        Resolved by ID — the display name is fetched at runtime.
      </p>
    </div>
  );
}
