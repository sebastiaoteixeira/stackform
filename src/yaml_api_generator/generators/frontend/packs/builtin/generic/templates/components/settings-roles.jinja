type Verdict = 'allow' | 'deny' | 'conditional';

interface IdentityRoles {
  identity: string;
  field: string | null;
  defaultRole: string;
  includes: Record<string, string[]>;
}

const ROLES: IdentityRoles[] = [
{% for entity in context.entities.values() if entity.roles %}
  {
    identity: {{ entity.name | tojson }},
    field: {{ entity.roles.field | tojson }},
    defaultRole: {{ entity.roles.default | tojson }},
    includes: {{ entity.roles.includes | tojson }},
  },
{% endfor %}
];

const ACCESS: Record<string, Record<string, Record<string, Verdict>>> = {
{% for entity in context.entities.values() if entity.access %}
  {{ entity.name | tojson }}: {{ entity.access | tojson }},
{% endfor %}
};

const OPERATIONS = ['list', 'get', 'create', 'update', 'replace', 'delete'];

const VERDICT_STYLE: Record<Verdict, string> = {
  allow: 'bg-wf-accent text-white',
  conditional: 'bg-wf-accent-soft text-wf-accent-ink',
  deny: 'bg-wf-fill text-wf-ink-faint',
};

interface SettingsRolesProps {
  entities?: string[];
}

export function SettingsRoles({ entities = Object.keys(ACCESS) }: SettingsRolesProps) {
  const columns = Array.from(
    new Set(entities.flatMap((entity) => Object.values(ACCESS[entity] ?? {}).flatMap(Object.keys))),
  );

  return (
    <div className="p-6 bg-wf-bg min-h-full">
      <div className="wf-toolbar mb-5">
        <h1 className="font-title text-2xl text-wf-ink">Roles & permissions</h1>
      </div>

      {ROLES.map((roles) => (
        <div key={roles.identity} className="wf-card mb-5">
          <h2 className="font-title text-lg text-wf-ink mb-2">{roles.identity}</h2>
          <ul className="flex flex-col gap-1 text-sm">
            {Object.entries(roles.includes).map(([role, included]) => (
              <li key={role} className="flex items-center gap-2">
                <span className="wf-badge">{role}</span>
                {role === roles.defaultRole && <span className="text-wf-ink-faint">default</span>}
                {included.length > 0 && (
                  <span className="text-wf-ink-dim">includes {included.join(', ')}</span>
                )}
              </li>
            ))}
          </ul>
          {roles.field && <p className="mt-2 text-xs text-wf-ink-faint">Stored in {roles.field}</p>}
        </div>
      ))}

      <div className="wf-card overflow-auto p-0">
        <table className="wf-table">
          <thead>
            <tr>
              <th className="text-left w-40">Entity</th>
              {columns.map((column) => (
                <th key={column} className="text-center">
                  {column}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {entities.map((entity) => (
              <tr key={entity}>
                <td className="font-title text-[15px] text-wf-ink">{entity}</td>
                {columns.map((column) => (
                  <td key={column} className="text-center">
                    <div className="flex items-center justify-center gap-0.5">
                      {OPERATIONS.filter((operation) => ACCESS[entity]?.[operation]).map((operation) => {
                        const verdict = ACCESS[entity][operation][column];
                        return (
                          <span
                            key={operation}
                            title={`${column} ${operation}: ${verdict}`}
                            className={`px-1 h-5 rounded text-[10px] font-mono font-medium ${VERDICT_STYLE[verdict]}`}
                          >
                            {operation}
                          </span>
                        );
                      })}
                    </div>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p className="mt-3 text-xs text-wf-ink-faint">
        Filled: allowed. Tinted: allowed when the rule's condition holds. Faint: denied.
      </p>
    </div>
  );
}

export default SettingsRoles;
