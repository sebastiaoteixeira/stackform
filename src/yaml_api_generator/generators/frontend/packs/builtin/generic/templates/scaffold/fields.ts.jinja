export type FieldConfig = {
  type: string;
  required?: boolean;
  readonly?: boolean;
  default?: unknown;
  format?: string;
  values?: string[];
  items?: FieldConfig;
  properties?: Fields;
  [key: string]: unknown;
};
export type Fields = Record<string, FieldConfig>;
export type FormValues = Record<string, unknown>;

{% macro fields_by_entity(name, attribute) %}
export const {{ name }}: Record<string, Fields> = {
{% for entity in entities.values() %}
  {{ entity.name | tojson }}: {
{% for field in entity[attribute] %}
    {{ field.name | tojson }}: {{ field.config | tojson }},
{% endfor %}
  },
{% endfor %}
};
{% endmacro %}
/** The fields a client may send for each entity: every declared field except its id and readonly ones. */
{{ fields_by_entity('ENTITY_FIELDS', 'writable_fields') }}
/** What each identity sends only when it is created: the password its login checks. */
{{ fields_by_entity('CREDENTIAL_FIELDS', 'credential_fields') }}
/** What each identity registers with: its identifier first, then its other fields and credentials. */
{{ fields_by_entity('SIGNUP_FIELDS', 'signup_fields') }}

const STRUCTURED = new Set(['object', 'array']);

function localDateTime(value: string): string {
  const moment = new Date(value);
  return new Date(moment.getTime() - moment.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
}

/** `value` without the nested readonly properties its field declares, which the API never accepts. */
function writable(config: FieldConfig, value: unknown): unknown {
  const { items, properties } = config;
  if (Array.isArray(value) && items) return value.map(item => writable(items, item));
  if (value === null || typeof value !== 'object' || !properties) return value;
  return Object.fromEntries(
    Object.entries(value)
      .filter(([name]) => !properties[name]?.readonly)
      .map(([name, item]) => [name, name in properties ? writable(properties[name], item) : item])
  );
}

/** `value`, as the API returns it, in the form an input of its field holds. */
export function inputValue(config: FieldConfig, value: unknown): unknown {
  if (config.type === 'boolean') return Boolean(value);
  if (value === undefined || value === null) return '';
  if (STRUCTURED.has(config.type)) return JSON.stringify(writable(config, value), null, 2);
  if (config.type === 'datetime') return localDateTime(String(value));
  return String(value);
}

/** What an input holds, as the API accepts it; a blank input is `undefined`. */
export function apiValue(config: FieldConfig, input: unknown): unknown {
  if (config.type === 'boolean') return Boolean(input);
  if (input === undefined || input === null || input === '') return undefined;
  const text = String(input);
  if (config.type === 'number') return Number(text);
  if (config.type === 'datetime') return new Date(text).toISOString();
  if (STRUCTURED.has(config.type)) return JSON.parse(text);
  return text;
}

/** The input values of `fields` for `record`, a field it lacks starting at its declared default. */
export function formValues(fields: Fields, record: Record<string, unknown> = {}): FormValues {
  return Object.fromEntries(
    Object.entries(fields).map(([name, config]) => [name, inputValue(config, record[name] ?? config.default)])
  );
}

/** The request body for `values`, leaving out blank fields. */
export function payload(fields: Fields, values: FormValues): Record<string, unknown> {
  return Object.fromEntries(
    Object.entries(fields)
      .filter(([name]) => name in values)
      .map(([name, config]) => [name, apiValue(config, values[name])])
      .filter(([, value]) => value !== undefined)
  );
}
