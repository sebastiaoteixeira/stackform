{% macro field_input(field, formData='formData', handler='handleFieldChange') %}
{% set is_textarea = field.name in ['content', 'body', 'description', 'excerpt', 'bio'] %}
{% set is_enum = field.type == 'enum' %}
{% set is_boolean = field.type == 'boolean' %}
{% set input_type = 'number' if field.type == 'number' else ('datetime-local' if field.type == 'datetime' else 'text') %}
<div className="wf-field">
  <label htmlFor="{{ field.name }}" className="block text-[11px] uppercase tracking-wide text-wf-ink-dim mb-1.5">
    {{ field.name | title }}{% if field.required %}<span className="text-wf-danger ml-0.5">*</span>{% endif %}
  </label>
  {% if is_boolean %}
  <label className="inline-flex items-center gap-2 cursor-pointer">
    <input
      id="{{ field.name }}"
      type="checkbox"
      name="{{ field.name }}"
      checked={ !!{{ formData }}.{{ field.name }} }
      onChange={ (e: React.ChangeEvent<HTMLInputElement>) => {{ handler }}({ target: { name: '{{ field.name }}', value: e.target.checked } } as any) }
      className="w-4 h-4 accent-wf-accent"
    />
    <span className="text-sm text-wf-ink-dim">{{ field.name | title }}</span>
  </label>
  {% elif is_enum and field.enum_values %}
  <div className="wf-input">
    <select
      id="{{ field.name }}"
      name="{{ field.name }}"
      value={ ({{ formData }}.{{ field.name }} as string) || ''}
      onChange={ {{ handler }} }
      {% if field.required %}required{% endif %}
      className="w-full bg-transparent outline-none text-wf-ink text-sm"
    >
      <option value="">Select...</option>
      {% for val in field.enum_values %}
      <option value="{{ val }}">{{ val | title }}</option>
      {% endfor %}
    </select>
  </div>
  {% elif is_textarea %}
  <div className="wf-input !items-start !py-2">
    <textarea
      id="{{ field.name }}"
      name="{{ field.name }}"
      value={ ({{ formData }}.{{ field.name }} as string) || ''}
      onChange={ {{ handler }} }
      rows={ {{ 8 if field.name == 'content' else 3 }} }
      {% if field.required %}required{% endif %}
      className="w-full bg-transparent outline-none resize-none text-wf-ink text-sm"
    />
  </div>
  {% else %}
  <div className="wf-input">
    <input
      id="{{ field.name }}"
      type="{{ input_type }}"
      name="{{ field.name }}"
      value={ ({{ formData }}.{{ field.name }} as string) || ''}
      onChange={ {{ handler }} }
      {% if field.required %}required{% endif %}
      className="w-full bg-transparent outline-none text-wf-ink text-sm"
    />
  </div>
  {% endif %}
</div>
{% endmacro %}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../__generated__/App';
import { callOperation } from '../__generated__/records';

interface {{ entity.name | pascal_case }}StackedFormProps {
  mode?: 'create' | 'edit';
  initialData?: Record<string, unknown>;
  entityId?: string;
  basePath?: string;
}

export function {{ entity.name | pascal_case }}StackedForm({
  mode = 'create',
  initialData = {},
  entityId,
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}StackedFormProps) {
  const [formData, setFormData] = useState<Record<string, unknown>>(initialData);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();
  const { token } = useAuth();

  const handleFieldChange = (
    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>
  ) => setFormData(prev => ({ ...prev, [e.target.name]: e.target.value }));

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      const res = await callOperation('{{ entity.name }}', {% if entity.edit_operation %}mode === 'edit' ? '{{ entity.edit_operation }}' : {% endif %}'create', {
        id: entityId,
        headers,
        body: JSON.stringify(formData),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.detail || `Failed to ${mode} {{ entity.name }}`);
      }

      const result = await res.json();
      navigate(`${basePath}/${result.{{ entity.pk_field }}}`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-wf-bg">
      {/* Toolbar */}
      <div className="wf-toolbar px-5 py-3 border-b border-wf-line bg-wf-surface sticky top-0 z-10">
        <button
          type="button"
          onClick={() => navigate(-1)}
          className="wf-btn wf-btn-ghost text-wf-ink-dim"
        >
          ←
        </button>
        <h1 className="font-title text-base text-wf-ink flex-1">
          {mode === 'create' ? 'New' : 'Edit'} {{ entity.name | title }}
        </h1>
        <button type="button" onClick={() => navigate(-1)} className="wf-btn">
          Cancel
        </button>
        <button type="button" form="stacked-form" className="wf-btn">
          Save as draft
        </button>
        <button type="submit" form="stacked-form" disabled={submitting} className="wf-btn wf-btn-primary">
          {submitting ? 'Saving...' : 'Publish'}
        </button>
      </div>

      {/* Form body */}
      <div className="mx-auto py-8 px-4" style={{ "{{" }} maxWidth: '580px' {{ "}}" }}>
        {error && (
          <div className="mb-6 p-4 bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf">
            <p className="text-wf-ink text-sm">{error}</p>
          </div>
        )}

        <form id="stacked-form" onSubmit={handleSubmit} style={{ "{{" }} display: 'flex', flexDirection: 'column', gap: '14px' {{ "}}" }}>
          {% for field in entity.fields.values() %}
          {% if field.name != entity.pk_field and not field.readonly %}
          {{ field_input(field) }}
          {% endif %}
          {% endfor %}
        </form>
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}StackedForm;
