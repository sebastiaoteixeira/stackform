{% from 'macros/field_input.jinja' import field_input %}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useRecordForm } from '../__generated__/useRecordForm';

interface {{ entity.name | pascal_case }}StackedFormProps {
  entityId?: string;
  basePath?: string;
}

export function {{ entity.name | pascal_case }}StackedForm({
  entityId,
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}StackedFormProps) {
  const { values, setValue, mode, submit } = useRecordForm({{ entity.name | tojson }}, '{{ entity.repository_name | kebab_case }}', entityId);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      const result = await submit();
      navigate(`${basePath}/${result.{{ entity.pk_field }}}`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-wf-bg">
      {/* Toolbar */}
      <div className="wf-toolbar px-5 py-3 border-b border-wf-line bg-wf-surface sticky top-0 z-10">
        <button
          type="button"
          onClick={() => navigate(-1)}
          className="wf-btn wf-btn-ghost text-wf-ink-dim"
        >
          ←
        </button>
        <h1 className="font-title text-base text-wf-ink flex-1">
          {mode === 'create' ? 'New' : 'Edit'} {{ entity.name | title }}
        </h1>
        <button type="button" onClick={() => navigate(-1)} className="wf-btn">
          Cancel
        </button>
        <button type="button" form="stacked-form" className="wf-btn">
          Save as draft
        </button>
        <button type="submit" form="stacked-form" disabled={submitting} className="wf-btn wf-btn-primary">
          {submitting ? 'Saving...' : 'Publish'}
        </button>
      </div>

      {/* Form body */}
      <div className="mx-auto py-8 px-4" style={{ "{{" }} maxWidth: '580px' {{ "}}" }}>
        {error && (
          <div className="mb-6 p-4 bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf">
            <p className="text-wf-ink text-sm">{error}</p>
          </div>
        )}

        <form id="stacked-form" onSubmit={handleSubmit} style={{ "{{" }} display: 'flex', flexDirection: 'column', gap: '14px' {{ "}}" }}>
          {% for field in entity.fields.values() %}
          {% if field.name != entity.pk_field and not field.readonly %}
          {{ field_input(field) }}
          {% endif %}
          {% endfor %}
        </form>
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}StackedForm;
