import { useEffect, useRef, useState } from 'react';
import { useAuth } from '../__generated__/App';
import { API_BASE_URL } from '../__generated__/config';

interface RefOption {
  id: string;
  name: string;
  subtitle?: string;
  avatar?: string;
}

interface RefMultiChipsProps {
  target: string;
  targetEndpoint: string;
  values?: string[];
  onChange?: (ids: string[]) => void;
}

function Avatar({ src, name, size = 'sm' }: { src?: string; name: string; size?: 'sm' | 'xs' }) {
  const dim = size === 'xs' ? 'w-4 h-4 text-[9px]' : 'w-5 h-5 text-[10px]';
  if (src) {
    return <img src={src} alt={name} className={`${dim} rounded-full object-cover flex-shrink-0`} />;
  }
  return (
    <span className={`${dim} rounded-full bg-wf-accent-soft flex items-center justify-center font-medium text-wf-accent-ink flex-shrink-0`}>
      {name.charAt(0).toUpperCase()}
    </span>
  );
}

export function RefMultiChips({
  target,
  targetEndpoint,
  values = [],
  onChange,
}: RefMultiChipsProps) {
  const [query, setQuery] = useState('');
  const [focused, setFocused] = useState(false);
  const [options, setOptions] = useState<RefOption[]>([]);
  const [loading, setLoading] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);
  const { token } = useAuth();

  const selected = options.filter((o) => values.includes(o.id));

  useEffect(() => {
    if (!focused) return;
    setLoading(true);
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    fetch(`${API_BASE_URL}${targetEndpoint}`, { headers })
      .then((r) => r.json())
      .then((data) => setOptions(Array.isArray(data) ? data : []))
      .catch(() => setOptions([]))
      .finally(() => setLoading(false));
  }, [focused, token, targetEndpoint]);

  useEffect(() => {
    const handler = (e: MouseEvent) => {
      if (!containerRef.current?.contains(e.target as Node)) setFocused(false);
    };
    document.addEventListener('mousedown', handler);
    return () => document.removeEventListener('mousedown', handler);
  }, []);

  const filtered = options.filter(
    (o) => !values.includes(o.id) && o.name.toLowerCase().includes(query.toLowerCase())
  );

  const add = (id: string) => { onChange?.([...values, id]); setQuery(''); };
  const remove = (id: string) => onChange?.(values.filter((v) => v !== id));

  return (
    <div ref={containerRef} className="space-y-1.5">
      {/* Input container */}
      <div
        onClick={() => { setFocused(true); inputRef.current?.focus(); }}
        className={`wf-input flex-wrap gap-1.5 cursor-text min-h-[44px] ${focused ? 'border-wf-accent ring-1 ring-wf-accent' : ''}`}
      >
        {selected.map((opt) => (
          <span
            key={opt.id}
            className="flex items-center gap-1 px-2 py-0.5 rounded-full bg-wf-accent-soft border border-wf-accent-soft text-xs text-wf-accent-ink"
          >
            <Avatar src={opt.avatar} name={opt.name} size="xs" />
            <span>{opt.name}</span>
            <button
              type="button"
              onClick={(e) => { e.stopPropagation(); remove(opt.id); }}
              className="text-wf-accent-ink hover:text-wf-danger ml-0.5 leading-none"
            >
              x
            </button>
          </span>
        ))}
        <input
          ref={inputRef}
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onFocus={() => setFocused(true)}
          placeholder={selected.length === 0 ? `Add ${target}s...` : 'add more...'}
          className="flex-1 min-w-[80px] outline-none text-sm bg-transparent text-wf-ink placeholder:text-wf-ink-faint"
        />
      </div>

      {/* Help text */}
      <p className="text-xs text-wf-ink-faint px-0.5">
        {values.length} selected — type to search
      </p>

      {/* Dropdown */}
      {focused && (
        <div className="border-[1.5px] border-wf-line-strong rounded-wf shadow-xl bg-wf-surface overflow-hidden">
          <div className="max-h-48 overflow-auto">
            {loading ? (
              <p className="px-3 py-4 text-sm text-wf-ink-dim text-center">Loading...</p>
            ) : filtered.length === 0 ? (
              <p className="px-3 py-4 text-sm text-wf-ink-dim text-center">
                {query ? 'No results' : `All ${target}s selected`}
              </p>
            ) : (
              filtered.map((option) => (
                <button
                  key={option.id}
                  type="button"
                  onMouseDown={(e) => e.preventDefault()}
                  onClick={() => add(option.id)}
                  className="w-full flex items-center gap-2.5 px-3 py-2 hover:bg-wf-fill transition-colors text-left"
                >
                  <Avatar src={option.avatar} name={option.name} />
                  <div className="flex-1 min-w-0">
                    <p className="text-sm text-wf-ink truncate">{option.name}</p>
                    {option.subtitle && (
                      <p className="text-xs text-wf-ink-dim truncate">{option.subtitle}</p>
                    )}
                  </div>
                </button>
              ))
            )}
          </div>
        </div>
      )}
    </div>
  );
}
