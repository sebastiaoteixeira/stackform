{% from 'macros/field_input.jinja' import field_input %}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useRecordForm } from '../__generated__/useRecordForm';

interface {{ entity.name | pascal_case }}SectionedFormProps {
  entityId?: string;
  basePath?: string;
}

{% set all_fields = entity.fields.values() | rejectattr('name', 'equalto', entity.pk_field) | rejectattr('readonly') | list %}

{% set basic_fields = [] %}
{% set content_fields = [] %}
{% set publishing_fields = [] %}
{% set seo_fields = [] %}
{% set advanced_fields = [] %}

{% for field in all_fields %}
{% if field.name in ['title', 'name', 'displayName', 'slug', 'email', 'username'] %}
{% set _ = basic_fields.append(field) %}
{% elif field.name in ['content', 'body', 'description', 'excerpt', 'bio', 'summary'] %}
{% set _ = content_fields.append(field) %}
{% elif field.name in ['status', 'publishedAt', 'publishedOn', 'scheduledAt'] or field.type == 'enum' %}
{% set _ = publishing_fields.append(field) %}
{% elif field.name in ['metaTitle', 'metaDescription', 'keywords', 'canonicalUrl', 'ogTitle', 'ogImage'] %}
{% set _ = seo_fields.append(field) %}
{% else %}
{% set _ = advanced_fields.append(field) %}
{% endif %}
{% endfor %}

type SectionId = 'basics' | 'content' | 'publishing' | 'seo' | 'advanced';

const SECTIONS: Array<{ id: SectionId; label: string }> = [
  { id: 'basics', label: 'Basics' },
  {% if content_fields %}{ id: 'content', label: 'Content' },{% endif %}
  {% if publishing_fields %}{ id: 'publishing', label: 'Publishing' },{% endif %}
  {% if seo_fields %}{ id: 'seo', label: 'SEO' },{% endif %}
  {% if advanced_fields %}{ id: 'advanced', label: 'Advanced' },{% endif %}
];

export function {{ entity.name | pascal_case }}SectionedForm({
  entityId,
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}SectionedFormProps) {
  const { values, setValue, mode, submit } = useRecordForm({{ entity.name | tojson }}, entityId);
  const [activeSection, setActiveSection] = useState<SectionId>('basics');
  const [submitting, setSubmitting] = useState(false);
  const [hasChanges, setHasChanges] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();

  const change = (name: string, value: unknown) => {
    setValue(name, value);
    setHasChanges(true);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      const result = await submit();
      navigate(`${basePath}/${result.{{ entity.pk_field }}}`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-wf-bg">
      {/* Toolbar */}
      <div className="wf-toolbar px-5 py-3 border-b border-wf-line bg-wf-surface sticky top-0 z-10">
        <h1 className="font-title text-base text-wf-ink flex-1">
          {mode === 'create' ? 'New' : 'Edit'} {{ entity.name | title }}
        </h1>
        {hasChanges && (
          <span className="wf-badge wf-badge-warn">unsaved changes</span>
        )}
        <button type="button" onClick={() => navigate(-1)} className="wf-btn">
          Discard
        </button>
        <button type="submit" form="sectioned-form" disabled={submitting} className="wf-btn wf-btn-primary">
          {submitting ? 'Saving...' : 'Save'}
        </button>
      </div>

      {error && (
        <div className="mx-6 mt-4 p-4 bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf">
          <p className="text-wf-ink text-sm">{error}</p>
        </div>
      )}

      {/* Grid layout: 180px sidebar + 1fr main */}
      <div className="flex" style={{ "{{" }} minHeight: 'calc(100vh - 49px)' {{ "}}" }}>
        {/* Section nav sidebar */}
        <nav
          className="bg-wf-surface border-r border-wf-line flex flex-col gap-0.5 p-3 pt-5"
          style={{ "{{" }} width: '180px', flexShrink: 0 {{ "}}" }}
        >
          {SECTIONS.map(section => (
            <button
              key={section.id}
              type="button"
              onClick={() => setActiveSection(section.id)}
              className={`wf-sidebar-item text-left ${activeSection === section.id ? 'is-active' : ''}`}
            >
              <span
                className="w-1.5 h-1.5 rounded-full flex-shrink-0"
                style={{ "{{" }} background: activeSection === section.id ? 'var(--wf-accent)' : 'var(--wf-line-strong)' {{ "}}" }}
              />
              {section.label}
            </button>
          ))}
        </nav>

        {/* Scrollable main content */}
        <main className="flex-1 overflow-y-auto">
          <form id="sectioned-form" onSubmit={handleSubmit} className="max-w-2xl mx-auto py-8 px-6">
            {/* Basics */}
            {activeSection === 'basics' && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">Basics</h2>
                <p className="text-wf-ink-dim text-sm mb-6">Essential information</p>
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in basic_fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                  {% if not basic_fields %}
                  {% for field in all_fields | first | default([]) %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                  {% endif %}
                </div>
              </div>
            )}

            {% if content_fields %}
            {/* Content */}
            {activeSection === 'content' && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">Content</h2>
                <p className="text-wf-ink-dim text-sm mb-6">Main content and descriptions</p>
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in content_fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                </div>
              </div>
            )}
            {% endif %}

            {% if publishing_fields %}
            {/* Publishing */}
            {activeSection === 'publishing' && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">Publishing</h2>
                <p className="text-wf-ink-dim text-sm mb-6">Visibility and scheduling</p>
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in publishing_fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                </div>
              </div>
            )}
            {% endif %}

            {% if seo_fields %}
            {/* SEO */}
            {activeSection === 'seo' && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">SEO</h2>
                <p className="text-wf-ink-dim text-sm mb-6">Search engine optimization</p>
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in seo_fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                </div>
              </div>
            )}
            {% endif %}

            {% if advanced_fields %}
            {/* Advanced */}
            {activeSection === 'advanced' && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">Advanced</h2>
                <p className="text-wf-ink-dim text-sm mb-6">Additional configuration</p>
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in advanced_fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                </div>
              </div>
            )}
            {% endif %}
          </form>
        </main>
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}SectionedForm;
