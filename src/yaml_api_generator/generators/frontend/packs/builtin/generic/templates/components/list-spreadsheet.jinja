import { useEffect, useRef, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../__generated__/App';
import { callOperation, displayValue, listRecords } from '../__generated__/records';

interface {{ entity.name | pascal_case }} {
  {{ entity.pk_field }}: string;
  {% for field in entity.fields.values() %}
  {{ field.name }}: {% if field.type == 'string' %}string{% elif field.type == 'number' %}number{% elif field.type == 'boolean' %}boolean{% else %}any{% endif %};
  {% endfor %}
}

type ActiveCell = { id: string; field: string };
type SaveState = 'idle' | 'saving' | 'saved' | 'error';

{% set editable_fields = entity.fields.values() | rejectattr('name', 'equalto', entity.pk_field) | list %}

export default function {{ view.name | pascal_case }}() {
  const [items, setItems] = useState<{{ entity.name | pascal_case }}[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [activeCell, setActiveCell] = useState<ActiveCell | null>(null);
  const [editValue, setEditValue] = useState('');
  const [saveState, setSaveState] = useState<SaveState>('idle');
  const inputRef = useRef<HTMLInputElement>(null);
  const { token } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    listRecords('{{ entity.name }}', headers)
      .then(data => {
        setItems(data);
        setLoading(false);
      })
      .catch(err => {
        setError(err.message);
        setLoading(false);
      });
  }, [token]);

  useEffect(() => {
    if (activeCell) inputRef.current?.focus();
  }, [activeCell]);

  const activateCell = (id: string, field: string, currentValue: unknown) => {
    setActiveCell({ id, field });
    setEditValue(String(currentValue ?? ''));
    setSaveState('idle');
  };

  const commitCell = async () => {
    if (!activeCell) return;

    setSaveState('saving');
    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;

    try {
      const res = await callOperation('{{ entity.name }}', 'update', {
        id: activeCell.id,
        headers,
        body: JSON.stringify({ [activeCell.field]: editValue }),
      });
      if (!res.ok) throw new Error('Save failed');
      const updated = await res.json();
      setItems(prev => prev.map(item => item.{{ entity.pk_field }} === activeCell.id ? updated : item));
      setSaveState('saved');
      setActiveCell(null);
    } catch {
      setSaveState('error');
    }
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') { e.preventDefault(); commitCell(); }
    if (e.key === 'Escape') { setActiveCell(null); setSaveState('idle'); }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-wf-ink-dim">Loading...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf p-4">
          <p className="text-wf-ink font-medium mb-1">Error loading data</p>
          <p className="text-wf-ink-dim text-sm">{error}</p>
        </div>
      </div>
    );
  }

  if (items.length === 0) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-center p-12 border-[1.5px] border-dashed border-wf-line rounded-lg max-w-md">
          <div className="w-[60px] h-[60px] mx-auto mb-4 border-[1.5px] border-dashed border-wf-line rounded-lg flex items-center justify-center">
            <span className="font-title text-2xl text-wf-ink-faint">∅</span>
          </div>
          <h3 className="font-title text-xl text-wf-ink mb-2">No {{ entity.name | lower }}s yet</h3>
          <p className="text-wf-ink-dim text-sm mb-4">Create your first record to get started.</p>
          <button onClick={() => navigate('{{ view.path }}/new')} className="wf-btn wf-btn-primary">
            + New {{ entity.name | title }}
          </button>
        </div>
      </div>
    );
  }

  const saveBadge = {
    saving: <span className="wf-mono text-xs text-wf-ink-dim">Saving…</span>,
    saved:  <span className="wf-mono text-xs text-wf-success">Saved</span>,
    error:  <span className="wf-mono text-xs text-wf-danger">Error saving</span>,
    idle:   null,
  }[saveState];

  return (
    <div className="h-full flex flex-col">
      {/* Toolbar */}
      <div className="wf-toolbar px-6 pt-4">
        <h1 className="font-title text-2xl text-wf-ink">{{ entity.name | title }}</h1>
        <span className="wf-mono text-wf-ink-dim">{items.length} rows</span>
        {saveBadge}
        <div className="flex-1" />
        {activeCell && (
          <button className="wf-btn wf-btn-primary wf-btn-sm" onClick={commitCell}>
            Save
          </button>
        )}
        <button
          onClick={() => navigate('{{ view.path }}/new')}
          className="wf-btn wf-btn-primary"
        >
          + New
        </button>
      </div>

      {/* Hint */}
      {activeCell && (
        <div className="px-6 py-1.5 border-b border-wf-line bg-wf-accent-soft">
          <span className="wf-mono text-xs text-wf-accent-ink">
            Editing row {items.findIndex(i => i.{{ entity.pk_field }} === activeCell.id) + 1} · {activeCell.field}
            &nbsp;&nbsp;Enter to save · Esc to cancel
          </span>
        </div>
      )}

      {/* Spreadsheet */}
      <div className="flex-1 overflow-auto px-6 pb-6">
        <div className="border-2 border-wf-line-strong rounded-wf overflow-hidden bg-wf-surface">
          <table className="min-w-full border-collapse text-sm">
            <thead className="sticky top-0 z-10 bg-wf-fill border-b-2 border-wf-line-strong">
              <tr>
                {/* Row number column */}
                <th className="w-12 px-3 py-2 text-center wf-mono text-xs text-wf-ink-faint border-r border-wf-line font-normal">
                  #
                </th>
                {% for field in editable_fields %}
                <th className="px-3 py-2 text-left wf-mono text-xs text-wf-ink-dim uppercase tracking-wider border-r border-wf-line font-medium">
                  {{ field.name | title }} ▾
                </th>
                {% endfor %}
                {/* Actions column */}
                <th className="w-10 border-l-2 border-wf-line-strong" />
              </tr>
            </thead>
            <tbody>
              {items.map((item, rowIndex) => (
                <tr
                  key={item.{{ entity.pk_field }}}
                  className={`border-b border-wf-line ${
                    activeCell?.id === item.{{ entity.pk_field }} ? 'bg-wf-accent-soft/30' : 'hover:bg-wf-fill'
                  }`}
                >
                  {/* Row number */}
                  <td className="px-3 py-1.5 text-center wf-mono text-xs text-wf-ink-faint bg-wf-fill border-r border-wf-line select-none">
                    {rowIndex + 1}
                  </td>

                  {% for field in editable_fields %}
                  <td
                    className={`border-r border-wf-line p-0 ${
                      activeCell?.id === item.{{ entity.pk_field }} && activeCell?.field === '{{ field.name }}'
                        ? 'outline outline-2 outline-wf-accent outline-offset-[-2px] bg-wf-surface'
                        : 'cursor-cell'
                    }`}
                    onClick={() => {
                      if (!activeCell) activateCell(item.{{ entity.pk_field }}, '{{ field.name }}', item.{{ field.name }});
                    }}
                  >
                    {activeCell?.id === item.{{ entity.pk_field }} && activeCell?.field === '{{ field.name }}' ? (
                      <input
                        ref={inputRef}
                        type="{% if field.type == 'number' %}number{% else %}text{% endif %}"
                        value={editValue}
                        onChange={(e) => setEditValue(e.target.value)}
                        onKeyDown={handleKeyDown}
                        onBlur={commitCell}
                        className="w-full px-3 py-1.5 bg-transparent border-none outline-none text-wf-ink text-sm"
                      />
                    ) : (
                      <div className="px-3 py-1.5 text-wf-ink">
                        {% if field.type == 'enum' %}
                        <span className="wf-badge">{displayValue(item.{{ field.name }})}</span>
                        {% elif field.name in ['id', 'pk', 'createdAt', 'updatedAt'] %}
                        <span className="wf-mono">{String(item.{{ field.name }} || '')}</span>
                        {% else %}
                        {String(item.{{ field.name }} ?? '')}
                        {% endif %}
                      </div>
                    )}
                  </td>
                  {% endfor %}

                  {/* Row actions */}
                  <td className="w-10 text-center border-l-2 border-wf-line-strong">
                    <button
                      onClick={() => navigate(`{{ view.path }}/${item.{{ entity.pk_field }}}`)}
                      className="px-2 py-1.5 text-wf-ink-faint hover:text-wf-accent text-sm"
                    >
                      ⋯
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
