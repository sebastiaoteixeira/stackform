services:
  app:
    {% if ctx.image %}
    image: {{ ctx.image }}
    {% else %}
    build: .
    {% endif %}
    ports:
      - "{{ ctx.port }}:{{ ctx.port }}"
    env_file:
      - .env
    restart: unless-stopped
    {% if ctx.mongo_local %}
    depends_on:
      - mongodb
    {% endif %}
  {% if ctx.mongo_local %}
  mongodb:
    image: mongo:8
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped
  {% endif %}
{% if ctx.mongo_local %}
volumes:
  mongo_data:
{% endif %}