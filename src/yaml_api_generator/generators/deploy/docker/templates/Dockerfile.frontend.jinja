# syntax=docker/dockerfile:1
{% set frontend = ctx.frontend %}
{% set mounts %}{% for name in frontend.secrets %}--mount=type=secret,id={{ name | lower }},env={{ name }} {% endfor %}{% endset %}
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json {% if frontend.locked %}package-lock.json {% endif %}./
RUN {{ mounts }}{{ "npm ci" if frontend.locked else "npm install" }}

COPY . ./

{% for name in frontend.args %}
ARG {{ name }}
{% endfor %}
RUN {{ mounts }}{{ frontend.build }}

FROM nginx:alpine

COPY --from=builder /app/{{ frontend.output }} /usr/share/nginx/html
COPY --from=nginx . /etc/nginx/templates/

EXPOSE 80
