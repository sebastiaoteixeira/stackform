FROM python:3.11-slim AS generated
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
{% for vol in ctx.app_volumes %}
RUN install -d -o app {{ vol.path }}
{% endfor %}
USER 10001
{% if ctx.packages or ctx.system_packages %}

FROM generated
USER root
{% if ctx.system_packages %}
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{ ctx.system_packages | join(" ") }} \
    && rm -rf /var/lib/apt/lists/*
{% endif %}
{% for package in ctx.packages %}
{% for requirements in package.requirements %}
RUN --mount=type=bind,from={{ package.name }},source={{ requirements }},target=/tmp/requirements.txt \
    pip install --no-cache-dir -r /tmp/requirements.txt
{% endfor %}
COPY --from={{ package.name }} . {{ package.name }}/
{% endfor %}
USER 10001
{% endif %}
EXPOSE {{ ctx.port }}
CMD ["uvicorn", "{{ ctx.asgi_process.asgi }}", "--host", "0.0.0.0", "--port", "{{ ctx.port }}"]
