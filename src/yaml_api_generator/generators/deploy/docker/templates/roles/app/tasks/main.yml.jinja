- name: Create app directory
  file:
    path: /opt/{{ ctx.name }}
    state: directory
    mode: '0755'

- name: Copy app files
  synchronize:
    src: "{{ '{{' }} playbook_dir {{ '}}' }}/"
    dest: /opt/{{ ctx.name }}/
    delete: true
    rsync_opts:
      - "--exclude=roles"
      - "--exclude=playbook.yml"
      - "--exclude=inventory.yml"

{% if ctx.secret_env_names %}
- name: Generate deploy-time secrets
  set_fact:
    generated_secrets: "{{ '{{' }} generated_secrets | default({}) | combine({item: lookup('ansible.builtin.password', playbook_dir + '/.secrets/' + item + ' length=43 chars=ascii_letters,digits')}) {{ '}}' }}"
  loop:
{% for name in ctx.secret_env_names %}
    - {{ name }}
{% endfor %}

- name: Render .env on remote
  template:
    src: env.j2
    dest: /opt/{{ ctx.name }}/.env
    mode: '0600'
{% endif %}

- name: Start app
  community.docker.docker_compose_v2:
    project_src: /opt/{{ ctx.name }}
    state: present
    pull: {% if ctx.image %}always{% else %}never{% endif %}

    build: {% if ctx.image %}never{% else %}always{% endif %}
