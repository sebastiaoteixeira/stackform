{% if ctx.include %}
include:
  {% for path in ctx.include %}
  - {{ path }}
  {% endfor %}

{% endif %}
services:
  app:
    {% if ctx.image %}
    image: {{ ctx.image }}
    {% else %}
    build: ./backend
    {% endif %}
    environment:
      {% for line in ctx.app_environment %}
      - {{ line }}
      {% endfor %}
    ports:
      - "${APP_PORT:-{{ ctx.port }}}:{{ ctx.port }}"
    env_file:
      - .env
    restart: unless-stopped
    {% set local_datastores = ctx.datastores | selectattr("local") | list %}
    {% if local_datastores %}
    depends_on:
      {% for ds in local_datastores %}
      - {{ ds.service }}
      {% endfor %}
    {% endif %}

  {% for ds in local_datastores %}
  {{ ds.service }}:
    image: {{ ds.image }}
    {% if ds.service_env %}
    environment:
      {% for key, value in ds.service_env.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
    {% endif %}
    {% if ds.volume %}
    volumes:
      - {{ ds.volume }}:{{ ds.volume_path }}
    {% endif %}
    restart: unless-stopped
  {% endfor %}

  {% if ctx.has_frontend %}
  frontend:
    build:
      context: ./frontend
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-http://localhost:{{ ctx.port }}/api/v1}
    ports:
      - "${FRONTEND_PORT:-80}:80"
    depends_on:
      - app
    restart: unless-stopped
  {% endif %}

  {% for svc_name, svc_config in ctx.extra_services %}
  {{ svc_name }}:
{{ svc_config | to_yaml | indent(4, first=True) }}
  {% endfor %}

{% set extra_volumes = [] %}
{% for _, svc_config in ctx.extra_services %}
{% for vol in svc_config.get("volumes", []) %}
{% if ":" in vol and not vol.split(":")[0].startswith((".", "/")) %}
{% if extra_volumes.append(vol.split(":")[0]) %}{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% set datastore_volumes = local_datastores | selectattr("volume") | map(attribute="volume") | list %}
{% if datastore_volumes or extra_volumes %}
volumes:
  {% for vol in datastore_volumes %}
  {{ vol }}:
  {% endfor %}
  {% for vol in extra_volumes %}
  {{ vol }}:
  {% endfor %}
{% endif %}
