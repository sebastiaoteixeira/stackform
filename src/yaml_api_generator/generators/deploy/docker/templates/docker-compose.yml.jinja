{% if ctx.include %}
include:
  {% for path in ctx.include %}
  - {{ path }}
  {% endfor %}

{% endif %}
{% set local_datastores = ctx.datastores | selectattr("local") | list %}
{% set asgi = ctx.asgi_process %}
x-backend: &backend
  image: {{ ctx.backend_image }}
  env_file:
    - .env
  {% if ctx.app_volumes %}
  volumes:
    {% for vol in ctx.app_volumes %}
    - {{ vol.name }}:{{ vol.path }}
    {% endfor %}
  {% endif %}
  restart: unless-stopped
  {% if local_datastores %}
  depends_on:
    {% for ds in local_datastores %}
    - {{ ds.service }}
    {% endfor %}
  {% endif %}

services:
  {% for process in ctx.processes %}
  {{ process.name }}:
    <<: *backend
    {% if process.asgi %}
    {% if not ctx.image %}
    build:
      context: ./backend
      {% if ctx.packages %}
      additional_contexts:
        {% for package in ctx.packages %}
        {{ package.name }}: ./{{ package.bundle_path }}
        {% endfor %}
      {% endif %}
    {% endif %}
    ports:
      - "${BIND_ADDRESS:-0.0.0.0}:${APP_PORT:-{{ ctx.port }}}:{{ ctx.port }}"
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('localhost', {{ ctx.port }}), 2)"]
      interval: 10s
      timeout: 5s
      retries: 6
    {% else %}
    command: {{ process.command | tojson }}
    {% endif %}
    environment:
      {% for line in ctx.app_environment %}
      - {{ line }}
      {% endfor %}
      {% for key, value in process.env.items() %}
      - {{ key }}={{ value }}
      {% endfor %}

  {% endfor %}
  {% for ds in local_datastores %}
  {{ ds.service }}:
    image: {{ ds.image }}
    {% if ds.command %}
    command: {{ ds.command }}
    {% endif %}
    {% if ds.service_env %}
    environment:
      {% for key, value in ds.service_env.items() %}
      - {{ key }}={{ value }}
      {% endfor %}
    {% endif %}
    {% if ds.volume %}
    volumes:
      - {{ ds.volume }}:{{ ds.volume_path }}
    {% endif %}
    restart: unless-stopped
  {% endfor %}

  {% if ctx.frontend %}
  frontend:
    image: {{ ctx.frontend_image }}
    build:
      context: ./frontend
      additional_contexts:
        nginx: ./nginx
      {% if ctx.frontend.args %}
      args:
        {% for name in ctx.frontend.args %}
        {{ name }}: {{ '${%s:-}' | format(name) }}
        {% endfor %}
      {% endif %}
      {% if ctx.frontend.secrets %}
      secrets:
        {% for name in ctx.frontend.secrets %}
        - {{ name | lower }}
        {% endfor %}
      {% endif %}
    environment:
      - BACKEND_URL=http://{{ asgi.name }}:{{ ctx.port }}
      {% for name in ctx.frontend.env %}
      - {{ name }}={{ '${%s:-}' | format(name) }}
      {% endfor %}
    ports:
      - "${BIND_ADDRESS:-0.0.0.0}:${FRONTEND_PORT:-80}:80"
    depends_on:
      {{ asgi.name }}:
        condition: service_healthy
    restart: unless-stopped
  {% endif %}

  {% for svc_name, svc_config in ctx.extra_services %}
  {{ svc_name }}:
{{ svc_config | to_yaml | indent(4, first=True) }}
  {% endfor %}

{% if ctx.frontend and ctx.frontend.secrets %}
secrets:
  {% for name in ctx.frontend.secrets %}
  {{ name | lower }}:
    environment: {{ name }}
  {% endfor %}

{% endif %}
{% set extra_volumes = [] %}
{% for _, svc_config in ctx.extra_services %}
{% for vol in svc_config.get("volumes", []) %}
{% if ":" in vol and not vol.split(":")[0].startswith((".", "/")) %}
{% if extra_volumes.append(vol.split(":")[0]) %}{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% set datastore_volumes = (local_datastores | selectattr("volume") | map(attribute="volume") | list) + (ctx.app_volumes | map(attribute="name") | list) %}
{% if datastore_volumes or extra_volumes %}
volumes:
  {% for vol in datastore_volumes %}
  {{ vol }}:
  {% endfor %}
  {% for vol in extra_volumes %}
  {{ vol }}:
  {% endfor %}
{% endif %}
