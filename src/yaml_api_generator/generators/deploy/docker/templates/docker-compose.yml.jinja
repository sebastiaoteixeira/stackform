{% if ctx.include %}
include:
  {% for path in ctx.include %}
  - {{ path }}
  {% endfor %}

{% endif %}
services:
  app:
    {% if ctx.image %}
    image: {{ ctx.image }}
    {% else %}
    build: ./backend
    {% endif %}
    environment:
      - MONGO_URI=${MONGO_URI:-mongodb://mongodb:27017}
      - MONGO_DB=${MONGO_DB:-{{ ctx.mongo_db }}}
      - PORT=${PORT:-{{ ctx.port }}}
      - FRONTEND_URL=${FRONTEND_URL:-http://localhost}
    ports:
      - "${APP_PORT:-{{ ctx.port }}}:{{ ctx.port }}"
    env_file:
      - .env
    restart: unless-stopped
    {% if ctx.mongo_local %}
    depends_on:
      - mongodb
    {% endif %}

  {% if ctx.mongo_local %}
  mongodb:
    image: mongo:8
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped
  {% endif %}

  {% if ctx.has_frontend %}
  frontend:
    build:
      context: ./frontend
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-http://localhost:{{ ctx.port }}/api/v1}
    ports:
      - "${FRONTEND_PORT:-80}:80"
    depends_on:
      - app
    restart: unless-stopped
  {% endif %}

  {% for svc_name, svc_config in ctx.extra_services %}
  {{ svc_name }}:
{{ svc_config | to_yaml | indent(4, first=True) }}
  {% endfor %}

{% set extra_volumes = [] %}
{% for _, svc_config in ctx.extra_services %}
{% for vol in svc_config.get("volumes", []) %}
{% if ":" in vol and not vol.split(":")[0].startswith((".", "/")) %}
{% if extra_volumes.append(vol.split(":")[0]) %}{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ctx.mongo_local or extra_volumes %}
volumes:
  {% if ctx.mongo_local %}
  mongo_data:
  {% endif %}
  {% for vol in extra_volumes %}
  {{ vol }}:
  {% endfor %}
{% endif %}