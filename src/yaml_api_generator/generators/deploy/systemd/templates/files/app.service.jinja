[Unit]
Description={{ ctx.name }}
After=network.target

[Service]
User={{ ctx.user }}
WorkingDirectory=/opt/{{ ctx.name }}
ExecStart=/opt/{{ ctx.name }}/venv/bin/uvicorn app:app --host 0.0.0.0 --port {{ ctx.port }}
Restart={{ ctx.restart }}
EnvironmentFile=/opt/{{ ctx.name }}/.env

[Install]
WantedBy=multi-user.target