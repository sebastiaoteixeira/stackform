[Unit]
Description={{ ctx.name }}
After=network.target

[Service]
User={{ ctx.user }}
WorkingDirectory=/opt/{{ ctx.name }}
Environment=PORT={{ ctx.port }}
EnvironmentFile=/opt/{{ ctx.name }}/.env
ExecStart=/opt/{{ ctx.name }}/venv/bin/uvicorn {{ ctx.application }} --host 0.0.0.0 --port ${PORT}
Restart={{ ctx.restart }}

[Install]
WantedBy=multi-user.target