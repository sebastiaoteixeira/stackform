from pymongo import AsyncMongoClient

from settings import settings


_client: AsyncMongoClient | None = None
_db = None


def connect_db() -> None:
    global _client, _db
    _client = AsyncMongoClient(settings.MONGO_URI)
    _db = _client[settings.MONGO_DB]


async def close_db() -> None:
    global _client, _db
    if _client is not None:
        await _client.close()
        _client = None
        _db = None


def get_database():
    if _db is None:
        raise RuntimeError("Database not connected")
    return _db


async def initialize_indexes(unique_indexes: dict[str, list[str]]) -> None:
    db = get_database()
    for collection_name, fields in unique_indexes.items():
        for field_name in fields:
            await db[collection_name].create_index(
                field_name,
                unique=True,
                partialFilterExpression={field_name: {"$exists": True, "$ne": None}},
            )
