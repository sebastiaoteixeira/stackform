            raise NotFoundError("{{ collection_name }}", criteria)
        return document
{% else %}
    def list(self, primitives=None):
        if primitives is None:
            return self._repo.list()
        return self._repo.paginate(primitives)

    def get(self, resource_id: str) -> dict:
        document = self._repo.get(resource_id)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    def create(self, data: dict) -> dict:
{% if is_identity_collection %}
        self._validate_identity_fields(data)
{% endif %}
{% if default_role is not none %}
        data["_auth"] = {**data.get("_auth", {}), "roles": {{ default_role | py_literal }}}
{% endif %}
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        return self._repo.create(data)

    def update(self, resource_id: str, data: dict) -> dict:
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        document = self._repo.update(resource_id, data)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    def replace(self, resource_id: str, data: dict) -> dict:
{% if protects_credentials %}
