from {{ import_prefix }}.{{ collection_name }} import {{ collection_name | capitalize_collection }}Repository
from {{ service_import_prefix }}.exceptions import NotFoundError, ValidationError
{% set protects_credentials = password_via or api_key_via %}
{% if protects_credentials %}
from {{ auth_import_prefix }} import {{ ([password_via and "hash_password", api_key_via and "hash_api_key"] | select | join(", ")) }}
{% endif %}


class {{ collection_name | capitalize_collection }}Service:
{% if is_identity_collection %}
    IDENTITY_FIELDS = ({% for field_name in identity_fields %}"{{ field_name }}", {% endfor %})

{% endif %}
    def __init__(self, repo: {{ collection_name | capitalize_collection }}Repository):
        self._repo = repo

{% if is_async %}
    async def list(self, primitives=None):
        if primitives is None:
            return await self._repo.list()
        return await self._repo.paginate(primitives)

    async def get(self, resource_id: str) -> dict:
        document = await self._repo.get(resource_id)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    async def get_by(self, criteria: dict) -> dict:
        document = await self._repo.find_one(criteria)
        if document is None:
            raise NotFoundError("{{ collection_name }}", criteria)
        return document

    async def create(self, data: dict) -> dict:
{% if is_identity_collection %}
        self._validate_identity_fields(data)
{% endif %}
{% if default_role is not none %}
        data["_auth"] = {**data.get("_auth", {}), "roles": {{ default_role | py_literal }}}
{% endif %}
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        return await self._repo.create(data)

    async def update(self, resource_id: str, data: dict) -> dict:
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        document = await self._repo.update(resource_id, data)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    async def update_by(self, criteria: dict, data: dict) -> dict:
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        document = await self._repo.update_by(criteria, data)
        if document is None:
            raise NotFoundError("{{ collection_name }}", criteria)
        return document

    async def replace(self, resource_id: str, data: dict) -> dict:
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        document = await self._repo.replace(resource_id, data)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    async def replace_by(self, criteria: dict, data: dict) -> dict:
{% if protects_credentials %}
        self._protect_credentials(data)
{% endif %}
        document = await self._repo.replace_by(criteria, data)
        if document is None:
            raise NotFoundError("{{ collection_name }}", criteria)
        return document

    async def delete(self, resource_id: str) -> dict:
        document = await self._repo.delete(resource_id)
        if document is None:
            raise NotFoundError("{{ collection_name }}", resource_id)
        return document

    async def delete_by(self, criteria: dict) -> dict:
        document = await self._repo.delete_by(criteria)
