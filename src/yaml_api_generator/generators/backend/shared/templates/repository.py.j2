import uuid
from typing import Any

from bson import ObjectId
from bson.errors import InvalidId
from pymongo import ReturnDocument
from pymongo.database import AsyncDatabase

{% set class_name = collection_name | capitalize_collection %}
_SENSITIVE_FIELDS = {"password", "_auth"}


def _match_filter(document_id: str) -> dict[str, Any]:
    candidates: list[Any] = [document_id]
    try:
        candidates.append(ObjectId(document_id))
    except InvalidId:
        pass
    return {"$or": [{"_id": v} for v in candidates] + [{"{{ id_field }}": document_id}]}


class {{ class_name }}Repository:
    COLLECTION = "{{ collection_name }}"
    ID_FIELD = "{{ id_field }}"

    def __init__(self, db: AsyncDatabase) -> None:
        self._col = db[self.COLLECTION]
        self._db = db

    def _normalize(self, doc: dict[str, Any] | None) -> dict[str, Any] | None:
        if doc is None:
            return None
        result = dict(doc)
        if self.ID_FIELD not in result and result.get("_id") is not None:
            result[self.ID_FIELD] = str(result["_id"])
        if self.ID_FIELD != "_id":
            result.pop("_id", None)
        for key in _SENSITIVE_FIELDS:
            result.pop(key, None)
        return result

    async def list(self) -> list[dict[str, Any]]:
        cursor = self._col.find({})
        docs = await cursor.to_list(length=None)
        return [self._normalize(d) for d in docs]

    async def get(self, document_id: str) -> dict[str, Any] | None:
        doc = await self._col.find_one(_match_filter(document_id))
        return self._normalize(doc)

    async def create(self, data: dict[str, Any]) -> dict[str, Any]:
{% if id_field_format == "natural" %}
        pass  # natural key — no auto-generation
{% elif id_field_format == "uuidv4" %}
        data[self.ID_FIELD] = str(uuid.uuid4())
{% else %}
        data[self.ID_FIELD] = str(uuid.uuid7())
{% endif %}
        await self._col.insert_one(data)
        return self._normalize(data)

    async def update(
        self, document_id: str, data: dict[str, Any]
    ) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_update(
            _match_filter(document_id),
            {"$set": data},
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    async def replace(
        self, document_id: str, data: dict[str, Any]
    ) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_replace(
            _match_filter(document_id),
            data,
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    async def delete(self, document_id: str) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_delete(_match_filter(document_id))
        return self._normalize(doc)
