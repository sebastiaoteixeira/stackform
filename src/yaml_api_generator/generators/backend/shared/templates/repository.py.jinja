{% elif id_field_format == "uuidv4" %}
        data[self.ID_FIELD] = str(uuid.uuid4())
{% elif id_field_format == "uuidv7" %}
        data[self.ID_FIELD] = str(uuid7())
{% endif %}
        await self._col.insert_one(data)
        return self._normalize(data)

    @_translate_conflict
    async def update(
        self, document_id: str, data: dict[str, Any]
    ) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_update(
            self._match_filter(document_id),
            {"$set": data},
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    @_translate_conflict
    async def replace(
        self, document_id: str, data: dict[str, Any]
    ) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_replace(
            self._match_filter(document_id),
            data,
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    async def delete(self, document_id: str) -> dict[str, Any] | None:
        doc = await self._col.find_one_and_delete(self._match_filter(document_id))
        return self._normalize(doc)

    @_translate_conflict
    async def run_operation(self, query: dict[str, Any], bindings: dict[str, Any]) -> Any:
        return present(await run_mongo(self._col, resolve(query, bindings)), self.ID_FIELD)
