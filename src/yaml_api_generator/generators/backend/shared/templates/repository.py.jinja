_PAGINATION_COMPARATORS = {
    "gt": "$gt",
    "gte": "$gte",
    "lt": "$lt",
    "lte": "$lte",
}


def _pagination_filter(primitives: Primitives) -> dict[str, Any]:
    clauses: list[dict[str, Any]] = []
    for bound in primitives.bounds:
        disjuncts: list[dict[str, Any]] = []
        for equalities, key in expand_bound(bound):
            term = {field: value for field, value in equalities}
            term[key.field] = {_PAGINATION_COMPARATORS[key.op]: key.value}
            disjuncts.append(term)
        clauses.append(disjuncts[0] if len(disjuncts) == 1 else {"$or": disjuncts})
    return {"$and": clauses} if clauses else {}


def _duplicate_details(error: BulkWriteError | DuplicateKeyError) -> dict[str, Any] | None:
    details = error.details or {}
    if isinstance(error, DuplicateKeyError):
        return details
    return next(
        (
            write_error
            for write_error in details.get("writeErrors", [])
            if write_error.get("code") == 11000
        ),
        None,
    )


def _conflict_field(details: dict[str, Any]) -> str | None:
    for key in ("keyPattern", "keyValue"):
        fields = details.get(key)
        if fields:
            return next(iter(fields))
    return None


def _translate_conflict(operation):
    @wraps(operation)
    async def translated(*args, **kwargs):
        try:
            return await operation(*args, **kwargs)
        except (BulkWriteError, DuplicateKeyError) as error:
            details = _duplicate_details(error)
            if details is None:
                raise
            raise ConflictError(_conflict_field(details)) from error

    return translated

{% set class_name = collection_name | capitalize_collection %}

class {{ class_name }}Repository:
    COLLECTION = "{{ collection_name }}"
    ID_FIELD = "{{ id_field }}"

    def __init__(self, db: AsyncDatabase) -> None:
        self._col = db[self.COLLECTION]
        self._db = db

    def _match_filter(self, document_id: str) -> dict[str, Any]:
        return {self.ID_FIELD: document_id}

    def _normalize(self, doc: dict[str, Any] | None) -> dict[str, Any] | None:
        """Hide the datastore's own identifier; the service layer hides domain-internal fields."""
        if doc is None:
            return None
        return {k: v for k, v in doc.items() if k != "_id"}

    async def list(self) -> list[dict[str, Any]]:
        cursor = self._col.find({})
        docs = await cursor.to_list(length=None)
        return [self._normalize(d) for d in docs]

    async def paginate(self, primitives: Primitives) -> Page:
        query = _pagination_filter(primitives)
        cursor = self._col.find(query)
        if primitives.sort:
            cursor = cursor.sort(
                [(key.field, -1 if key.descending else 1) for key in primitives.sort]
            )
        if primitives.skip:
            cursor = cursor.skip(primitives.skip)
        if primitives.limit is not None:
            cursor = cursor.limit(primitives.limit)
        documents = await cursor.to_list(length=None)
        total = (
            await self._col.count_documents({})
            if primitives.count == "exact"
            else None
        )
        return Page([self._normalize(document) for document in documents], total)

    async def get(self, document_id: str) -> dict[str, Any] | None:
        doc = await self._col.find_one(self._match_filter(document_id))
        return self._normalize(doc)

    async def find_one(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        return self._normalize(await self._col.find_one(dict(criteria)))

    @_translate_conflict
    async def update_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        changes = {field: value for field, value in data.items() if field not in criteria}
        if not changes:
            return await self.find_one(criteria)
        doc = await self._col.find_one_and_update(
            dict(criteria), {"$set": changes}, return_document=ReturnDocument.AFTER
        )
        return self._normalize(doc)

    @_translate_conflict
    async def replace_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        replacement = {**data, **criteria}
        doc = await self._col.find_one_and_replace(
            dict(criteria), replacement, return_document=ReturnDocument.AFTER
        )
        return self._normalize(doc)

    async def delete_by(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        return self._normalize(await self._col.find_one_and_delete(dict(criteria)))

    @_translate_conflict
    async def create(self, data: dict[str, Any]) -> dict[str, Any]:
{% if id_field_format == "natural" %}
