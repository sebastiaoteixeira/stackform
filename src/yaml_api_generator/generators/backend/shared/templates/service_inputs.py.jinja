from types import SimpleNamespace
from typing import Any

from {{ fields_module }} import conform_inputs


class RawRequest:
    def __init__(
        self,
        path_params: dict[str, str],
        body: dict[str, Any] | None,
        headers: dict[str, str],
        principal: dict[str, Any] | None,
        service_inputs: dict[str, Any],
        query_params: dict[str, Any] | None = None,
        cookies: dict[str, str] | None = None,
    ) -> None:
        self.path_params = path_params
        self.body = body
        self.headers = headers
        self.query_params = query_params or {}
        self.cookies = cookies or {}
        self.state = SimpleNamespace(
            principal=principal,
            service_inputs=service_inputs,
        )

    async def json(self) -> dict[str, Any]:
        return self.body or {}


def prepare_service_inputs(
    path_values: dict[str, Any],
    body: dict[str, Any] | None,
    field_configs: dict[str, dict[str, Any]],
    forwarding: dict[str, dict[str, Any]],
    bound_inputs: dict[str, Any] | None = None,
) -> dict[str, Any]:
    values = conform_inputs(
        field_configs,
        {
            **(body if isinstance(body, dict) else {}),
            **path_values,
            **(bound_inputs or {}),
        },
    )
    return {
        name: _resolve(binding, values)
        for name, binding in forwarding.items()
    }


def resolve_access_bind(
    bindings: dict[str, dict[str, Any]],
    namespace: dict[str, Any],
) -> dict[str, Any]:
    return {name: _resolve(binding, namespace) for name, binding in bindings.items()}


def resolve_bindings(value: Any, bindings: dict[str, Any]) -> Any:
    if isinstance(value, str) and value.startswith("$"):
        return _resolve_path(value[1:].split("."), bindings)
    if isinstance(value, dict):
        return {key: resolve_bindings(item, bindings) for key, item in value.items()}
    if isinstance(value, list):
        return [resolve_bindings(item, bindings) for item in value]
    return value


def _resolve(binding: dict[str, Any], values: dict[str, Any]) -> Any:
    if "symbol" in binding:
        return _resolve_path(binding["symbol"], values)
    return binding.get("literal")


def _resolve_path(path: list[str], values: dict[str, Any]) -> Any:
    current: Any = values
    for segment in path:
        if not isinstance(current, dict) or segment not in current:
            return None
        current = current[segment]
    return current
