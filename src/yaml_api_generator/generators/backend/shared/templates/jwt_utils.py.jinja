{% if ctx.session.uses_asymmetric %}
import json
import time
from base64 import urlsafe_b64encode
from hashlib import sha256

import jwt
from cryptography.hazmat.primitives import serialization
from jwt.algorithms import RSAAlgorithm

from {{ settings_module }} import settings

ALGORITHM = "RS256"


def _public_jwk(key) -> dict:
    jwk = json.loads(RSAAlgorithm.to_jwk(key))
    canonical = json.dumps(
        {"e": jwk["e"], "kty": jwk["kty"], "n": jwk["n"]},
        separators=(",", ":"),
        sort_keys=True,
    )
    kid = urlsafe_b64encode(sha256(canonical.encode()).digest()).rstrip(b"=").decode()
    return {**jwk, "kid": kid, "use": "sig", "alg": ALGORITHM}


_PRIVATE_PEM = settings.JWT_PRIVATE_KEY.get_secret_value()
_SIGNING_JWK = _public_jwk(
    serialization.load_pem_private_key(_PRIVATE_PEM.encode(), password=None).public_key()
)
_RETIRED_JWKS = [
    _public_jwk(serialization.load_pem_public_key(pem.encode()))
    for pem in [settings.JWT_RETIRED_PUBLIC_KEY]
    if pem
]
_PUBLIC_JWKS = [_SIGNING_JWK, *_RETIRED_JWKS]
_VERIFICATION_KEYS = {jwk["kid"]: jwt.PyJWK.from_dict(jwk).key for jwk in _PUBLIC_JWKS}
_TOKEN_HEADERS = {"kid": _SIGNING_JWK["kid"]}


def public_jwks() -> dict:
    """The public half of every key whose tokens this app still accepts."""
    return {"keys": _PUBLIC_JWKS}


def _signing_key() -> str:
    return _PRIVATE_PEM


def _verification_key(token: str):
    key = _VERIFICATION_KEYS.get(jwt.get_unverified_header(token).get("kid"))
    if key is None:
        raise jwt.DecodeError("Token was not signed by a published key")
    return key
{% else %}
import time

import jwt

from {{ settings_module }} import settings

ALGORITHM = "HS256"
_TOKEN_HEADERS: dict = {}


def _signing_key() -> str:
    return settings.JWT_SECRET.get_secret_value()


def _verification_key(_token: str) -> str:
    return _signing_key()
{% endif %}


def create_jwt_token(sub: str, identity_collection: str) -> str:
    now = int(time.time())
    payload = {
        "sub": sub,
        "identity_collection": identity_collection,
        "iat": now,
        "exp": now + settings.JWT_EXPIRATION_HOURS * 3600,
    }
    return jwt.encode(
        payload, _signing_key(), algorithm=ALGORITHM, headers=_TOKEN_HEADERS
    )


def decode_jwt_token(token: str) -> dict | None:
    try:
        return jwt.decode(token, _verification_key(token), algorithms=[ALGORITHM])
    except jwt.InvalidTokenError:
        return None
