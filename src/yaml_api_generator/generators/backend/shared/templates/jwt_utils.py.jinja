import time

import jwt

from settings import settings


def create_jwt_token(sub: str, identity_collection: str) -> str:
    now = time.time()
    payload = {
        "sub": sub,
        "identity_collection": identity_collection,
        "iat": int(now),
        "exp": int(now + settings.JWT_EXPIRATION_HOURS * 3600),
    }
    return jwt.encode(payload, settings.JWT_SECRET.get_secret_value(), algorithm="HS256")


def decode_jwt_token(token: str) -> dict | None:
    try:
        return jwt.decode(token, settings.JWT_SECRET.get_secret_value(), algorithms=["HS256"])
    except (jwt.InvalidTokenError, Exception):
        return None
