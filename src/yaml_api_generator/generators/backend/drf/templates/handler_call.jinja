{# Runs the route's service operation, or the handler of a route without a service, over one HandlerRequest #}
{% macro run_operation(route) %}
            _request = HandlerRequest(
                params=path_params,
                query=dict(request.query_params),
                headers={key.lower(): value for key, value in request.headers.items()},
                cookies=dict(request.COOKIES),
                body=body,
                principal=_resolved_principal,
                inputs=service_inputs,
            )
{% if route.collection %}
            return Response(await service.{{ route.operation }}(_request))
{% else %}
            return Response(await invoke({{ route.handler | py_literal }}, _request))
{% endif %}
{% endmacro %}
