{% set creates_indexes = ctx.mongo_unique_indexes and not ctx.mongo_schema_managed %}
{% if creates_indexes or ctx.expiring_collections %}
import asyncio
{% endif %}
{% if ctx.expiring_collections %}
import threading
{% endif %}
{% if creates_indexes or ctx.expiring_collections %}

{% endif %}
from django.apps import AppConfig

from api.authentication.mongodb import {% if creates_indexes %}close_db, connect_db, initialize_indexes{% else %}connect_db{% endif %}



class ApiConfig(AppConfig):
    default_auto_field = "django.db.models.BigAutoField"
    name = "api"

    def ready(self):
{% if creates_indexes %}
        asyncio.run(self.create_indexes())
{% endif %}
        connect_db()
{% if ctx.expiring_collections %}
        threading.Thread(target=asyncio.run, args=(_expire_rows(),), daemon=True).start()
{% endif %}
{% if creates_indexes %}

    @staticmethod
    async def create_indexes():
        """Runs on a client of its own: an async client stays bound to the event loop it first ran on."""
        connect_db()
        await initialize_indexes({{ ctx.mongo_unique_indexes | tojson }})
        await close_db()
{% endif %}
{% if ctx.expiring_collections %}


async def _expire_rows() -> None:
    """Runs on its own thread and event loop, so it holds its own MongoDB client."""
    from pymongo import AsyncMongoClient

    from api.lifecycle import Purger
    from api.settings import settings
{% for name in ctx.expiring_collections %}
    from api.repositories.{{ name }} import {{ name | capitalize_collection }}Repository
{% endfor %}

    db = AsyncMongoClient(settings.MONGO_URI)[settings.MONGO_DB]
    repositories = [
{% for name in ctx.expiring_collections %}
        {{ name | capitalize_collection }}Repository(db),
{% endfor %}
    ]
    await Purger(repository.purge_expired for repository in repositories).run()
{% endif %}
