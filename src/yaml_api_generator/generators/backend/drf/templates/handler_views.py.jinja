from rest_framework import status
from rest_framework.response import Response
from adrf.views import APIView

from api.conflicts import ConflictError
from api.handler_requests import HandlerRequest, invoke, json_body
from api.service_inputs import prepare_service_inputs, resolve_access_bind
{% set ns_where = namespace(collections=[]) %}
{% for route in routes %}{% for where_collection in route.where_collections %}
{% if where_collection not in ns_where.collections %}{% set _ = ns_where.collections.append(where_collection) %}{% endif %}
{% endfor %}{% endfor %}
{% for where_collection in ns_where.collections %}
from api.repositories.{{ where_collection }} import {{ where_collection | capitalize_collection }}Repository
{% endfor %}
{% if routes | selectattr("needs_auth") | list %}
from api.access import AccessDenied, Decision, all_of, conjoin, constant, decide, disjoin, equals, has_path, is_null, negate, one_of, value_at
from api.authentication.auth import _principal_has_role, resolve_principal
from api.authentication.mongodb import get_database
{% endif %}


{% for path, path_routes in routes | groupby("relative_path") %}
class {{ path_routes[0].view_name }}(APIView):
{% for route in path_routes %}

    async def {{ route.method | lower }}(self, request, **path_params):
{% if route.needs_auth %}
        _resolved_principal = await resolve_principal(request.headers, get_database())
{% if not route.admits_anonymous %}
        if _resolved_principal is None:
            return Response(
                {"detail": "Unauthorized"},
                status=status.HTTP_401_UNAUTHORIZED,
            )
{% endif %}
{% else %}
        _resolved_principal = None
{% endif %}
        body = json_body(request.body) or {}
{% if route.access_rules %}
        _request_body = body
        _request_path = path_params
        _request_query = dict(request.query_params)
        _request_header = dict(request.headers)
        _request_cookie = dict(request.COOKIES)
{% set ns_symbols = namespace(identity=[], request=[]) %}
{% for rule in route.access_rules %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in ns_symbols.identity %}{% set _ = ns_symbols.identity.append(symbol) %}{% endif %}
{% endfor %}
{% for symbol in rule.request_symbols %}
{% if symbol.name not in (ns_symbols.request | map(attribute="name") | list) %}{% set _ = ns_symbols.request.append(symbol) %}{% endif %}
{% endfor %}
{% endfor %}
{% for symbol in ns_symbols.identity %}
        {{ symbol }} = _resolved_principal
{% endfor %}
{% for symbol in ns_symbols.request %}
        {{ symbol | request_symbol_binding }}
{% endfor %}
        decisions = []
{% for rule in route.access_rules %}
{% for binding in rule.document_bindings %}
        {{ binding.name }} = await {{ binding.collection | capitalize_collection }}Repository(get_database()).find_one(
            resolve_access_bind({{ binding.where | py_literal }}, {**path_params, **locals()})
        )
{% endfor %}
        decisions.append(Decision({{ rule.effect | py_literal }}, {{ rule | rule_to_predicate }}, {{ rule.reason | py_literal }}))
{% endfor %}
        try:
            access_bindings = {{ route.access_rules | map(attribute="bind") | list | py_literal }}[decide(decisions)]
        except AccessDenied as exc:
            code, detail = exc.refusal(_resolved_principal)
            return Response({"detail": detail}, status=code)
        bound_inputs = resolve_access_bind(access_bindings, locals())
{% else %}
        bound_inputs = {}
{% endif %}
        try:
            service_inputs = prepare_service_inputs(
                path_params,
                body,
                {{ route.service_input | py_literal }},
                {{ route.service_forwarding | py_literal }},
                bound_inputs,
            )
{{ run_operation(route) }}
        except ConflictError as exc:
            return Response({"detail": str(exc)}, status=status.HTTP_409_CONFLICT)
        except ValueError as exc:
            return Response({"detail": str(exc)}, status=status.HTTP_422_UNPROCESSABLE_ENTITY)
{% endfor %}


{% endfor %}
