def hash_password(password: str, rounds: int = settings.PASSWORD_HASH_ROUNDS) -> str:
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, rounds)
    salt_b64 = base64.urlsafe_b64encode(salt).decode("ascii")
    hash_b64 = base64.urlsafe_b64encode(digest).decode("ascii")
    return f"pbkdf2$sha256${rounds}${salt_b64}${hash_b64}"


def verify_password(password: str, encoded_hash: str) -> bool:
    parts = encoded_hash.split("$")
    if len(parts) != 5:
        return False
    algorithm, digest_name, rounds_text, salt_b64, hash_b64 = parts
    if algorithm != "pbkdf2" or digest_name != "sha256":
        return False
    try:
        rounds = int(rounds_text)
        salt = base64.urlsafe_b64decode(salt_b64.encode("ascii"))
        expected = base64.urlsafe_b64decode(hash_b64.encode("ascii"))
    except (ValueError, Exception):
        return False
    computed = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, rounds)
    return hmac.compare_digest(computed, expected)


def _extract_api_key(headers: dict[str, str]) -> str | None:
    api_key = headers.get("x-api-key")
    if api_key:
        token = api_key.strip()
        if token:
            return token
    authorization = headers.get("authorization", "")
    if authorization.startswith("Bearer "):
        token = authorization.removeprefix("Bearer ").strip()
        if token:
            return token
    return None


def _extract_basic_credentials(headers: dict[str, str]) -> tuple[str, str] | None:
    authorization = headers.get("authorization", "")
    if not authorization.startswith("Basic "):
        return None
    encoded = authorization.removeprefix("Basic ").strip()
    try:
        decoded = base64.b64decode(encoded).decode("utf-8")
    except Exception:
        return None
    if ":" not in decoded:
        return None
    username, password = decoded.split(":", 1)
    if not username or not password:
        return None
    return username, password


def _extract_bearer_token(headers: dict[str, str]) -> str | None:
    authorization = headers.get("authorization", "")
    if authorization.startswith("Bearer "):
        token = authorization.removeprefix("Bearer ").strip()
        if token:
            return token
    return None


ROLE_HIERARCHIES: dict[str, dict[str, set[str]]] = {{ auth.role_hierarchies | role_hierarchies_py }}


def _principal_has_role(principal: dict | None, required_role: str) -> bool:
    if principal is None:
        return False
    principal_roles = principal.get("roles", [])
    if required_role in principal_roles:
        return True
    entity_hierarchy = ROLE_HIERARCHIES.get(principal.get("identity_collection", ""), {})
    return any(required_role in entity_hierarchy.get(role, set()) for role in principal_roles)


def resolve_principal(request: Request, db) -> dict[str, Any] | None:
    headers = {k.lower(): v for k, v in request.META.items() if k.startswith("HTTP_")}
    raw_headers: dict[str, str] = {}
    for meta_key, value in headers.items():
        header_name = meta_key[5:].replace("_", "-").lower()
        raw_headers[header_name] = value

{% if auth.uses_jwt %}
    bearer_token = _extract_bearer_token(raw_headers)
    if bearer_token is not None:
        claims = decode_jwt_token(bearer_token)
        if claims is not None:
            sub = claims.get("sub")
            collection_name = claims.get("identity_collection")
            if sub and collection_name:
                col = db[collection_name]
                for doc in col.find({}):
{% for identity in auth.identity_collections %}
{% if identity.issues_jwt %}
                    if collection_name == "{{ identity.name }}" and str(doc.get("{{ identity.id_field }}", "")) == sub:
                        return {"sub": sub, "identity_collection": collection_name, "record": doc, "roles": {{ identity.role_store | py_literal }}.of(doc)}
{% endif %}
{% endfor %}
{% endif %}

{% for identity in auth.identity_collections %}

    # {{ identity.name }} identity resolution
{% if identity.has_api_key %}
    token = _extract_api_key(raw_headers)
    if token is not None:
        col = db["{{ identity.name }}"]
        for doc in col.find({}):
            if str(doc.get("apiKey", "")) == token:
                subject = doc.get("{{ identity.id_field }}")
                if subject is not None:
                    return {"sub": str(subject), "identity_collection": "{{ identity.name }}", "record": doc, "roles": {{ identity.role_store | py_literal }}.of(doc)}
{% endif %}
{% if identity.has_password and identity.identifier %}
    credentials = _extract_basic_credentials(raw_headers)
    if credentials is not None:
        identifier_value, password = credentials
        col = db["{{ identity.name }}"]
        for doc in col.find({}):
            if str(doc.get("{{ identity.identifier }}", "")) != identifier_value:
                continue
            stored_hash = doc["_auth"]["passwordHash"]
            if not isinstance(stored_hash, str):
                continue
            if not verify_password(password, stored_hash):
                continue
            subject = doc.get("{{ identity.id_field }}")
            if subject is not None:
                return {"sub": str(subject), "identity_collection": "{{ identity.name }}", "record": doc, "roles": {{ identity.role_store | py_literal }}.of(doc)}
{% endif %}
{% endfor %}

    return None


class MongoDBAuthentication(BaseAuthentication):
    def authenticate(self, request):
        db = get_database()
        principal = resolve_principal(request, db)
        if principal is None:
            return None
        return (principal, None)
