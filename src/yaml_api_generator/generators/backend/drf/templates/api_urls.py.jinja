from django.urls import path

{% set served = routes | rejectattr("operation", "equalto", "login") | list %}
{% set handler_routes = served | rejectattr("collection") | list %}
{% if handler_routes %}
from api.views._handlers import {{ handler_routes | map(attribute="view_name") | unique | join(", ") }}
{% endif %}
{% for col_name in served | selectattr("collection") | map(attribute="collection") | unique %}
from api.views.{{ col_name }} import {{ served | selectattr("collection", "equalto", col_name) | map(attribute="view_name") | unique | join(", ") }}
{% endfor %}
{% if auth and auth.has_password_auth %}
{% for identity in auth.identity_collections %}
{% if identity.has_password and identity.identifier %}
from api.views.login import {{ identity.name | capitalize_collection }}LoginView
{% endif %}
{% endfor %}
{% endif %}

urlpatterns = [
{% if auth and auth.has_password_auth %}
{% for identity in auth.identity_collections %}
{% if identity.has_password and identity.identifier %}
    path("{{ identity.name }}/login", {{ identity.name | capitalize_collection }}LoginView.as_view(), name="{{ identity.name }}-login"),
{% endif %}
{% endfor %}
{% endif %}
{% for view_name in served | map(attribute="view_name") | unique %}
{% set route = served | selectattr("view_name", "equalto", view_name) | first %}
    path("{{ route.django_path }}", {{ view_name }}.as_view(), name="{{ view_name }}"),
{% endfor %}
]
