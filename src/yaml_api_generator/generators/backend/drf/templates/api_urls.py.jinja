from django.urls import path

{% set handler_routes = routes | selectattr("handler") | rejectattr("collection") | list %}
{% if handler_routes %}
from api.views._handlers import {% for route in handler_routes %}Handler{{ route.operation | capitalize_collection }}{{ loop.index }}View{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}

{% set crud_op_names = ["list", "get", "create", "update", "replace", "delete"] %}
{% for col_name in collections %}
{% set collection_routes = routes | selectattr("collection", "equalto", col_name) | selectattr("operation", "in", crud_op_names) | list %}
{% set custom_routes = routes | selectattr("collection", "equalto", col_name) | rejectattr("operation", "in", crud_op_names) | rejectattr("operation", "equalto", "login") | list %}
{% set crud_views = collection_routes | map(attribute="view_name") | unique | list %}
{% if crud_views %}
from api.views.{{ col_name }} import {{ crud_views | join(", ") }}
{% endif %}
{% for route in custom_routes %}
from api.views.{{ col_name }} import {{ col_name | capitalize_collection }}{{ route.operation | capitalize_collection }}View
{% endfor %}

{% endfor %}
{% if auth %}
{% for identity in auth.login_identities %}
from api.views.login import {{ identity.name | capitalize_collection }}LoginView

{% endfor %}
{% endif %}

urlpatterns = [
{% for route in handler_routes %}
    path("{{ route.django_path }}", Handler{{ route.operation | capitalize_collection }}{{ loop.index }}View.as_view(), name="handler-{{ route.operation }}-{{ loop.index }}"),
{% endfor %}
{% if auth %}
{% for identity in auth.login_identities %}
    path("{{ identity.name }}/login", {{ identity.name | capitalize_collection }}LoginView.as_view(), name="{{ identity.name }}-login"),
{% endfor %}
{% endif %}
{% set seen_paths = [] %}
{% for route in routes | sort(attribute="has_id_param") if route.collection and route.operation in crud_op_names %}
{% if route.django_path not in seen_paths %}
{% set _ = seen_paths.append(route.django_path) %}
    path("{{ route.django_path }}", {{ route.view_name }}.as_view(), name="{{ route.collection }}-{{ route.operation }}"),
{% endif %}
{% endfor %}
{% for route in routes if route.collection and route.operation not in crud_op_names and route.operation != "login" %}
    path("{{ route.django_path }}", {{ route.collection | capitalize_collection }}{{ route.operation | capitalize_collection }}View.as_view(), name="{{ route.collection }}-{{ route.operation }}"),
{% endfor %}
]
