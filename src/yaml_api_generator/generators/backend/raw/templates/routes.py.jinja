{% macro record_criteria(route) %}{{ "{" }}{% for field, param in route.record_criteria %}"{{ field }}": url_params["{{ param }}"]{% if not loop.last %}, {% endif %}{% endfor %}{{ "}" }}{% endmacro %}
{% macro authorize_bind(route) %}
{% if route.access_rules %}
    _request_body = body or {}
    _request_path = url_params
    _request_query = query or {}
    _request_header = headers
    _request_cookie = cookies or {}
{% set symbols = namespace(identity=[], request=[]) %}
{% for rule in route.access_rules %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in symbols.identity %}{% set _ = symbols.identity.append(symbol) %}{% endif %}
{% endfor %}
{% for symbol in rule.request_symbols %}
{% if symbol.name not in (symbols.request | map(attribute="name") | list) %}{% set _ = symbols.request.append(symbol) %}{% endif %}
{% endfor %}
{% endfor %}
{% for symbol in symbols.identity %}
    {{ symbol }} = principal
{% endfor %}
{% for symbol in symbols.request %}
    {{ symbol | request_symbol_binding }}
{% endfor %}
    access_bindings = {}
{% set document = namespace(required=false) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}{% set document.required = true %}{% endif %}
{% endfor %}
{% if not document.required %}
{% set ns = namespace(first=true, terminal=false, conditional=false) %}
{% for rule in route.access_rules %}
{% if not ns.terminal %}
{% if rule is unconditional %}
{% if rule.effect == "deny" %}
    return 403, {"detail": {{ (rule.reason or "Forbidden") | py_literal }}}
{% else %}
    access_bindings = {{ rule.bind | py_literal }}
{% endif %}
{% set ns.terminal = true %}
{% else %}
{% set keyword = "if" if ns.first else "elif" %}
    {{ keyword }} {{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
        return 403, {"detail": {{ (rule.reason or "Forbidden") | py_literal }}}
{% else %}
        access_bindings = {{ rule.bind | py_literal }}
{% endif %}
{% set ns.first = false %}
{% set ns.conditional = true %}
{% endif %}
{% endif %}
{% endfor %}
{% if ns.conditional and not ns.terminal %}
    else:
        return 403, {"detail": "Forbidden"}
{% endif %}
{% endif %}
    bound_inputs = resolve_access_bind(access_bindings, locals())
{% else %}
    bound_inputs = {}
{% endif %}
{% endmacro %}
{% macro post_fetch_authorize(route, doc_var) %}
{% if route.needs_auth and route.access_rules %}
{% set document = namespace(required=false, symbols=[]) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}{% set document.required = true %}{% endif %}
{% for symbol in rule.document_symbols %}
{% if symbol not in document.symbols %}{% set _ = document.symbols.append(symbol) %}{% endif %}
{% endfor %}
{% endfor %}
{% if document.required %}
{% for symbol in document.symbols %}
        {{ symbol }} = {{ doc_var }}
{% endfor %}
{% set ns = namespace(first=true) %}
{% for rule in route.access_rules %}
{% set keyword = "if" if ns.first else "elif" %}
        {{ keyword }} {% if rule is needs_document_rule %}{{ doc_var }} is not None and {% endif %}{{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
            return 403, {"detail": {{ (rule.reason or "Forbidden") | py_literal }}}
{% else %}
            pass
{% endif %}
{% set ns.first = false %}
{% endfor %}
{% if not ns.first %}
        else:
            return 403, {"detail": "Forbidden"}
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}
{% for route in routes %}
{% if route.operation != "login" %}
{% set handler_name = "handle_" ~ route.operation ~ "_" ~ collection_name %}
async def {{ handler_name }}(url_params: dict, body: dict | None, headers: dict[str, str], db: Any, query: dict[str, Any] | None = None, cookies: dict[str, str] | None = None) -> tuple[int, Any]:
    repo = {{ collection_name | capitalize_collection }}Repository(db)
    service = {{ collection_name | capitalize_collection }}Service(repo)
    principal = None
{% if route.needs_auth %}
    principal = await resolve_principal(headers, db)
    if principal is None:
        return 401, {"detail": "Unauthorized"}
{% endif %}
{{ authorize_bind(route) }}
    service_inputs = prepare_service_inputs(url_params, body, {{ route.service_input | py_literal }}, {{ route.service_forwarding | py_literal }}, bound_inputs)
    params = {**url_params, **service_inputs}
{% if route.handler %}
    from importlib import import_module
    module_path, function_name = "{{ route.handler }}".rsplit(".", 1)
    request = RawRequest(
        url_params,
        body,
        headers,
        principal,
        service_inputs,
        query,
        cookies,
    )
    result = await getattr(import_module(module_path), function_name)(request)
    return 200, result
{% elif route.operation not in crud_op_names %}
{% set query = repo_queries[route.operation] %}
    bindings = {**params, "params": params, "body": body or {}}
    resolved = resolve_bindings({{ query | py_literal }}, bindings)
    result = await repo.{{ route.operation }}(**{key: value for key, value in resolved.items() if key not in ("command", "collection")})
    return 200, result
{% else %}
    try:
{% if route.operation == "list" %}
        documents = await service.list()
        return 200, documents
{% elif route.operation == "get" %}
{% if route.record_parent_params %}
        document = await service.get_by({{ record_criteria(route) }})
{% else %}
        document = await service.get(url_params["{{ route.record_id_param }}"])
{% endif %}
{{ post_fetch_authorize(route, "document") }}
