from typing import Any

from repositories.{{ collection_name }} import {{ collection_name | capitalize_collection }}Repository
from services.{{ collection_name }} import {{ collection_name | capitalize_collection }}Service
from services.exceptions import NotFoundError, ValidationError
{% if needs_auth %}
from dependencies.auth import resolve_principal
{% endif %}
import validation


{% for route in routes %}
{% if route.operation != "login" %}
{% set handler_name = "handle_" ~ route.operation ~ "_" ~ collection_name %}
async def {{ handler_name }}(url_params: dict, body: dict | None, headers: dict[str, str], db: Any) -> tuple[int, Any]:
    repo = {{ collection_name | capitalize_collection }}Repository(db)
    service = {{ collection_name | capitalize_collection }}Service(repo)
{% if route.needs_auth %}
    principal = await resolve_principal(headers, db)
    if principal is None:
        return 401, {"detail": "Unauthorized"}
{% endif %}
    try:
{% if route.operation == "list" %}
        documents = await service.list()
        return 200, documents
{% elif route.operation == "get" %}
        document = await service.get(url_params["id"])
        return 200, document
{% elif route.operation == "create" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ collection_name }}_create(body)
        document = await service.create(data)
        return 200, document
{% elif route.operation == "update" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ collection_name }}_update(body)
        document = await service.update(url_params["id"], data)
        return 200, document
{% elif route.operation == "replace" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.validate_{{ collection_name }}_replace(body)
        document = await service.replace(url_params["id"], data)
        return 200, document
{% elif route.operation == "delete" %}
        document = await service.delete(url_params["id"])
        return 200, document
{% endif %}
    except NotFoundError:
        return 404, {"detail": "Resource not found"}
    except ValidationError as exc:
        return 422, {"detail": exc.message}

{% endif %}
{% endfor %}
