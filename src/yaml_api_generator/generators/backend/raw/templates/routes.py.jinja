import validation


try:
    from bson import ObjectId
    _IDISH = (UUID, ObjectId)
except ImportError:
    _IDISH = (UUID,)


def _values_equal(left: Any, right: Any) -> bool:
    if left is None or right is None:
        return left is None and right is None
    if isinstance(left, bool) or isinstance(right, bool):
        return isinstance(left, bool) and isinstance(right, bool) and left is right
    if left == right:
        return True
    return str(left) == str(right) if isinstance(left, _IDISH) or isinstance(right, _IDISH) else False


ROLE_HIERARCHIES = {{ auth.role_hierarchies | role_hierarchies_py }}


def _principal_has_role(principal: dict, required_role: str) -> bool:
    roles = principal.get("roles", [])
    if required_role in roles:
        return True
    hierarchy = ROLE_HIERARCHIES.get(principal.get("identity_collection", ""), {})
    return any(required_role in hierarchy.get(role, set()) for role in roles)


{% macro record_criteria(route) %}{{ "{" }}{% for field, param in route.record_criteria %}"{{ field }}": url_params["{{ param }}"]{% if not loop.last %}, {% endif %}{% endfor %}{{ "}" }}{% endmacro %}
{% macro authorization_locals(route) %}
{% if route.access_rules %}
    _request_body = body or {}
    _request_path = url_params
    _request_query = query or {}
    _request_header = headers
    _request_cookie = cookies or {}
{% set symbols = namespace(identity=[], request=[]) %}
{% for rule in route.access_rules %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in symbols.identity %}{% set _ = symbols.identity.append(symbol) %}{% endif %}
{% endfor %}
{% for symbol in rule.request_symbols %}
{% if symbol.name not in (symbols.request | map(attribute="name") | list) %}{% set _ = symbols.request.append(symbol) %}{% endif %}
{% endfor %}
{% endfor %}
{% for symbol in symbols.identity %}
    {{ symbol }} = principal
{% endfor %}
{% for symbol in symbols.request %}
    {{ symbol | request_symbol_binding }}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro authorize_rules(route, current_document) %}
{% if route.needs_auth and route.access_rules %}
{{ authorization_locals(route) }}
    access_granted = False
    access_bindings = {}
{% for rule in route.access_rules %}
    if not access_granted:
{% for binding in rule.document_bindings %}
{% if binding.uses_where %}
        {{ binding.name }} = await {{ binding.collection | capitalize_collection }}Repository(db).find_one(
            resolve_access_bind({{ binding.where | py_literal }}, {**url_params, **locals()})
        )
{% else %}
        {{ binding.name }} = {{ current_document }}
{% endif %}
{% endfor %}
{% if rule is needs_current_document_rule %}
        document = {{ current_document }}
{% endif %}
        if {% for binding in rule.document_bindings if binding.uses_where %}{{ binding.name }} is not None and {% endfor %}{% if rule is needs_current_document_rule %}{{ current_document }} is not None and {% endif %}{{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
            return 403, {"detail": {{ (rule.reason or "Forbidden") | py_literal }}}
{% else %}
            access_granted = True
            access_bindings = {{ rule.bind | py_literal }}
{% endif %}
{% endfor %}
    if not access_granted:
        return 403, {"detail": "Forbidden"}
{% endif %}
{% endmacro %}

{% macro pre_fetch_authorize(route) %}
{% if not (route is needs_post_fetch) %}
{{ authorize_rules(route, "None") }}
{% elif route.access_rules %}
    access_bindings = {}
{% endif %}
{% endmacro %}

{% macro bind_inputs(route) %}
{% if route.access_rules %}
    bound_inputs = resolve_access_bind(access_bindings, locals())
{% else %}
    bound_inputs = {}
{% endif %}
{% endmacro %}

{% macro post_fetch_authorize(route, doc_var) %}
{% if route is needs_post_fetch %}
{{ authorize_rules(route, doc_var) }}
{% endif %}
{% endmacro %}
{% for route in routes %}
{% if route.operation != "login" %}
async def {{ route.handler_name }}(url_params: dict, body: dict | None, headers: dict[str, str], db: Any, query: dict[str, Any] | None = None, cookies: dict[str, str] | None = None) -> tuple[int, Any]:
    repo = {{ collection_name | capitalize_collection }}Repository(db)
    service = {{ collection_name | capitalize_collection }}Service(repo)
    principal = None
{% if route.needs_auth %}
    principal = await resolve_principal(headers, db)
    if principal is None:
        return 401, {"detail": "Unauthorized"}
{% endif %}
{{ pre_fetch_authorize(route) }}
{{ bind_inputs(route) }}
    service_inputs = prepare_service_inputs(url_params, body, {{ route.service_input | py_literal }}, {{ route.service_forwarding | py_literal }}, bound_inputs)
{% if route.runs_operation %}
{{ run_operation(route) }}
{% else %}
    try:
{% if route.operation == "list" %}
{% if route.pagination %}
        pagination_config = {{ route.pagination | pagination_config | py_literal }}
        pagination_query = query or {}
        page = await service.list(map_request(pagination_config, pagination_query))
        return 200, build_response(pagination_config, page, pagination_query)
{% else %}
        documents = await service.list()
        return 200, documents
{% endif %}
{% elif route.operation == "get" %}
{% if route.record_parent_params %}
        document = await service.get_by({{ record_criteria(route) }})
{% else %}
        document = await service.get(url_params["{{ route.record_id_param }}"])
{% endif %}
{{ post_fetch_authorize(route, "document") | indent(4, true) }}
        return 200, document
{% elif route.operation == "create" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.{{ route.typed_body_model or route.body_model }}.conform(body)
        document = await service.create(data)
        return 200, document
{% elif route.operation == "update" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.{{ route.typed_body_model or route.body_model }}.conform(body)
{% if route is needs_post_fetch %}
{% if route.record_parent_params %}
        existing = await service.get_by({{ record_criteria(route) }})
{% else %}
        existing = await service.get(url_params["{{ route.record_id_param }}"])
{% endif %}
{{ post_fetch_authorize(route, "existing") | indent(4, true) }}
{% endif %}
{% if route.record_parent_params %}
        document = await service.update_by({{ record_criteria(route) }}, data)
{% else %}
        document = await service.update(url_params["{{ route.record_id_param }}"], data)
{% endif %}
        return 200, document
{% elif route.operation == "replace" %}
        if body is None:
            return 422, {"detail": "Request body is required"}
        data = validation.{{ route.typed_body_model or route.body_model }}.conform(body)
{% if route is needs_post_fetch %}
{% if route.record_parent_params %}
        existing = await service.get_by({{ record_criteria(route) }})
{% else %}
        existing = await service.get(url_params["{{ route.record_id_param }}"])
{% endif %}
{{ post_fetch_authorize(route, "existing") | indent(4, true) }}
{% endif %}
{% if route.record_parent_params %}
        document = await service.replace_by({{ record_criteria(route) }}, data)
{% else %}
        document = await service.replace(url_params["{{ route.record_id_param }}"], data)
{% endif %}
        return 200, document
{% elif route.operation == "delete" %}
{% if route is needs_post_fetch %}
{% if route.record_parent_params %}
        existing = await service.get_by({{ record_criteria(route) }})
{% else %}
        existing = await service.get(url_params["{{ route.record_id_param }}"])
{% endif %}
{{ post_fetch_authorize(route, "existing") | indent(4, true) }}
{% endif %}
{% if route.record_parent_params %}
        document = await service.delete_by({{ record_criteria(route) }})
{% else %}
        document = await service.delete(url_params["{{ route.record_id_param }}"])
{% endif %}
        return 200, document
{% endif %}
    except NotFoundError:
        return 404, {"detail": "Resource not found"}
    except ValidationError as exc:
        return 422, {"detail": exc.message}
{% endif %}

{% endif %}
