import json
import re
from http.cookies import SimpleCookie
from typing import Any
from urllib.parse import parse_qs

from conflicts import ConflictError
from settings import settings

{% set create_mongo_indexes = ctx.mongo_unique_indexes and not ctx.mongo_schema_managed %}
from dependencies.mongodb import connect_db, close_db, get_database{% if create_mongo_indexes %}, initialize_indexes{% endif %}

{% set collections = routes | map(attribute='collection') | unique | select | list %}
{% for col_name in collections %}
from routes.{{ col_name }} import *
{% endfor %}
{% set handler_routes = routes | selectattr("handler") | rejectattr("collection") | list %}
{% if handler_routes %}
from routes.handlers import *
{% endif %}
{% if ctx.auth.login_identities %}
from routes.login import *
{% endif %}
{% if ctx.session.uses_asymmetric %}
from routes.jwks import handle_jwks
{% endif %}


_INVALID_JSON: Any = object()
_PREFIX = "{{ ctx.app.base_path }}{% if ctx.app.api_version %}/{{ ctx.app.api_version }}{% endif %}"


def _path_to_regex(path: str) -> str:
    """Convert /{collection}/{id} style path to regex with named groups."""
    def _replace(m: re.Match) -> str:
        return f"(?P<{m.group(1)}>[^/]+)"
    return re.sub(r"\{(\w+)\}", _replace, path)


# Each route: path pattern, handler, and whether its body is a record that must be JSON
ROUTES: dict[str, list[tuple[re.Pattern[str], Any, bool]]] = {}
{% for route in routes if route.operation != "login" %}
ROUTES.setdefault("{{ route.method }}", []).append((re.compile(r"^" + _PREFIX + r"{{ route.relative_path | path_to_regex }}$"), {{ route.handler_name }}, {{ (route.body_model is not none) | py_literal }}))
{% endfor %}
{% for identity in ctx.auth.login_identities %}
ROUTES.setdefault("POST", []).append((re.compile(r"^" + _PREFIX + r"{{ identity.login_path | path_to_regex }}$"), handle_login_{{ identity.name }}, True))
{% endfor %}
{% if ctx.session.uses_asymmetric %}
ROUTES.setdefault("GET", []).append((re.compile(r"^/\.well-known/jwks\.json$"), handle_jwks, False))
{% endif %}


class ASGIApp:
    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] == "lifespan":
            await self._handle_lifespan(scope, receive, send)
            return
        if scope["type"] == "http":
            await self._handle_http(scope, receive, send)
            return

    async def _handle_lifespan(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        while True:
            message = await receive()
            if message["type"] == "lifespan.startup":
                connect_db()
{% if create_mongo_indexes %}
                await initialize_indexes({{ ctx.mongo_unique_indexes | tojson }})
{% endif %}
                await send({"type": "lifespan.startup.complete"})
            elif message["type"] == "lifespan.shutdown":
                await close_db()
                await send({"type": "lifespan.shutdown.complete"})
                return

    async def _handle_http(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        method = scope["method"].upper()
        path = scope["path"]

        handler, url_params, record_body = self._match_route(method, path)
        if handler is None:
            await self._send_json(send, 404, {"detail": "Not found"})
            return

        body = await self._read_body(receive)
        if body is _INVALID_JSON:
            if record_body:
                await self._send_json(send, 400, {"detail": "Invalid JSON body"})
                return
            body = None

        headers = {
            k.decode("latin-1"): v.decode("latin-1")
            for k, v in scope.get("headers", [])
        }
        parsed_query = parse_qs(scope.get("query_string", b"").decode("utf-8"), keep_blank_values=True)
        query = {
            key: values[0] if len(values) == 1 else values
            for key, values in parsed_query.items()
        }
        cookie_jar = SimpleCookie()
        cookie_jar.load(headers.get("cookie", ""))
        cookies = {key: morsel.value for key, morsel in cookie_jar.items()}

        db = get_database()

        try:
            status, data = await handler(
                url_params, body, headers, db, query=query, cookies=cookies
            )
        except ConflictError as exc:
            await self._send_json(send, 409, {"detail": str(exc)})
            return
        except ValueError as exc:
            await self._send_json(send, 422, {"detail": str(exc)})
            return

        await self._send_json(send, status, data)

    @staticmethod
    def _match_route(method: str, path: str) -> tuple[Any, dict[str, str], bool]:
        entries = ROUTES.get(method, [])
        for pattern, handler, record_body in entries:
            match = pattern.match(path)
            if match:
                return handler, match.groupdict(), record_body
        return None, {}, False

    @staticmethod
    async def _read_body(receive: Any) -> dict[str, Any] | None:
        body = b""
        while True:
            message = await receive()
            body += message.get("body", b"")
            if not message.get("more_body", False):
                break
        if not body:
            return None
        try:
            return json.loads(body)
        except (json.JSONDecodeError, UnicodeDecodeError):
            return _INVALID_JSON

    @staticmethod
    async def _send_json(send: Any, status: int, data: Any) -> None:
        body = json.dumps(data, default=str).encode("utf-8")
        await send({
            "type": "http.response.start",
            "status": status,
            "headers": [
                [b"content-type", b"application/json"],
                [b"content-length", str(len(body)).encode("latin-1")],
            ],
        })
        await send({"type": "http.response.body", "body": body})


app = ASGIApp()
