import json
import os
import re
from typing import Any

from dependencies.mongodb import connect_db, close_db, get_database
{% set collections = routes | map(attribute='collection') | unique | select | list %}
{% for col_name in collections %}
from routes.{{ col_name }} import *
{% endfor %}
{% if ctx.auth.has_password_auth %}
from routes.login import *
{% endif %}


_INVALID_JSON: Any = object()
_PREFIX = "{{ ctx.app.base_path }}{% if ctx.app.api_version %}/{{ ctx.app.api_version }}{% endif %}"


def _path_to_regex(path: str) -> str:
    """Convert /{collection}/{id} style path to regex with named groups."""
    def _replace(m: re.Match) -> str:
        return f"(?P<{m.group(1)}>[^/]+)"
    return re.sub(r"\{(\w+)\}", _replace, path)


{% set crud_routes = routes | rejectattr("operation", "equalto", "login") | list %}
ROUTES: dict[str, list[tuple[re.Pattern[str], Any]]] = {}
{% for route in crud_routes %}
{% if route.collection %}
{% set handler_name = "handle_" ~ route.operation ~ "_" ~ route.collection %}
ROUTES.setdefault("{{ route.method }}", []).append((re.compile(r"^" + _PREFIX + r"{{ route.path | path_to_regex }}$"), {{ handler_name }}))
{% endif %}
{% endfor %}
{% for identity in ctx.auth.identity_collections %}
{% if identity.has_password and identity.identifier %}
ROUTES.setdefault("POST", []).append((re.compile(r"^" + _PREFIX + r"/{{ identity.name }}/login$"), handle_login_{{ identity.name }}))
{% endif %}
{% endfor %}


class ASGIApp:
    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] == "lifespan":
            await self._handle_lifespan(scope, receive, send)
            return
        if scope["type"] == "http":
            await self._handle_http(scope, receive, send)
            return

    async def _handle_lifespan(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        while True:
            message = await receive()
            if message["type"] == "lifespan.startup":
                connect_db()
                await send({"type": "lifespan.startup.complete"})
            elif message["type"] == "lifespan.shutdown":
                await close_db()
                await send({"type": "lifespan.shutdown.complete"})
                return

    async def _handle_http(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        method = scope["method"].upper()
        path = scope["path"]

        handler, url_params = self._match_route(method, path)
        if handler is None:
            await self._send_json(send, 404, {"detail": "Not found"})
            return

        body = await self._read_body(receive)
        if body is _INVALID_JSON:
            await self._send_json(send, 400, {"detail": "Invalid JSON body"})
            return

        headers = {
            k.decode("latin-1"): v.decode("latin-1")
            for k, v in scope.get("headers", [])
        }

        db = get_database()

        try:
            status, data = await handler(url_params, body, headers, db)
        except ValueError as exc:
            await self._send_json(send, 422, {"detail": str(exc)})
            return

        await self._send_json(send, status, data)

    @staticmethod
    def _match_route(method: str, path: str) -> tuple[Any, dict[str, str]]:
        entries = ROUTES.get(method, [])
        for pattern, handler in entries:
            match = pattern.match(path)
            if match:
                return handler, match.groupdict()
        return None, {}

    @staticmethod
    async def _read_body(receive: Any) -> dict[str, Any] | None:
        body = b""
        while True:
            message = await receive()
            body += message.get("body", b"")
            if not message.get("more_body", False):
                break
        if not body:
            return None
        try:
            return json.loads(body)
        except (json.JSONDecodeError, UnicodeDecodeError):
            return _INVALID_JSON

    @staticmethod
    async def _send_json(send: Any, status: int, data: Any) -> None:
        body = json.dumps(data, default=str).encode("utf-8")
        await send({
            "type": "http.response.start",
            "status": status,
            "headers": [
                [b"content-type", b"application/json"],
                [b"content-length", str(len(body)).encode("latin-1")],
            ],
        })
        await send({"type": "http.response.body", "body": body})


app = ASGIApp()

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        "app:app",
        host=os.environ.get("HOST", "127.0.0.1"),
        port=int(os.environ.get("PORT", "8000")),
        reload=True,
    )
