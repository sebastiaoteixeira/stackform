from fields import Model, partial
{% for model in models %}
{% set properties %}{{ "{" }}{% for field in model.fields %}{{ field.name | tojson }}: {{ field.config | py_literal }}{{ ", " if not loop.last }}{% endfor %}{{ "}" }}{% endset %}

{% if model.operation == "update" %}
{{ model.name }} = partial({{ model.base }})
{% elif model.base %}
{{ model.name }} = {{ model.base }}{% if model.fields %}.extend({{ properties }}){% endif %}

{% else %}
{{ model.name }} = Model({{ properties }})
{% endif %}
{% endfor %}
