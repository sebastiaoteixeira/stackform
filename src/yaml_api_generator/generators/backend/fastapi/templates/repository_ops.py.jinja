import uuid
from collections.abc import Callable
from functools import wraps
from typing import Any

from bson import ObjectId
from bson.errors import InvalidId
from pymongo import ReturnDocument
from pymongo.asynchronous.database import AsyncDatabase
from pymongo.errors import BulkWriteError, DuplicateKeyError

from conflicts import ConflictError
from dependencies.ids import generate_id
from dependencies.mongo_lifecycle import MongoLifecycle, scoped
from dependencies.mongo_operations import run_mongo, with_identity
from dependencies.operations import present, present_value, resolve
from dependencies.pagination import Page, Primitives, expand_bound


_PAGINATION_COMPARATORS = {
    "gt": "$gt",
    "gte": "$gte",
    "lt": "$lt",
    "lte": "$lte",
}


def _pagination_filter(primitives: Primitives) -> dict[str, Any]:
    clauses: list[dict[str, Any]] = []
    for bound in primitives.bounds:
        disjuncts: list[dict[str, Any]] = []
        for equalities, key in expand_bound(bound):
            term = {field: value for field, value in equalities}
            term[key.field] = {_PAGINATION_COMPARATORS[key.op]: key.value}
            disjuncts.append(term)
        clauses.append(disjuncts[0] if len(disjuncts) == 1 else {"$or": disjuncts})
    return {"$and": clauses} if clauses else {}


def _duplicate_details(error: BulkWriteError | DuplicateKeyError) -> dict[str, Any] | None:
    details = error.details or {}
    if isinstance(error, DuplicateKeyError):
        return details
    return next(
        (
            write_error
            for write_error in details.get("writeErrors", [])
            if write_error.get("code") == 11000
        ),
        None,
    )


def _conflict_field(details: dict[str, Any]) -> str | None:
    for key in ("keyPattern", "keyValue"):
        fields = details.get(key)
        if fields:
            return next(iter(fields))
    return None


def _translate_conflict(operation):
    @wraps(operation)
    async def translated(*args, **kwargs):
        try:
            return await operation(*args, **kwargs)
        except (BulkWriteError, DuplicateKeyError) as error:
            details = _duplicate_details(error)
            if details is None:
                raise
            raise ConflictError(_conflict_field(details)) from error

    return translated


def make_id_generator(id_format: str) -> Callable[[], str] | None:
    if id_format == "uuidv4":
        return lambda: str(uuid.uuid4())
    if id_format == "uuidv7":
        try:
            from uuid import uuid7
        except ImportError:
            from uuid_utils import uuid7
        return lambda: str(uuid7())
    return None


class RepositoryBase:
    COLLECTION: str
    ID_FIELD: str
    ID_FORMAT: str = "natural"
    LIFECYCLE: dict[str, Any] = {}

    def __init__(self, db: AsyncDatabase) -> None:
        self._db = db
        self._col = db[self.COLLECTION]
        self._lifecycle = MongoLifecycle(self.LIFECYCLE)
        self._generate_id = make_id_generator(self.ID_FORMAT)

    def _match_filter(self, document_id: str) -> dict[str, Any]:
        candidates: list[Any] = [document_id]
        try:
            candidates.append(ObjectId(document_id))
        except InvalidId:
            pass
        conditions = [{"_id": value} for value in candidates]
        conditions.append({self.ID_FIELD: document_id})
        return {"$or": conditions}

    def _normalize(self, doc: dict[str, Any] | None) -> dict[str, Any] | None:
        """Hide the datastore's own identifier; the service layer hides domain-internal fields."""
        if doc is None:
            return None
        return {k: present_value(v) for k, v in doc.items() if k != "_id"}

    async def purge_expired(self) -> None:
        await self._lifecycle.expire(self._col)

    async def find_by(self, field: str, value: Any) -> dict[str, Any] | None:
        return await self.find_one({field: value})

    async def find_one(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        return self._normalize(await self._col.find_one(self._lifecycle.visible(criteria)))

    @_translate_conflict
    async def update_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        changes = {field: value for field, value in data.items() if field not in criteria}
        if not changes:
            return await self.find_one(criteria)
        doc = await self._col.find_one_and_update(
            self._lifecycle.visible(criteria),
            self._lifecycle.stored_update({"$set": changes}),
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    @_translate_conflict
    async def replace_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        replacement = self._lifecycle.stored({**data, **criteria})
        doc = await self._col.find_one_and_replace(
            self._lifecycle.visible(criteria), replacement, return_document=ReturnDocument.AFTER
        )
        return self._normalize(doc)

    async def delete_by(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        return self._normalize(await self._lifecycle.remove(self._col, criteria))

    @_translate_conflict
    async def insert(self, data: dict[str, Any]) -> dict[str, Any]:
        if self._generate_id is not None:
            data[self.ID_FIELD] = self._generate_id()
        document = self._lifecycle.stored(data)
        await self._col.insert_one(document)
        return self._normalize(document)

    @_translate_conflict
    async def upsert_by(self, key_field: str, data: dict[str, Any]) -> dict[str, Any]:
        if data.get(key_field) is None:
            raise ValueError(f"upsert_by requires a non-null value for key field '{key_field}'")
        on_insert = {self.ID_FIELD: self._generate_id()} if self._generate_id is not None else {}
        doc = await self._col.find_one_and_update(
            {key_field: data.get(key_field)},
            self._lifecycle.stored_update({"$set": data, "$setOnInsert": on_insert}),
            upsert=True,
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)

    @_translate_conflict
    async def run_operation(self, query: dict[str, Any], bindings: dict[str, Any]) -> Any:
        identified = with_identity(query, self.ID_FIELD, self.ID_FORMAT)
        confined = scoped(resolve(identified, bindings), self.LIFECYCLE)
        return present(await run_mongo(self._col, confined, generate_id), self.ID_FIELD)


class ListOp:
    async def list(self) -> list[dict[str, Any]]:
        cursor = self._col.find(self._lifecycle.visible())
        docs = await cursor.to_list(length=None)
        return [self._normalize(d) for d in docs]

    async def paginate(self, primitives: Primitives) -> Page:
        cursor = self._col.find(self._lifecycle.visible(_pagination_filter(primitives)))
        if primitives.sort:
            cursor = cursor.sort(
                [(key.field, -1 if key.descending else 1) for key in primitives.sort]
            )
        if primitives.skip:
            cursor = cursor.skip(primitives.skip)
        if primitives.limit is not None:
            cursor = cursor.limit(primitives.limit)
        documents = await cursor.to_list(length=None)
        total = (
            await self._col.count_documents(self._lifecycle.visible())
            if primitives.count == "exact"
            else None
        )
        return Page([self._normalize(document) for document in documents], total)


class GetOp:
    async def get(self, document_id: str) -> dict[str, Any] | None:
        return await self.find_one(self._match_filter(document_id))


class CreateOp:
    async def create(self, data: dict[str, Any]) -> dict[str, Any]:
        return await self.insert(data)


class UpdateOp:
    async def update(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        return await self.update_by(self._match_filter(document_id), data)


class ReplaceOp:
    @_translate_conflict
    async def replace(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        data[self.ID_FIELD] = document_id
        doc = await self._col.find_one_and_replace(
            self._lifecycle.visible(self._match_filter(document_id)),
            self._lifecycle.stored(data),
            return_document=ReturnDocument.AFTER,
        )
        return self._normalize(doc)


class DeleteOp:
    async def delete(self, document_id: str) -> dict[str, Any] | None:
        return await self.delete_by(self._match_filter(document_id))
