import operator
import sqlite3
import uuid
from collections.abc import Callable
from functools import wraps
from typing import Any

import sqlalchemy as sa
from sqlalchemy.exc import IntegrityError

from conflicts import ConflictError
from dependencies.operations import present, resolve
from dependencies.pagination import Page, Primitives, expand_bound
from dependencies.sql_operations import run_sql


_PAGINATION_COMPARATORS = {
    "gt": operator.gt,
    "gte": operator.ge,
    "lt": operator.lt,
    "lte": operator.le,
}


def _pagination_bounds(table: sa.Table, primitives: Primitives) -> list[Any]:
    clauses = []
    for bound in primitives.bounds:
        disjuncts = []
        for equalities, key in expand_bound(bound):
            terms = [table.c[field] == value for field, value in equalities]
            terms.append(_PAGINATION_COMPARATORS[key.op](table.c[key.field], key.value))
            disjuncts.append(sa.and_(*terms))
        clauses.append(sa.or_(*disjuncts))
    return clauses


def _is_unique_violation(error: IntegrityError) -> bool:
    original = getattr(error, "orig", error)
    sqlstate = getattr(original, "sqlstate", None) or getattr(original, "pgcode", None)
    sqlite_code = getattr(original, "sqlite_errorcode", None)
    message = str(original).lower()
    return (
        sqlstate == "23505"
        or sqlite_code in {
            sqlite3.SQLITE_CONSTRAINT_PRIMARYKEY,
            sqlite3.SQLITE_CONSTRAINT_UNIQUE,
        }
        or "unique constraint failed" in message
        or "duplicate key value violates unique constraint" in message
    )


def _conflict_field(error: IntegrityError) -> str | None:
    original = getattr(error, "orig", error)
    diagnostics = getattr(original, "diag", None)
    column = getattr(diagnostics, "column_name", None)
    if column:
        return column
    detail = getattr(diagnostics, "message_detail", None) or getattr(original, "detail", None)
    if detail and "Key (" in detail:
        return detail.split("Key (", 1)[1].split(")", 1)[0]
    message = str(original)
    if "UNIQUE constraint failed:" in message:
        first = message.split("UNIQUE constraint failed:", 1)[1].split(",")[0]
        return first.strip().split(".")[-1]
    return None


def _translate_conflict(operation):
    @wraps(operation)
    async def translated(*args, **kwargs):
        try:
            return await operation(*args, **kwargs)
        except IntegrityError as error:
            if not _is_unique_violation(error):
                raise
            raise ConflictError(_conflict_field(error)) from error

    return translated


def make_id_generator(id_format: str) -> Callable[[], str] | None:
    if id_format == "uuidv4":
        return lambda: str(uuid.uuid4())
    if id_format == "uuidv7":
        try:
            from uuid import uuid7
        except ImportError:
            from uuid_utils import uuid7
        return lambda: str(uuid7())
    return None


class SQLRepositoryBase:
    COLLECTION: str
    ID_FIELD: str
    ID_FORMAT: str = "natural"
    TABLE: sa.Table

    def __init__(self, engine) -> None:
        self._engine = engine
        self._generate_id = make_id_generator(self.ID_FORMAT)

    def _id_col(self) -> sa.Column:
        return self.TABLE.c[self.ID_FIELD]

    def _known(self, data: dict[str, Any], drop_id: bool = False) -> dict[str, Any]:
        return {
            key: value
            for key, value in data.items()
            if key in self.TABLE.columns and not (drop_id and key == self.ID_FIELD)
        }

    def _criteria(self, criteria: dict[str, Any]) -> tuple[sa.ColumnElement[bool], ...]:
        return tuple(self.TABLE.c[field] == value for field, value in criteria.items())

    @staticmethod
    def _one(result: sa.Result) -> dict[str, Any] | None:
        row = result.first()
        return dict(row._mapping) if row is not None else None

    @_translate_conflict
    async def run_operation(self, query: dict[str, Any], bindings: dict[str, Any]) -> Any:
        async with self._engine.begin() as conn:
            return present(await run_sql(conn, resolve(query, bindings)), self.ID_FIELD)

    async def find_by(self, field: str, value: Any) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(self.TABLE.c[field] == value)
            )
            return self._one(result)

    async def find_one(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(*self._criteria(criteria)).limit(1)
            )
            return self._one(result)

    @_translate_conflict
    async def update_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        changes = {field: value for field, value in data.items() if field not in criteria}
        if not changes:
            return await self.find_one(criteria)
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(*self._criteria(criteria))
                .values(**self._known(changes, drop_id=True))
                .returning(self.TABLE)
            )
            return self._one(result)

    @_translate_conflict
    async def replace_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        replacement = {**data, **criteria}
        values = {
            column.name: replacement.get(column.name)
            for column in self.TABLE.columns
            if column.name != self.ID_FIELD
        }
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(*self._criteria(criteria))
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)

    async def delete_by(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.delete(self.TABLE)
                .where(*self._criteria(criteria))
                .returning(self.TABLE)
            )
            return self._one(result)

    @_translate_conflict
    async def insert(self, data: dict[str, Any]) -> dict[str, Any]:
        if self._generate_id is not None:
            data[self.ID_FIELD] = self._generate_id()
        values = self._known(data)
        async with self._engine.begin() as conn:
            await conn.execute(sa.insert(self.TABLE).values(**values))
        return values

    @_translate_conflict
    async def upsert_by(self, key_field: str, data: dict[str, Any]) -> dict[str, Any]:
        from sqlalchemy.dialects.postgresql import insert as pg_insert

        if data.get(key_field) is None:
            raise ValueError(f"upsert_by requires a non-null value for key field '{key_field}'")
        values = dict(self._known(data))
        if self._generate_id is not None:
            values.setdefault(self.ID_FIELD, self._generate_id())
        statement = pg_insert(self.TABLE).values(**values)
        statement = statement.on_conflict_do_update(
            index_elements=[key_field],
            set_={k: statement.excluded[k] for k in values if k != key_field},
        ).returning(self.TABLE)
        async with self._engine.begin() as conn:
            result = await conn.execute(statement)
            return self._one(result)


class ListOp:
    async def list(self) -> list[dict[str, Any]]:
        async with self._engine.connect() as conn:
            result = await conn.execute(sa.select(self.TABLE))
            return [dict(row._mapping) for row in result]

    async def paginate(self, primitives: Primitives) -> Page:
        statement = sa.select(self.TABLE)
        clauses = _pagination_bounds(self.TABLE, primitives)
        if clauses:
            statement = statement.where(sa.and_(*clauses))
        for key in primitives.sort:
            column = self.TABLE.c[key.field]
            statement = statement.order_by(
                column.desc() if key.descending else column.asc()
            )
        if primitives.skip:
            statement = statement.offset(primitives.skip)
        if primitives.limit is not None:
            statement = statement.limit(primitives.limit)
        async with self._engine.connect() as conn:
            rows = [dict(row._mapping) for row in await conn.execute(statement)]
            total = None
            if primitives.count == "exact":
                count_statement = sa.select(sa.func.count()).select_from(self.TABLE)
                total = (await conn.execute(count_statement)).scalar()
        return Page(rows, total)


class GetOp:
    async def get(self, document_id: str) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(self._id_col() == document_id)
            )
            return self._one(result)


class CreateOp:
    async def create(self, data: dict[str, Any]) -> dict[str, Any]:
        return await self.insert(data)


class UpdateOp:
    @_translate_conflict
    async def update(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        values = self._known(data, drop_id=True)
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(self._id_col() == document_id)
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)


class ReplaceOp:
    @_translate_conflict
    async def replace(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        values = {
            column.name: data.get(column.name)
            for column in self.TABLE.columns
            if column.name != self.ID_FIELD
        }
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(self._id_col() == document_id)
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)


class DeleteOp:
    async def delete(self, document_id: str) -> dict[str, Any] | None:
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.delete(self.TABLE).where(self._id_col() == document_id).returning(self.TABLE)
            )
            return self._one(result)
