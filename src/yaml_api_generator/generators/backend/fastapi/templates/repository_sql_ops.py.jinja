import uuid
from collections.abc import Callable
from typing import Any

import sqlalchemy as sa


def make_id_generator(id_format: str) -> Callable[[], str] | None:
    if id_format == "uuidv4":
        return lambda: str(uuid.uuid4())
    if id_format == "uuidv7":
        try:
            from uuid import uuid7
        except ImportError:
            from uuid_utils import uuid7
        return lambda: str(uuid7())
    return None


class SQLRepositoryBase:
    COLLECTION: str
    ID_FIELD: str
    ID_FORMAT: str = "natural"
    TABLE: sa.Table

    def __init__(self, engine) -> None:
        self._engine = engine
        self._generate_id = make_id_generator(self.ID_FORMAT)

    def _id_col(self) -> sa.Column:
        return self.TABLE.c[self.ID_FIELD]

    def _known(self, data: dict[str, Any], drop_id: bool = False) -> dict[str, Any]:
        return {
            key: value
            for key, value in data.items()
            if key in self.TABLE.columns and not (drop_id and key == self.ID_FIELD)
        }

    def _criteria(self, criteria: dict[str, Any]) -> tuple[sa.ColumnElement[bool], ...]:
        return tuple(self.TABLE.c[field] == value for field, value in criteria.items())

    @staticmethod
    def _one(result: sa.Result) -> dict[str, Any] | None:
        row = result.first()
        return dict(row._mapping) if row is not None else None

    async def find_by(self, field: str, value: Any) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(self.TABLE.c[field] == value)
            )
            return self._one(result)

    async def find_one(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(*self._criteria(criteria)).limit(1)
            )
            return self._one(result)

    async def update_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        changes = {field: value for field, value in data.items() if field not in criteria}
        if not changes:
            return await self.find_one(criteria)
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(*self._criteria(criteria))
                .values(**self._known(changes, drop_id=True))
                .returning(self.TABLE)
            )
            return self._one(result)

    async def replace_by(
        self, criteria: dict[str, Any], data: dict[str, Any]
    ) -> dict[str, Any] | None:
        replacement = {**data, **criteria}
        values = {
            column.name: replacement.get(column.name)
            for column in self.TABLE.columns
            if column.name != self.ID_FIELD
        }
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(*self._criteria(criteria))
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)

    async def delete_by(self, criteria: dict[str, Any]) -> dict[str, Any] | None:
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.delete(self.TABLE)
                .where(*self._criteria(criteria))
                .returning(self.TABLE)
            )
            return self._one(result)

    async def insert(self, data: dict[str, Any]) -> dict[str, Any]:
        if self._generate_id is not None:
            data[self.ID_FIELD] = self._generate_id()
        values = self._known(data)
        async with self._engine.begin() as conn:
            await conn.execute(sa.insert(self.TABLE).values(**values))
        return values

    async def upsert_by(self, key_field: str, data: dict[str, Any]) -> dict[str, Any]:
        from sqlalchemy.dialects.postgresql import insert as pg_insert

        if data.get(key_field) is None:
            raise ValueError(f"upsert_by requires a non-null value for key field '{key_field}'")
        values = dict(self._known(data))
        if self._generate_id is not None:
            values.setdefault(self.ID_FIELD, self._generate_id())
        statement = pg_insert(self.TABLE).values(**values)
        statement = statement.on_conflict_do_update(
            index_elements=[key_field],
            set_={k: statement.excluded[k] for k in values if k != key_field},
        ).returning(self.TABLE)
        async with self._engine.begin() as conn:
            result = await conn.execute(statement)
            return self._one(result)


class ListOp:
    async def list(self) -> list[dict[str, Any]]:
        async with self._engine.connect() as conn:
            result = await conn.execute(sa.select(self.TABLE))
            return [dict(row._mapping) for row in result]


class GetOp:
    async def get(self, document_id: str) -> dict[str, Any] | None:
        async with self._engine.connect() as conn:
            result = await conn.execute(
                sa.select(self.TABLE).where(self._id_col() == document_id)
            )
            return self._one(result)


class CreateOp:
    async def create(self, data: dict[str, Any]) -> dict[str, Any]:
        return await self.insert(data)


class UpdateOp:
    async def update(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        values = self._known(data, drop_id=True)
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(self._id_col() == document_id)
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)


class ReplaceOp:
    async def replace(self, document_id: str, data: dict[str, Any]) -> dict[str, Any] | None:
        values = {
            column.name: data.get(column.name)
            for column in self.TABLE.columns
            if column.name != self.ID_FIELD
        }
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.update(self.TABLE)
                .where(self._id_col() == document_id)
                .values(**values)
                .returning(self.TABLE)
            )
            return self._one(result)


class DeleteOp:
    async def delete(self, document_id: str) -> dict[str, Any] | None:
        async with self._engine.begin() as conn:
            result = await conn.execute(
                sa.delete(self.TABLE).where(self._id_col() == document_id).returning(self.TABLE)
            )
            return self._one(result)
