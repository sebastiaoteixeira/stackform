{% set class_name = collection_name | capitalize_collection %}
{% set has_custom = custom_operations | default([]) | length > 0 %}
{% if has_custom %}
from typing import Any

from pymongo import ReturnDocument

{% endif %}
from ._ops import RepositoryBase{% for op in operations %}, {{ op | capitalize }}Op{% endfor %}



class {{ class_name }}Repository({% for op in operations %}{{ op | capitalize }}Op, {% endfor %}RepositoryBase):
    COLLECTION = "{{ collection_name }}"
    ID_FIELD = "{{ id_field }}"
    ID_FORMAT = "{{ id_field_format }}"
{% for op in custom_operations | default([]) %}
{% set q = op.query %}
{% set col_expr = "self._db[\"" + q.collection + "\"]" if q and q.collection else "self._col" %}
{% if q %}
{% set cmd = q.command %}
{% if cmd == "find" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> list[dict[str, Any]]:
        cursor = {{ col_expr }}.find(filter)
        docs = await cursor.to_list(length=None)
        return [self._normalize(d) for d in docs]
{% elif cmd == "findOne" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one(filter)
        return self._normalize(doc)
{% elif cmd == "aggregate" %}

    async def {{ op.name }}(self, pipeline: list) -> list[dict[str, Any]]:
        cursor = {{ col_expr }}.aggregate(pipeline)
        return await cursor.to_list(length=None)
{% elif cmd == "countDocuments" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> int:
        return await {{ col_expr }}.count_documents(filter)
{% elif cmd == "estimatedDocumentCount" %}

    async def {{ op.name }}(self) -> int:
        return await {{ col_expr }}.estimated_document_count()
{% elif cmd == "distinct" %}

    async def {{ op.name }}(self, key: str, filter: dict[str, Any]) -> list:
        return await {{ col_expr }}.distinct(key, filter)
{% elif cmd == "insertOne" %}

    async def {{ op.name }}(self, document: dict[str, Any]) -> dict[str, Any]:
        await {{ col_expr }}.insert_one(document)
        return self._normalize(document)
{% elif cmd == "insertMany" %}

    async def {{ op.name }}(self, documents: list[dict[str, Any]]) -> list[dict[str, Any]]:
        await {{ col_expr }}.insert_many(documents)
        return [self._normalize(d) for d in documents]
{% elif cmd == "updateOne" %}

    async def {{ op.name }}(self, filter: dict[str, Any], update: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_update(filter, update, return_document=ReturnDocument.AFTER)
        return self._normalize(doc)
{% elif cmd == "updateMany" %}

    async def {{ op.name }}(self, filter: dict[str, Any], update: dict[str, Any]) -> Any:
        return await {{ col_expr }}.update_many(filter, update)
{% elif cmd == "replaceOne" %}

    async def {{ op.name }}(self, filter: dict[str, Any], replacement: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_replace(filter, replacement, return_document=ReturnDocument.AFTER)
        return self._normalize(doc)
{% elif cmd == "deleteOne" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_delete(filter)
        return self._normalize(doc)
{% elif cmd == "deleteMany" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> Any:
        return await {{ col_expr }}.delete_many(filter)
{% elif cmd == "findOneAndUpdate" %}

    async def {{ op.name }}(self, filter: dict[str, Any], update: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_update(filter, update, return_document=ReturnDocument.AFTER)
        return self._normalize(doc)
{% elif cmd == "findOneAndReplace" %}

    async def {{ op.name }}(self, filter: dict[str, Any], replacement: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_replace(filter, replacement, return_document=ReturnDocument.AFTER)
        return self._normalize(doc)
{% elif cmd == "findOneAndDelete" %}

    async def {{ op.name }}(self, filter: dict[str, Any]) -> dict[str, Any] | None:
        doc = await {{ col_expr }}.find_one_and_delete(filter)
        return self._normalize(doc)
{% elif cmd == "bulkWrite" %}

    async def {{ op.name }}(self, requests: list) -> Any:
        return await {{ col_expr }}.bulk_write(requests)
{% endif %}
{% else %}

    async def {{ op.name }}(self, **kwargs: Any) -> Any:
        import {{ op.handler.rsplit(".", 1)[0] }}
        return await {{ op.handler }}(**kwargs)
{% endif %}
{% endfor %}