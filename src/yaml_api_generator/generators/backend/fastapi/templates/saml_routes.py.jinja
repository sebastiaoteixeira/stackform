{% import "external_login.jinja" as login %}
{% set _bound = [] %}
{% for col in auth.identity_collections %}
{% for binding in col.bindings %}
{% set provider = auth.providers.get(binding.provider) %}
{% if provider and provider.type == "saml" %}
{% set _ = _bound.append((col, binding, provider)) %}
{% endif %}
{% endfor %}
{% endfor %}
from fastapi import APIRouter, HTTPException, Request
from fastapi.responses import RedirectResponse, Response

{{ login.imports(_bound) }}
from dependencies.saml import SAMLServiceProvider
from dependencies.saml_assertions import assertion_ledgers
from settings import settings

router = APIRouter()


{{ login.frontend_url() }}
{% for col, binding, provider in _bound %}
{% set provider_name = binding.provider %}
{% set sym = (col.name ~ "_" ~ provider_name) | py_identifier %}

_{{ sym }} = SAMLServiceProvider(
    {{ provider.idp_metadata_url | py_literal }},
    {{ provider.sp_entity_id | py_literal }},
    "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}",
    assertion_ledgers["{{ 'sql' if col.is_sql else 'mongo' }}"],
)
_{{ sym }}_binding = {{ binding | py_constructor }}


@router.get("/{{ col.name }}/auth/{{ provider_name }}")
async def saml_{{ sym }}_login(request: Request) -> RedirectResponse:
    return RedirectResponse(url=await _{{ sym }}.login_redirect(request))


@router.post("/{{ col.name }}/auth/{{ provider_name }}/callback")
async def saml_{{ sym }}_callback(request: Request) -> RedirectResponse:
