from typing import Any, Callable

from fastapi import Depends

{% if uses_mongo %}
from dependencies.mongodb import get_database as get_mongo_db
{% endif %}
{% if uses_sql %}
from dependencies.postgres import get_database as get_pg_db
{% endif %}
{% for col in collections %}
from repositories.{{ col.name }} import {{ col.class_name }}Repository
{% endfor %}


def repository_provider(repo_cls: type, db_dep: Callable) -> Callable:
    def provide(db=Depends(db_dep)):
        return repo_cls(db)
    provide.__name__ = f"get_{repo_cls.__name__.lower()}"
    return provide


_REPOSITORIES: dict[str, tuple[type, Callable]] = {
{% for col in collections %}
    "{{ col.name }}": ({{ col.class_name }}Repository, {{ "get_pg_db" if col.is_sql else "get_mongo_db" }}),
{% endfor %}
}


def repository(collection: str) -> Any:
    """The repository of ``collection``, for code that runs outside request dependencies."""
    repo_cls, get_db = _REPOSITORIES[collection]
    return repo_cls(get_db())


{% for col in collections %}
get_{{ col.name }}_repository = repository_provider(*_REPOSITORIES["{{ col.name }}"])
{% endfor %}
