# Mirrors yaml_api_generator.ir.when (AST + helpers),
# yaml_api_generator.server.common.utils.field_access.get_nested_field,
# and yaml_api_generator.server.common.when_eval. Keep in sync with those.
from __future__ import annotations

from dataclasses import dataclass
from typing import Any


@dataclass(frozen=True)
class WhenExpr:
    pass


@dataclass(frozen=True)
class FieldRef(WhenExpr):
    root: str
    path: tuple[str, ...]


@dataclass(frozen=True)
class StringLiteral(WhenExpr):
    value: str


@dataclass(frozen=True)
class Equals(WhenExpr):
    left: WhenExpr
    right: WhenExpr


@dataclass(frozen=True)
class NotEquals(WhenExpr):
    left: WhenExpr
    right: WhenExpr


@dataclass(frozen=True)
class And(WhenExpr):
    left: WhenExpr
    right: WhenExpr


@dataclass(frozen=True)
class Or(WhenExpr):
    left: WhenExpr
    right: WhenExpr


@dataclass(frozen=True)
class Not(WhenExpr):
    operand: WhenExpr


@dataclass(frozen=True)
class In(WhenExpr):
    left: WhenExpr
    values: tuple[Any, ...]


@dataclass(frozen=True)
class NotIn(WhenExpr):
    left: WhenExpr
    values: tuple[Any, ...]


def get_nested_field(obj: dict[str, Any], path: str, default: Any = None) -> Any:
    if not path:
        return default

    current: Any = obj
    for part in path.split("."):
        if not isinstance(current, dict):
            return default
        current = current.get(part)
        if current is None:
            return default

    return current


def needs_document(expr: WhenExpr) -> bool:
    if isinstance(expr, FieldRef):
        return expr.root == "document"
    if isinstance(expr, StringLiteral):
        return False
    if isinstance(expr, (Equals, NotEquals, And, Or)):
        return needs_document(expr.left) or needs_document(expr.right)
    if isinstance(expr, (In, NotIn)):
        return needs_document(expr.left)
    if isinstance(expr, Not):
        return needs_document(expr.operand)
    return False


def collect_roots(expr: WhenExpr) -> set[str]:
    if isinstance(expr, FieldRef):
        return {expr.root}
    if isinstance(expr, StringLiteral):
        return set()
    if isinstance(expr, (Equals, NotEquals, And, Or)):
        return collect_roots(expr.left) | collect_roots(expr.right)
    if isinstance(expr, (In, NotIn)):
        return collect_roots(expr.left)
    if isinstance(expr, Not):
        return collect_roots(expr.operand)
    return set()


def _resolve_field(ref: FieldRef, symbols: dict[str, dict | None]) -> object:
    binding = symbols.get(ref.root)
    if binding is None:
        return None
    if not ref.path:
        return binding.get("sub")
    return get_nested_field(binding, ".".join(ref.path))


def _resolve(expr: WhenExpr, symbols: dict[str, dict | None]) -> object:
    if isinstance(expr, FieldRef):
        return _resolve_field(expr, symbols)
    if isinstance(expr, StringLiteral):
        return expr.value
    return None


def _evaluate(expr: WhenExpr, symbols: dict[str, dict | None]) -> bool:
    if isinstance(expr, Equals):
        return _resolve(expr.left, symbols) == _resolve(expr.right, symbols)
    if isinstance(expr, NotEquals):
        return _resolve(expr.left, symbols) != _resolve(expr.right, symbols)
    if isinstance(expr, And):
        return _evaluate(expr.left, symbols) and _evaluate(expr.right, symbols)
    if isinstance(expr, Or):
        return _evaluate(expr.left, symbols) or _evaluate(expr.right, symbols)
    if isinstance(expr, Not):
        return not _evaluate(expr.operand, symbols)
    if isinstance(expr, In):
        return _resolve(expr.left, symbols) in expr.values
    if isinstance(expr, NotIn):
        return _resolve(expr.left, symbols) not in expr.values
    return False


def evaluate_when_with_symbols(expr: WhenExpr, symbols: dict[str, dict | None]) -> bool:
    return _evaluate(expr, symbols)
