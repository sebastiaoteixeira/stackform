from fastapi.openapi.utils import get_openapi
{% endif %}

{% set col_types = [] %}
{% for c in ctx.collections.values() %}
{% if c.datastore_type not in col_types %}
{% set _ = col_types.append(c.datastore_type) %}
{% endif %}
{% endfor %}
{% set uses_sql = (col_types | select("in", ["postgres", "postgresql"]) | list | length) > 0 %}
{% set uses_mongo = ((col_types | select("in", ["mongodb", "mongo"]) | list | length) > 0) or not uses_sql %}
{% set mongo_unique_indexes = {} %}
{% for col_name, col in ctx.collections.items() %}
{% if col.datastore_type in ["mongodb", "mongo"] %}
{% set _unique = [] %}
{% for field_name, field_cfg in col.fields.items() if field_cfg is mapping and field_cfg.get("unique") %}
{% set _ = _unique.append(field_name) %}
{% endfor %}
{% if _unique %}{% set _ = mongo_unique_indexes.update({col_name: _unique}) %}{% endif %}
{% endif %}
{% endfor %}
{% set create_mongo_indexes = uses_mongo and mongo_unique_indexes and not ctx.mongo_schema_managed %}
{% if uses_mongo %}
from dependencies.mongodb import connect_db as connect_mongo, close_db as close_mongo
{% endif %}
{% if create_mongo_indexes %}
from dependencies.mongodb import initialize_indexes as initialize_mongo_indexes
{% endif %}
{% if uses_sql %}
from dependencies.postgres import connect_db as connect_pg, close_db as close_pg
{% endif %}
from routes import api_router


@asynccontextmanager
async def lifespan(app: FastAPI):
{% if uses_mongo %}
    connect_mongo()
{% if create_mongo_indexes %}
    await initialize_mongo_indexes({{ mongo_unique_indexes | tojson }})
{% endif %}
{% endif %}
{% if uses_sql %}
    await connect_pg()
{% endif %}
    yield
{% if uses_sql %}
    await close_pg()
{% endif %}
{% if uses_mongo %}
    await close_mongo()
{% endif %}


app = FastAPI(lifespan=lifespan)


@app.exception_handler(NotFoundError)
async def _not_found_handler(_: Request, __: NotFoundError) -> JSONResponse:
    return JSONResponse(status_code=404, content={"detail": "Resource not found"})


@app.exception_handler(ValidationError)
async def _validation_handler(_: Request, exc: ValidationError) -> JSONResponse:
    return JSONResponse(status_code=422, content={"detail": exc.message})


@app.exception_handler(ConflictError)
async def _conflict_handler(_: Request, exc: ConflictError) -> JSONResponse:
    return JSONResponse(status_code=409, content={"detail": str(exc)})


