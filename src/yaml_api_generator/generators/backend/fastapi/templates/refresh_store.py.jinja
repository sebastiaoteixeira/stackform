from uuid import uuid4

from dependencies.jwt_utils import create_refresh_token, decode_refresh_token
from dependencies.mongodb import get_database

COLLECTION = "_refresh_tokens"


def _collection():
    return get_database()[COLLECTION]


async def issue(sub: str, identity_collection: str, sid: str | None = None) -> str:
    sid = sid or uuid4().hex
    jti = uuid4().hex
    await _collection().insert_one({
        "jti": jti,
        "sid": sid,
        "sub": sub,
        "identity_collection": identity_collection,
        "used": False,
        "revoked": False,
    })
    return create_refresh_token(sub, identity_collection, jti, sid)


async def rotate(token: str) -> dict | None:
    claims = decode_refresh_token(token)
    if claims is None:
        return None

    col = _collection()
    record = await col.find_one({"jti": claims["jti"]})
    if record is None or record["revoked"]:
        return None
    if record["used"]:
        await col.update_many({"sid": record["sid"]}, {"$set": {"revoked": True}})
        return None

    await col.update_one({"jti": claims["jti"]}, {"$set": {"used": True}})
    refresh_token = await issue(
        record["sub"], record["identity_collection"], record["sid"]
    )
    return {
        "sub": record["sub"],
        "identity_collection": record["identity_collection"],
        "refresh_token": refresh_token,
    }


async def revoke_session(sid: str) -> None:
    await _collection().update_many({"sid": sid}, {"$set": {"revoked": True}})
