{% set crud_op_names = ["list", "get", "create", "update", "replace", "delete", "login"] %}
{% set crud_routes = routes | rejectattr("operation", "equalto", "login") | rejectattr("handler") | selectattr("operation", "in", crud_op_names) | list %}
{% set custom_routes = routes | rejectattr("operation", "equalto", "login") | selectattr("handler") | list %}
{% set repo_op_routes = routes | rejectattr("handler") | rejectattr("operation", "in", crud_op_names) | list %}
from typing import Any

{% set is_mongo = datastore_type not in ["postgres", "postgresql"] %}
{% set needs_request = custom_routes or repo_op_routes or (crud_routes | selectattr("needs_request") | list) %}
from fastapi import APIRouter, Depends{% if auth.enabled %}, HTTPException{% endif %}{% if needs_request %}, Request{% endif %}

{% if repo_op_routes and is_mongo %}
from fastapi.encoders import jsonable_encoder
{% endif %}
{% for group in service_groups %}
from dependencies.services import get_{{ group }}_service
{% endfor %}
{% if repo_op_routes %}
from dependencies.repositories import get_{{ collection_name }}_repository
{% endif %}
{% set ns_auth = namespace(needs_require=false, needs_role=false) %}
{% for route in routes %}
{% if route.needs_auth %}{% set ns_auth.needs_require = true %}{% endif %}
{% if route.access_rules %}{% set ns_auth.needs_role = true %}{% endif %}
{% endfor %}
{% if auth.enabled and ns_auth.needs_require %}
from dependencies.auth import require_principal
{% endif %}
{% if auth.enabled and ns_auth.needs_role %}
from dependencies.authorization import _principal_has_role
{% endif %}
{% set ns = namespace(model_imports=[]) %}
{% for route in crud_routes %}
{% if route.body_model and route.body_model not in ns.model_imports %}
{% set _ = ns.model_imports.append(route.body_model) %}
{% endif %}
{% endfor %}
{% if ns.model_imports %}
from models.{{ collection_name }} import {{ ns.model_imports | join(", ") }}
{% endif %}
{% set ns_dto = namespace(dto_imports=[]) %}
{% for route in crud_routes %}
{% if route.typed_body_model and route.typed_body_model not in ns_dto.dto_imports %}
{% set _ = ns_dto.dto_imports.append(route.typed_body_model) %}
{% endif %}
{% endfor %}
{% if ns_dto.dto_imports %}
from models._dto import {{ ns_dto.dto_imports | join(", ") }}
{% endif %}
{% set security_schemes = [] %}
{% if auth.has_api_key_auth %}
{% set _ = security_schemes.append({"ApiKeyAuth": []}) %}
{% set _ = security_schemes.append({"BearerAuth": []}) %}
{% endif %}
{% if auth.has_password_auth %}
{% set _ = security_schemes.append({"BasicAuth": []}) %}
{% set _ = security_schemes.append({"BearerAuth": []}) %}
{% endif %}


router = APIRouter(tags=["{{ collection_name | capitalize_collection }}"])

{% macro openapi_extra(route) %}{% if route.needs_auth and security_schemes %}, openapi_extra={"security": {{ security_schemes }}}{% endif %}{% endmacro %}
{% macro auth_param(route) %}{% if auth.enabled and route.needs_auth %}, principal: dict[str, Any] = Depends(require_principal){% endif %}{% endmacro %}
{% macro svc_dep() %}svc=Depends(get_{{ service_groups | first }}_service){% endmacro %}
{% macro extra_path_params(route) %}{% for name in route.path_params if name != "id" %}, {{ name }}: str{% endfor %}{% endmacro %}
{% macro request_param(route) %}{% if route.needs_request %}, request: Request{% endif %}{% endmacro %}
{% macro request_locals(route, body_expr) %}
{% if route.access_rules %}
{% set ns_req = namespace(symbols=[]) %}
{% for rule in route.access_rules %}
{% for symbol in rule.request_symbols %}
{% if symbol.name not in (ns_req.symbols | map(attribute="name") | list) %}
{% set _ = ns_req.symbols.append(symbol) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns_req.symbols %}
    _request_body = {{ body_expr }}
    _request_path = {{ "{" }}{% for name in route.path_params %}"{{ name }}": {{ name }}{% if not loop.last %}, {% endif %}{% endfor %}{{ "}" }}
{% if route.needs_request %}
    _request_query = dict(request.query_params)
    _request_header = dict(request.headers)
    _request_cookie = dict(request.cookies)
{% else %}
    _request_query = {}
    _request_header = {}
    _request_cookie = {}
{% endif %}
{% for symbol in ns_req.symbols %}
    {{ symbol | request_symbol_binding }}
{% endfor %}
{% endif %}
{% endif %}
{% endmacro %}

{# Emit pre-fetch authorization guards as inline compiled conditions. #}
{# Rules whose `when` references `document` are deferred to post-fetch. #}
{% macro pre_fetch_guard(route) %}
{% if auth.enabled and route.needs_auth and route.access_rules %}
{% set ns = namespace(has_doc_rule=false, identity_symbols=[]) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}
{% set ns.has_doc_rule = true %}
{% endif %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in ns.identity_symbols %}
{% set _ = ns.identity_symbols.append(symbol) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if not ns.has_doc_rule %}
{% set ns.first = true %}
{% set ns.has_conditionals = false %}
{% for rule in route.access_rules %}
{% if rule is unconditional %}
{% if rule.effect == "deny" %}
    raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% set ns.first = false %}
{% else %}
{% set ns.has_conditionals = true %}
{% set keyword = "if" if ns.first else "elif" %}
    {{ keyword }} {{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
        raise HTTPException(status_code=403, detail="Forbidden")
{% else %}
        pass
{% endif %}
{% set ns.first = false %}
{% endif %}
{% endfor %}
{% if ns.has_conditionals %}
    else:
        raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}

{# Emit post-fetch authorization guards for rules that reference the document. #}
{% macro post_fetch_guard(route, doc_var) %}
{% if auth.enabled and route.needs_auth and route.access_rules %}
{% set ns = namespace(has_doc_rule=false, document_symbols=[]) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}
{% set ns.has_doc_rule = true %}
{% endif %}
{% for symbol in rule.document_symbols %}
{% if symbol not in ns.document_symbols %}
{% set _ = ns.document_symbols.append(symbol) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns.has_doc_rule %}
{% for symbol in ns.document_symbols %}
    {{ symbol }} = {{ doc_var }}
{% endfor %}
{% set ns.first = true %}
{% for rule in route.access_rules %}
{% set rule_needs_doc = rule is needs_document_rule %}
{% set keyword = "if" if ns.first else "elif" %}
    {{ keyword }} {% if rule_needs_doc %}{{ doc_var }} is not None and {% endif %}{{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
        raise HTTPException(status_code=403, detail="Forbidden")
{% else %}
        pass
{% endif %}
{% set ns.first = false %}
{% endfor %}
{% if not ns.first %}
    else:
        raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}

{% for route in crud_routes %}
{% set body_model = route.typed_body_model or route.body_model %}
{% if route.operation == "list" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
{% set list_prefix = (extra_path_params(route) ~ request_param(route) ~ auth_param(route)) | trim(chars=", ") %}
async def list_{{ collection_name }}({{ list_prefix }}{% if list_prefix %}, {% endif %}{{ svc_dep() }}) -> Any:
{{ request_locals(route, "None") }}
{{ pre_fetch_guard(route) }}
    return await svc.list()


{% elif route.operation == "get" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
async def get_{{ collection_name }}(id: str{{ extra_path_params(route) }}{{ request_param(route) }}{{ auth_param(route) }}, {{ svc_dep() }}) -> Any:
{{ request_locals(route, "None") }}
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await svc.get(id)
{{ post_fetch_guard(route, "existing") }}
    return existing
{% else %}
    return await svc.get(id)
{% endif %}


{% elif route.operation == "create" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
async def create_{{ collection_name }}(payload: {{ body_model }}{{ extra_path_params(route) }}{{ request_param(route) }}{{ auth_param(route) }}, {{ svc_dep() }}) -> Any:
{{ request_locals(route, "payload.model_dump(exclude_unset=True)") }}
{{ pre_fetch_guard(route) }}
    return await svc.create(payload.model_dump(exclude_unset=True))


{% elif route.operation == "update" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
async def update_{{ collection_name }}(id: str, payload: {{ body_model }}{{ extra_path_params(route) }}{{ request_param(route) }}{{ auth_param(route) }}, {{ svc_dep() }}) -> Any:
{{ request_locals(route, "payload.model_dump(exclude_unset=True)") }}
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await svc.get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await svc.update(id, payload.model_dump(exclude_unset=True))


{% elif route.operation == "replace" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
async def replace_{{ collection_name }}(id: str, payload: {{ body_model }}{{ extra_path_params(route) }}{{ request_param(route) }}{{ auth_param(route) }}, {{ svc_dep() }}) -> Any:
{{ request_locals(route, "payload.model_dump(exclude_unset=True)") }}
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await svc.get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await svc.replace(id, payload.model_dump(exclude_unset=True))


{% elif route.operation == "delete" %}
@router.{{ route.method | lower }}("{{ route.relative_path }}"{{ openapi_extra(route) }})
async def delete_{{ collection_name }}(id: str{{ extra_path_params(route) }}{{ request_param(route) }}{{ auth_param(route) }}, {{ svc_dep() }}) -> Any:
{{ request_locals(route, "None") }}
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await svc.get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await svc.delete(id)


{% endif %}
{% endfor %}
{% for route in custom_routes %}
{% set handler_name = route.operation ~ "_" ~ collection_name %}


@router.{{ route.method | lower }}("{{ route.relative_path }}", tags=["{{ collection_name | capitalize_collection }}"])
async def {{ handler_name }}(request: Request) -> Any:
    from importlib import import_module
    module_path, func_name = "{{ route.handler }}".rsplit(".", 1)
    module = import_module(module_path)
    return await getattr(module, func_name)(request)
{% endfor %}
{% if is_mongo %}
{% for route in repo_op_routes %}
{% set handler_name = route.operation ~ "_" ~ collection_name %}
{% set query = repo_queries[route.operation] %}


@router.{{ route.method | lower }}("{{ route.relative_path }}", tags=["{{ collection_name | capitalize_collection }}"])
async def {{ handler_name }}(request: Request, repo=Depends(get_{{ collection_name }}_repository)) -> Any:
    return jsonable_encoder(await repo.{{ route.operation }}({% for key, value in (query or {}).items() if key != "command" %}{{ key }}={{ value | py_literal }}{% if not loop.last %}, {% endif %}{% endfor %}))
{% endfor %}
{% endif %}
