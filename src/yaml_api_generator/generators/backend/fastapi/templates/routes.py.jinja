{% set crud_op_names = ["list", "get", "create", "update", "replace", "delete", "login"] %}
{% set crud_routes = routes | rejectattr("operation", "equalto", "login") | rejectattr("handler") | selectattr("operation", "in", crud_op_names) | list %}
{% set custom_routes = routes | rejectattr("operation", "equalto", "login") | selectattr("handler") | list %}
{% set repo_op_routes = routes | rejectattr("handler") | rejectattr("operation", "in", crud_op_names) | list %}
from typing import Any

from fastapi import APIRouter{% if auth.enabled %}, Depends, HTTPException{% endif %}{% if custom_routes or repo_op_routes %}, Request{% endif %}

{% set ds_module = "postgres" if datastore_type in ["postgres", "postgresql"] else "mongodb" %}
{% set is_mongo = datastore_type not in ["postgres", "postgresql"] %}
from repositories.{{ collection_name }} import {{ collection_name | capitalize_collection }}Repository
from services.{{ collection_name }} import {{ collection_name | capitalize_collection }}Service
from dependencies.{{ ds_module }} import get_database
{% if repo_op_routes and is_mongo %}
from fastapi.encoders import jsonable_encoder
{% endif %}
{% if auth.enabled %}
from dependencies.auth import require_principal
from dependencies.authorization import _principal_has_role
{% endif %}
{% set ns = namespace(model_imports=[]) %}
{% for route in crud_routes %}
{% if route.body_model and route.body_model not in ns.model_imports %}
{% set _ = ns.model_imports.append(route.body_model) %}
{% endif %}
{% endfor %}
{% if ns.model_imports %}
from models.{{ collection_name }} import {{ ns.model_imports | join(", ") }}
{% endif %}
{% set security_schemes = [] %}
{% if auth.has_api_key_auth %}
{% set _ = security_schemes.append({"ApiKeyAuth": []}) %}
{% set _ = security_schemes.append({"BearerAuth": []}) %}
{% endif %}
{% if auth.has_password_auth %}
{% set _ = security_schemes.append({"BasicAuth": []}) %}
{% set _ = security_schemes.append({"BearerAuth": []}) %}
{% endif %}


def _service() -> {{ collection_name | capitalize_collection }}Service:
    return {{ collection_name | capitalize_collection }}Service({{ collection_name | capitalize_collection }}Repository(get_database()))


router = APIRouter(tags=["{{ collection_name | capitalize_collection }}"])

{% macro openapi_extra(route) %}{% if route.needs_auth and security_schemes %}, openapi_extra={"security": {{ security_schemes }}}{% endif %}{% endmacro %}
{% macro auth_param(route) %}{% if auth.enabled and route.needs_auth %}, principal: dict[str, Any] = Depends(require_principal){% endif %}{% endmacro %}

{# Emit pre-fetch authorization guards as inline compiled conditions. #}
{# Rules whose `when` references `document` are deferred to post-fetch. #}
{% macro pre_fetch_guard(route) %}
{% if auth.enabled and route.needs_auth and route.access_rules %}
{% set ns = namespace(has_doc_rule=false, identity_symbols=[]) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}
{% set ns.has_doc_rule = true %}
{% endif %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in ns.identity_symbols %}
{% set _ = ns.identity_symbols.append(symbol) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if not ns.has_doc_rule %}
{% set ns.first = true %}
{% set ns.has_conditionals = false %}
{% for rule in route.access_rules %}
{% if rule is unconditional %}
{% if rule.effect == "deny" %}
    raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% set ns.first = false %}
{% else %}
{% set ns.has_conditionals = true %}
{% set keyword = "if" if ns.first else "elif" %}
    {{ keyword }} {{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
        raise HTTPException(status_code=403, detail="Forbidden")
{% else %}
        pass
{% endif %}
{% set ns.first = false %}
{% endif %}
{% endfor %}
{% if ns.has_conditionals %}
    else:
        raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}

{# Emit post-fetch authorization guards for rules that reference the document. #}
{% macro post_fetch_guard(route, doc_var) %}
{% if auth.enabled and route.needs_auth and route.access_rules %}
{% set ns = namespace(has_doc_rule=false, document_symbols=[]) %}
{% for rule in route.access_rules %}
{% if rule is needs_document_rule %}
{% set ns.has_doc_rule = true %}
{% endif %}
{% for symbol in rule.document_symbols %}
{% if symbol not in ns.document_symbols %}
{% set _ = ns.document_symbols.append(symbol) %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns.has_doc_rule %}
{% for symbol in ns.document_symbols %}
    {{ symbol }} = {{ doc_var }}
{% endfor %}
{% set ns.first = true %}
{% for rule in route.access_rules %}
{% set rule_needs_doc = rule is needs_document_rule %}
{% set keyword = "if" if ns.first else "elif" %}
    {{ keyword }} {% if rule_needs_doc %}{{ doc_var }} is not None and {% endif %}{{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
        raise HTTPException(status_code=403, detail="Forbidden")
{% else %}
        pass
{% endif %}
{% set ns.first = false %}
{% endfor %}
{% if not ns.first %}
    else:
        raise HTTPException(status_code=403, detail="Forbidden")
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}

{% for route in crud_routes %}
{% if route.operation == "list" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def list_{{ collection_name }}({{ auth_param(route) | trim(chars=", ") }}) -> Any:
{{ pre_fetch_guard(route) }}
    return await _service().list()


{% elif route.operation == "get" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def get_{{ collection_name }}(id: str{{ auth_param(route) }}) -> Any:
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await _service().get(id)
{{ post_fetch_guard(route, "existing") }}
    return existing
{% else %}
    return await _service().get(id)
{% endif %}


{% elif route.operation == "create" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def create_{{ collection_name }}(payload: {{ route.body_model }}{{ auth_param(route) }}) -> Any:
{{ pre_fetch_guard(route) }}
    return await _service().create(payload.model_dump(exclude_unset=True))


{% elif route.operation == "update" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def update_{{ collection_name }}(id: str, payload: {{ route.body_model }}{{ auth_param(route) }}) -> Any:
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await _service().get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await _service().update(id, payload.model_dump(exclude_unset=True))


{% elif route.operation == "replace" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def replace_{{ collection_name }}(id: str, payload: {{ route.body_model }}{{ auth_param(route) }}) -> Any:
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await _service().get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await _service().replace(id, payload.model_dump(exclude_unset=True))


{% elif route.operation == "delete" %}
@router.{{ route.method | lower }}("{{ route.path }}"{{ openapi_extra(route) }})
async def delete_{{ collection_name }}(id: str{{ auth_param(route) }}) -> Any:
{{ pre_fetch_guard(route) }}
{% if route is needs_post_fetch %}
    existing = await _service().get(id)
{{ post_fetch_guard(route, "existing") }}
{% endif %}
    return await _service().delete(id)


{% endif %}
{% endfor %}
{% for route in custom_routes %}
{% set handler_name = route.operation ~ "_" ~ collection_name %}


@router.{{ route.method | lower }}("{{ route.path }}", tags=["{{ collection_name | capitalize_collection }}"])
async def {{ handler_name }}(request: Request) -> Any:
    from importlib import import_module
    module_path, func_name = "{{ route.handler }}".rsplit(".", 1)
    module = import_module(module_path)
    return await getattr(module, func_name)(request)
{% endfor %}
{% if is_mongo %}
{% for route in repo_op_routes %}
{% set handler_name = route.operation ~ "_" ~ collection_name %}
{% set query = repo_queries[route.operation] %}


@router.{{ route.method | lower }}("{{ route.path }}", tags=["{{ collection_name | capitalize_collection }}"])
async def {{ handler_name }}(request: Request) -> Any:
    repo = {{ collection_name | capitalize_collection }}Repository(get_database())
    return jsonable_encoder(await repo.{{ route.operation }}({% for key, value in (query or {}).items() if key != "command" %}{{ key }}={{ value | py_literal }}{% if not loop.last %}, {% endif %}{% endfor %}))
{% endfor %}
{% endif %}
