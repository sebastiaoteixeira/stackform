from typing import Any

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field

from dependencies.auth import verify_password
from dependencies.mongodb import get_database
{% if ctx.session.refresh %}
from dependencies.session_tokens import issue_session, rotate_session
{% else %}
from dependencies.session_tokens import issue_session
{% endif %}

router = APIRouter()

{% if ctx.session.refresh %}

class RefreshPayload(BaseModel):
    refresh_token: str = Field(..., min_length=1)

{% endif %}
{% for identity in auth.identity_collections %}
{% set pw_binding = identity.bindings | selectattr('provider', 'equalto', 'password') | first | default(none) %}
{% if pw_binding %}
{% set class_name = identity.name | capitalize_collection %}

class {{ class_name }}LoginPayload(BaseModel):
    {{ pw_binding.identifier }}: str = Field(..., min_length=1)
    password: str = Field(..., min_length=1)


@router.post("/{{ identity.name }}/login", tags=["{{ identity.name | capitalize_collection }}"])
async def login_{{ identity.name }}(payload: {{ class_name }}LoginPayload) -> Any:
    db = get_database()
    col = db["{{ identity.name }}"]
    cursor = col.find({})
    docs = await cursor.to_list(length=None)

    for doc in docs:
        if str(doc.get("{{ pw_binding.identifier }}", "")) != payload.{{ pw_binding.identifier }}:
            continue
        stored_hash = doc["_auth"]["passwordHash"]
        if not isinstance(stored_hash, str):
            continue
        if not verify_password(payload.password, stored_hash):
            continue

        subject = doc.get("{{ identity.id_field }}")
        if subject is None:
            continue

        safe_user = {
            k: v for k, v in doc.items()
            if k not in ("password", "_id", "_auth")
        }
        session = await issue_session(str(subject), "{{ identity.name }}")
        return {**session, "user": safe_user}

    raise HTTPException(status_code=401, detail="Invalid credentials")

{% if ctx.session.refresh %}

@router.post("/{{ identity.name }}/refresh", tags=["{{ identity.name | capitalize_collection }}"])
async def refresh_{{ identity.name }}(payload: RefreshPayload) -> Any:
    rotated = await rotate_session(payload.refresh_token)
    if rotated is None:
        raise HTTPException(status_code=401, detail="Invalid refresh token")
    return rotated

{% endif %}
{% endif %}
{% endfor %}
