from typing import Any

from fastapi import APIRouter, Depends, HTTPException
{% if ctx.session.uses_cookie %}
from fastapi import Request
from fastapi.responses import JSONResponse
{% endif %}
from pydantic import BaseModel, Field

from dependencies.auth import verify_password
{% if ctx.session.uses_cookie %}
{% if ctx.session.refresh %}
from dependencies.session_cookie import issue_csrf_token, refresh_token_from_request, set_session_cookies
{% else %}
from dependencies.session_cookie import issue_csrf_token, set_session_cookies
{% endif %}
{% endif %}
{% for identity in auth.identity_collections if identity.has_password %}
from dependencies.repositories import get_{{ identity.name }}_repository
{% endfor %}
{% if ctx.session.refresh %}
from dependencies.session_tokens import issue_session, rotate_session
{% else %}
from dependencies.session_tokens import issue_session
{% endif %}

router = APIRouter()

{% if ctx.session.refresh and not ctx.session.uses_cookie %}

class RefreshPayload(BaseModel):
    refresh_token: str = Field(..., min_length=1)

{% endif %}
{% for identity in auth.identity_collections %}
{% set pw_binding = identity.bindings | selectattr('provider', 'equalto', 'password') | first | default(none) %}
{% if pw_binding %}
{% set class_name = identity.name | capitalize_collection %}

class {{ class_name }}LoginPayload(BaseModel):
    {{ pw_binding.identifier }}: str = Field(..., min_length=1)
    password: str = Field(..., min_length=1)


@router.post("/{{ identity.name }}/login", tags=["{{ identity.name | capitalize_collection }}"])
async def login_{{ identity.name }}(payload: {{ class_name }}LoginPayload{% if ctx.session.uses_cookie %}, request: Request{% endif %}, repository=Depends(get_{{ identity.name }}_repository)) -> Any:
    doc = await repository.find_by(
        "{{ pw_binding.identifier }}", payload.{{ pw_binding.identifier }}
    )
    if doc is not None:
        auth_data = doc.get("_auth")
        stored_hash = auth_data.get("passwordHash") if isinstance(auth_data, dict) else None
        if isinstance(stored_hash, str) and verify_password(payload.password, stored_hash):
            subject = doc.get("{{ identity.id_field }}")
            if subject is not None:
                safe_user = {
                    k: v for k, v in doc.items()
                    if k not in ("password", "_id", "_auth")
                }
                session = await issue_session(str(subject), "{{ identity.name }}")
{% if ctx.session.uses_cookie %}
                csrf_token = issue_csrf_token()
                response = JSONResponse({"user": safe_user, "csrf_token": csrf_token})
                set_session_cookies(response, request, session["token"], csrf_token{% if ctx.session.refresh %}, session["refresh_token"]{% endif %})
                return response
{% else %}
                return {**session, "user": safe_user}
{% endif %}

    raise HTTPException(status_code=401, detail="Invalid credentials")

{% if ctx.session.refresh %}
{% if ctx.session.uses_cookie %}

@router.post("/{{ identity.name }}/refresh", tags=["{{ identity.name | capitalize_collection }}"])
async def refresh_{{ identity.name }}(request: Request) -> Any:
    presented = refresh_token_from_request(request)
    if presented is None:
        raise HTTPException(status_code=401, detail="Invalid refresh token")
    rotated = await rotate_session(presented)
    if rotated is None:
        raise HTTPException(status_code=401, detail="Invalid refresh token")
    csrf_token = issue_csrf_token()
    response = JSONResponse({"csrf_token": csrf_token})
    set_session_cookies(response, request, rotated["token"], csrf_token, rotated["refresh_token"])
    return response
{% else %}

@router.post("/{{ identity.name }}/refresh", tags=["{{ identity.name | capitalize_collection }}"])
async def refresh_{{ identity.name }}(payload: RefreshPayload) -> Any:
    rotated = await rotate_session(payload.refresh_token)
    if rotated is None:
        raise HTTPException(status_code=401, detail="Invalid refresh token")
    return rotated

{% endif %}
{% endif %}
{% endif %}
{% endfor %}
