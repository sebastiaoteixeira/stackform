{% for line in module.imports %}
{{ line }}
{% endfor %}
{% for declaration in module.declarations %}

{% if declaration.attributes is defined %}

class {{ declaration.name }}({{ declaration.base }}):
{% for attribute in declaration.attributes %}
    {{ attribute.name }}: {{ attribute.annotation }}{% if attribute.default is not none %} = {{ attribute.default }}{% endif %}

{% else %}
    pass
{% endfor %}
{% else %}

{{ declaration.name }} = partial({{ declaration.base }}, "{{ declaration.name }}")
{% endif %}
{% endfor %}
