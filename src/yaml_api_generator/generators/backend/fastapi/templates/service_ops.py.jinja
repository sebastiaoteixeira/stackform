from typing import Any

from services.exceptions import NotFoundError, ValidationError
{% if auth.has_password_auth or auth.has_api_key_auth %}
from dependencies.auth import {{ ([auth.has_password_auth and "hash_password", auth.has_api_key_auth and "hash_api_key"] | select | join(", ")) }}
{% endif %}


class ServiceBase:
    def __init__(self, repo: Any, principal: dict[str, Any] | None = None) -> None:
        self._repo = repo
        self._principal = principal

    @property
    def _name(self) -> str:
        return self._repo.COLLECTION

    @staticmethod
    def _strip_internal_fields(document: dict) -> None:
        for field_name in ("_auth", "password", "apiKey"):
            document.pop(field_name, None)

    async def _before_create(self, data: dict) -> None:
        """Hook invoked before create; override to validate or enrich data."""

    async def _after_create(self, document: dict) -> None:
        self._strip_internal_fields(document)

    async def _before_write(self, data: dict) -> None:
        """Hook invoked before create/update/replace; override for cross-cutting write logic."""

    async def _before_update(self, resource_id: str, data: dict) -> None:
        """Hook invoked before update; override to validate or enrich partial data."""

    async def _after_update(self, document: dict) -> None:
        self._strip_internal_fields(document)

    async def _before_replace(self, resource_id: str, data: dict) -> None:
        """Hook invoked before replace; override to validate the replacement payload."""

    async def _after_replace(self, document: dict) -> None:
        self._strip_internal_fields(document)

    async def _before_delete(self, resource_id: str) -> None:
        """Hook invoked before delete; override to enforce preconditions."""

    async def _after_delete(self, document: dict) -> None:
        self._strip_internal_fields(document)

    async def _after_get(self, document: dict) -> None:
        self._strip_internal_fields(document)

    async def _after_list(self, documents: list[dict]) -> None:
        for document in documents:
            self._strip_internal_fields(document)


class ListSvc:
    async def list(self, primitives: Any = None) -> Any:
        if primitives is None:
            documents = await self._repo.list()
            await self._after_list(documents)
            return documents
        page = await self._repo.paginate(primitives)
        await self._after_list(page.rows)
        return page


class GetSvc:
    async def get(self, resource_id: str) -> dict:
        document = await self._repo.get(resource_id)
        if document is None:
            raise NotFoundError(self._name, resource_id)
        await self._after_get(document)
        return document

    async def get_by(self, criteria: dict[str, Any]) -> dict:
        document = await self._repo.find_one(criteria)
        if document is None:
            raise NotFoundError(self._name, criteria)
        await self._after_get(document)
        return document


class CreateSvc:
    async def create(self, data: dict) -> dict:
        await self._before_create(data)
        await self._before_write(data)
        document = await self._repo.create(data)
        await self._after_create(document)
        return document


