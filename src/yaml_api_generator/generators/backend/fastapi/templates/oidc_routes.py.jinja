import time
{% if _pkce.used or _dpop.used %}
import base64
import hashlib
import secrets
{% endif %}
{% if _dpop.used %}
import json

import jwt
from cryptography.hazmat.primitives.asymmetric import ec
from jwt.algorithms import ECAlgorithm
{% endif %}
from typing import Any
from urllib.parse import urlencode

import httpx
from fastapi import APIRouter, Depends, HTTPException, Request
from fastapi.responses import RedirectResponse

from dependencies.claims import resolve_claim_path, resolve_relations
from dependencies.jwt_utils import create_jwt_token
from dependencies.login_codes import (
    issue_login_code,
    redeem_login_code,
)
{% set _all_repo_cols = (_app_oidc_cols + _relation_target_cols) | unique | list %}
{% for name in _all_repo_cols %}
from dependencies.repositories import get_{{ name }}_repository
{% endfor %}
from settings import settings

router = APIRouter()

{% if _dpop.used %}
_dpop_private_key = ec.generate_private_key(ec.SECP256R1())
_dpop_jwk = json.loads(ECAlgorithm.to_jwk(_dpop_private_key.public_key()))


def _dpop_proof(method: str, url: str, access_token: str | None = None) -> str:
    payload: dict[str, Any] = {
        "jti": secrets.token_urlsafe(16),
        "htm": method,
        "htu": url.split("?", 1)[0],
        "iat": int(time.time()),
    }
    if access_token is not None:
        payload["ath"] = base64.urlsafe_b64encode(
            hashlib.sha256(access_token.encode()).digest()
        ).rstrip(b"=").decode()
    return jwt.encode(
        payload,
        _dpop_private_key,
        algorithm="ES256",
        headers={"typ": "dpop+jwt", "jwk": _dpop_jwk},
    )

{% endif %}

@router.post("/auth/exchange")
async def exchange_login_code(payload: dict[str, str]) -> dict[str, str]:
    code = payload.get("code")
    if not code:
        raise HTTPException(status_code=400, detail="Missing code")
    redeemed = await redeem_login_code(code)
    if redeemed is None:
        raise HTTPException(status_code=401, detail="Invalid or expired code")
    subject, identity_collection, _ = redeemed
    return {"token": create_jwt_token(subject, identity_collection)}

