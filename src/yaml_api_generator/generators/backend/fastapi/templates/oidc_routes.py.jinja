{% import "external_login.jinja" as login %}
{% set _bound = [] %}
{% set _pkce = namespace(used=false) %}
{% set _dpop_providers = [] %}
{% for col in auth.identity_collections %}
{% for binding in col.bindings %}
{% set _p = auth.providers.get(binding.provider) %}
{% if _p and _p.type == "oidc" and not _p.is_idp %}
{% set _ = _bound.append((col, binding, _p)) %}
{% if _p.pkce %}{% set _pkce.used = true %}{% endif %}
{% if _p.dpop and binding.provider not in _dpop_providers %}{% set _ = _dpop_providers.append(binding.provider) %}{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
import time
import secrets
{% if _pkce.used %}
import base64
import hashlib
{% endif %}
from typing import Any
from urllib.parse import urlencode

import httpx
from fastapi import APIRouter, Depends, HTTPException, Request
from fastapi.responses import RedirectResponse

from dependencies.claims import resolve_claim_path, resolve_relations
{% if _dpop_providers %}
from dependencies.dpop import DPoPProofFactory, request_with_dpop
{% endif %}
from dependencies.login_codes import issue_login_code
{{ login.repository_imports(_bound) -}}
from settings import settings

router = APIRouter()

{% for provider_name in _dpop_providers %}
_{{ provider_name | py_identifier }}_dpop = DPoPProofFactory.from_pem(
    settings.{{ provider_name | py_identifier | upper }}_DPOP_PRIVATE_KEY.get_secret_value()
)
{% endfor %}

{{ login.frontend_url() }}
{% for col, binding, provider in _bound %}
{% set provider_name = binding.provider %}
{% set sym = (col.name ~ "_" ~ provider_name) | py_identifier %}

_{{ sym }}_discovery: dict[str, Any] | None = None


async def _get_{{ sym }}_discovery() -> dict[str, Any]:
    global _{{ sym }}_discovery
    if _{{ sym }}_discovery is None:
        async with httpx.AsyncClient() as client:
            resp = await client.get({{ provider.discovery_url | py_literal }})
            resp.raise_for_status()
            _{{ sym }}_discovery = resp.json()
    return _{{ sym }}_discovery


@router.get("/{{ col.name }}/auth/{{ provider_name }}")
async def oidc_{{ sym }}_login(request: Request) -> RedirectResponse:
    discovery = await _get_{{ sym }}_discovery()
    auth_endpoint = discovery["authorization_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"
    params = {
        "client_id": "{{ provider.client_id }}",
        "redirect_uri": callback_url,
        "response_type": "code",
        "scope": "openid email profile",
    }
    state = secrets.token_urlsafe(32)
    params["state"] = state
{% if provider.pkce %}
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    params["code_challenge"] = challenge
    params["code_challenge_method"] = "S256"
{% endif %}
    response = RedirectResponse(url=f"{auth_endpoint}?{urlencode(params)}")
    response.set_cookie(
        "{{ sym }}_state",
        state,
        max_age=300,
        httponly=True,
        secure=request.url.scheme == "https",
        samesite="lax",
        path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback",
    )
{% if provider.pkce %}
    response.set_cookie(
        "{{ sym }}_pkce_verifier",
        verifier,
        max_age=300,
        httponly=True,
        secure=request.url.scheme == "https",
        samesite="lax",
        path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback",
    )
{% endif %}
    return response


@router.get("/{{ col.name }}/auth/{{ provider_name }}/callback")
async def oidc_{{ sym }}_callback(request: Request, code: str, state: str | None = None, {{ login.repository_params(col, binding) }}) -> RedirectResponse:
    expected_state = request.cookies.get("{{ sym }}_state")
    if not state or not expected_state or not secrets.compare_digest(state, expected_state):
        raise HTTPException(status_code=400, detail="Invalid OIDC state")
{% if provider.pkce %}
    verifier = request.cookies.get("{{ sym }}_pkce_verifier")
    if not verifier:
        raise HTTPException(status_code=400, detail="Missing PKCE verifier")
{% endif %}
    discovery = await _get_{{ sym }}_discovery()
    token_endpoint = discovery["token_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"

    async with httpx.AsyncClient() as client:
        _token_data = {
            "grant_type": "authorization_code",
            "code": code,
            "redirect_uri": callback_url,
            "client_id": "{{ provider.client_id }}",
        }
        {% if provider.client_secret %}
        _token_data["client_secret"] = settings.{{ provider_name | py_identifier | upper }}_CLIENT_SECRET.get_secret_value()
        {% endif %}
        {% if provider.pkce %}
        _token_data["code_verifier"] = verifier
        {% endif %}
        {% if provider.dpop %}
        token_resp = await request_with_dpop(
            client,
            "POST",
            token_endpoint,
            _{{ provider_name | py_identifier }}_dpop,
            data=_token_data,
        )
        {% else %}
        token_resp = await client.post(token_endpoint, data=_token_data)
        {% endif %}
        if token_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Token exchange failed")
        token_data = token_resp.json()
        {% if provider.dpop %}
        if token_data.get("token_type", "").lower() != "dpop":
            raise HTTPException(status_code=401, detail="Provider did not issue a DPoP-bound token")
        {% endif %}

        {% if provider_name == "github" %}
        {% if provider.dpop %}
        userinfo_resp = await request_with_dpop(
            client,
            "GET",
            "https://api.github.com/user",
            _{{ provider_name | py_identifier }}_dpop,
            access_token=token_data["access_token"],
            headers={
                "Authorization": f"DPoP {token_data['access_token']}",
            },
        )
        {% else %}
        userinfo_resp = await client.get(
            "https://api.github.com/user",
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% endif %}
        {% else %}
        userinfo_endpoint = discovery.get("userinfo_endpoint", "")
        {% if provider.dpop %}
        userinfo_resp = await request_with_dpop(
            client,
            "GET",
            userinfo_endpoint,
            _{{ provider_name | py_identifier }}_dpop,
            access_token=token_data["access_token"],
            headers={
                "Authorization": f"DPoP {token_data['access_token']}",
            },
        )
        {% else %}
        userinfo_resp = await client.get(
            userinfo_endpoint,
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% endif %}
        {% endif %}
        if userinfo_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Failed to fetch user info")
        claims = userinfo_resp.json()

    exp = claims.get("exp")
    if exp is not None and int(exp) < int(time.time()):
        raise HTTPException(status_code=401, detail="Token expired")

{{ login.sign_in(col, binding, sym) }}
    response.delete_cookie("{{ sym }}_state", path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback")
{% if provider.pkce %}
    response.delete_cookie("{{ sym }}_pkce_verifier", path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback")
{% endif %}
    return response


@router.get("/{{ col.name }}/auth/{{ provider_name }}/logout")
async def oidc_{{ sym }}_logout(request: Request) -> RedirectResponse:
    discovery = await _get_{{ sym }}_discovery()
    end_session = discovery.get("end_session_endpoint")
    if not end_session:
        raise HTTPException(status_code=501, detail="Provider does not support end-session logout")
    params = {"client_id": "{{ provider.client_id }}", "post_logout_redirect_uri": _frontend_url(request)}
    return RedirectResponse(url=f"{end_session}?{urlencode(params)}")
{% endfor %}
