{% for binding in col.bindings %}
{% set _p = auth.providers.get(binding.provider) %}
{% if _p and _p.type == "oidc" and not _p.is_idp %}
{% if _p.pkce %}{% set _pkce.used = true %}{% endif %}
{% if _p.dpop %}
{% set _dpop.used = true %}
{% if binding.provider not in _dpop_providers %}{% set _ = _dpop_providers.append(binding.provider) %}{% endif %}
{% endif %}
{% if col.name not in _app_oidc_cols %}{% set _ = _app_oidc_cols.append(col.name) %}{% endif %}
{% for rel in binding.relations %}
{% if rel.collection not in _relation_target_cols %}{% set _ = _relation_target_cols.append(rel.collection) %}{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
import time
import secrets
{% if _pkce.used %}
import base64
import hashlib
{% endif %}
from typing import Any
from urllib.parse import urlencode

import httpx
from fastapi import APIRouter, Depends, HTTPException, Request
from fastapi.responses import {% if ctx.session.uses_cookie %}JSONResponse, {% endif %}RedirectResponse

from dependencies.claims import resolve_claim_path, resolve_relations
{% if _dpop.used %}
from dependencies.dpop import DPoPProofFactory, request_with_dpop
{% endif %}
from dependencies.session_tokens import issue_session
{% if ctx.session.uses_cookie %}
from dependencies.session_cookie import issue_csrf_token, set_session_cookies
{% endif %}
from dependencies.login_codes import (
    issue_login_code,
    redeem_login_code,
)
{% set _all_repo_cols = (_app_oidc_cols + _relation_target_cols) | unique | list %}
{% for name in _all_repo_cols %}
from dependencies.repositories import get_{{ name }}_repository
{% endfor %}
from settings import settings

router = APIRouter()

{% if _dpop.used %}
{% for provider_name in _dpop_providers %}
_{{ provider_name | py_identifier }}_dpop = DPoPProofFactory.from_pem(
    settings.{{ provider_name | py_identifier | upper }}_DPOP_PRIVATE_KEY.get_secret_value()
)
{% endfor %}
{% endif %}

@router.post("/auth/exchange")
async def exchange_login_code(request: Request, payload: dict[str, str]) -> Any:
    code = payload.get("code")
    if not code:
        raise HTTPException(status_code=400, detail="Missing code")
    redeemed = await redeem_login_code(code)
    if redeemed is None:
        raise HTTPException(status_code=401, detail="Invalid or expired code")
    subject, identity_collection, _ = redeemed
    session = await issue_session(subject, identity_collection)
{% if ctx.session.uses_cookie %}
    csrf_token = issue_csrf_token()
    response = JSONResponse({"csrf_token": csrf_token})
    set_session_cookies(response, request, session["token"], csrf_token{% if ctx.session.refresh %}, session["refresh_token"]{% endif %})
    return response
{% else %}
    return session
{% endif %}

{% for col in auth.identity_collections %}
{% set ext_providers = [] %}
{% for binding in col.bindings %}
{% set _p = auth.providers.get(binding.provider) %}
{% if _p and not _p.is_idp %}
{% set _ = ext_providers.append({"name": binding.provider, "type": _p.type}) %}
{% endif %}
{% endfor %}
{% if ext_providers %}

@router.get("/{{ col.name }}/auth/providers")
async def list_{{ col.name }}_auth_providers() -> list[dict[str, str]]:
    return {{ ext_providers | tojson }}
{% endif %}
