import os
import time
from typing import Any
from urllib.parse import urlencode, quote

import httpx
from fastapi import APIRouter, HTTPException, Request
from fastapi.responses import RedirectResponse

from dependencies.mongodb import get_database
from dependencies.jwt_utils import create_jwt_token

router = APIRouter()

FRONTEND_URL = os.environ.get("FRONTEND_URL", "")

{% for col in auth.identity_collections %}
{% set ext_providers = [] %}
{% for binding in col.bindings %}
{% set _p = auth.providers.get(binding.provider) %}
{% if _p %}
{% set _ = ext_providers.append({"name": binding.provider, "type": _p.type}) %}
{% endif %}
{% endfor %}
{% if ext_providers %}

@router.get("/{{ col.name }}/auth/providers")
async def list_{{ col.name }}_auth_providers() -> list[dict[str, str]]:
    return {{ ext_providers | tojson }}
{% endif %}
{% endfor %}

{% for col in auth.identity_collections %}
{% for binding in col.bindings %}
{% set provider = auth.providers.get(binding.provider) %}
{% if provider and provider.type == "oidc" %}
{% set provider_name = binding.provider %}

_{{ col.name }}_{{ provider_name }}_discovery: dict[str, Any] | None = None


async def _get_{{ col.name }}_{{ provider_name }}_discovery() -> dict[str, Any]:
    global _{{ col.name }}_{{ provider_name }}_discovery
    if _{{ col.name }}_{{ provider_name }}_discovery is None:
        async with httpx.AsyncClient() as client:
            resp = await client.get("{{ provider.discovery_url }}")
            resp.raise_for_status()
            _{{ col.name }}_{{ provider_name }}_discovery = resp.json()
    return _{{ col.name }}_{{ provider_name }}_discovery


@router.get("/{{ col.name }}/auth/{{ provider_name }}")
async def oidc_{{ col.name }}_{{ provider_name }}_login(request: Request) -> RedirectResponse:
    discovery = await _get_{{ col.name }}_{{ provider_name }}_discovery()
    auth_endpoint = discovery["authorization_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"
    params = {
        "client_id": "{{ provider.client_id }}",
        "redirect_uri": callback_url,
        "response_type": "code",
        "scope": "openid email profile",
    }
    return RedirectResponse(url=f"{auth_endpoint}?{urlencode(params)}")


@router.get("/{{ col.name }}/auth/{{ provider_name }}/callback")
async def oidc_{{ col.name }}_{{ provider_name }}_callback(request: Request, code: str) -> Any:
    discovery = await _get_{{ col.name }}_{{ provider_name }}_discovery()
    token_endpoint = discovery["token_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"

    async with httpx.AsyncClient() as client:
        token_resp = await client.post(token_endpoint, data={
            "grant_type": "authorization_code",
            "code": code,
            "redirect_uri": callback_url,
            "client_id": "{{ provider.client_id }}",
            "client_secret": "{{ provider.client_secret }}",
        })
        if token_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Token exchange failed")
        token_data = token_resp.json()

        {% if provider_name == "github" %}
        # GitHub does not implement OIDC — fetch user info from its own endpoint
        userinfo_resp = await client.get(
            "https://api.github.com/user",
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% else %}
        userinfo_endpoint = discovery.get("userinfo_endpoint", "")
        userinfo_resp = await client.get(
            userinfo_endpoint,
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% endif %}
        if userinfo_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Failed to fetch user info")
        claims = userinfo_resp.json()

    exp = claims.get("exp")
    if exp is not None and int(exp) < int(time.time()):
        raise HTTPException(status_code=401, detail="Token expired")

    claim_mapping: dict[str, str] = {{ binding.claim_mapping | tojson }}
    user_fields: dict[str, Any] = {}
    for local_field, oidc_claim in claim_mapping.items():
        if oidc_claim in claims:
            user_fields[local_field] = claims[oidc_claim]

    if "{{ binding.identifier }}" not in user_fields:
        user_fields["{{ binding.identifier }}"] = claims.get("email") or claims.get("login") or claims.get("sub")

    db = get_database()
    collection = db["{{ col.name }}"]

    existing = await collection.find_one({"{{ binding.identifier }}": user_fields.get("{{ binding.identifier }}")})

    frontend_url = FRONTEND_URL or str(request.base_url).rstrip("/")

    if existing is not None:
        subject = existing.get("{{ col.id_field }}")
        token = create_jwt_token(str(subject), "{{ col.name }}")
        return RedirectResponse(url=f"{frontend_url}/auth/callback?token={quote(token)}")

    {% if binding.auto_provision %}
    import uuid as _uuid
    new_id = str(_uuid.uuid4())
    user_fields["{{ col.id_field }}"] = new_id
    await collection.insert_one(user_fields)
    token = create_jwt_token(new_id, "{{ col.name }}")
    return RedirectResponse(url=f"{frontend_url}/auth/callback?token={quote(token)}")
    {% else %}
    raise HTTPException(status_code=403, detail="User not found and auto-provisioning is disabled")
    {% endif %}

{% endif %}
{% endfor %}
{% endfor %}
