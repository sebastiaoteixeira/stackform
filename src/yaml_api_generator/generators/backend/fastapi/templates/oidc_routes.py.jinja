{% for col in auth.identity_collections %}
{% for binding in col.bindings %}
{% set provider = auth.providers.get(binding.provider) %}
{% if provider and provider.type == "oidc" and not provider.is_idp %}
{% set provider_name = binding.provider %}
{% set sym = (col.name ~ "_" ~ provider_name) | py_identifier %}

_{{ sym }}_discovery: dict[str, Any] | None = None


async def _get_{{ sym }}_discovery() -> dict[str, Any]:
    global _{{ sym }}_discovery
    if _{{ sym }}_discovery is None:
        async with httpx.AsyncClient() as client:
            resp = await client.get({{ provider.discovery_url | py_literal }})
            resp.raise_for_status()
            _{{ sym }}_discovery = resp.json()
    return _{{ sym }}_discovery


@router.get("/{{ col.name }}/auth/{{ provider_name }}")
async def oidc_{{ sym }}_login(request: Request) -> RedirectResponse:
    discovery = await _get_{{ sym }}_discovery()
    auth_endpoint = discovery["authorization_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"
    params = {
        "client_id": "{{ provider.client_id }}",
        "redirect_uri": callback_url,
        "response_type": "code",
        "scope": "openid email profile",
    }
    state = secrets.token_urlsafe(32)
    params["state"] = state
{% if provider.pkce %}
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    params["code_challenge"] = challenge
    params["code_challenge_method"] = "S256"
{% endif %}
    response = RedirectResponse(url=f"{auth_endpoint}?{urlencode(params)}")
    response.set_cookie(
        "{{ sym }}_state",
        state,
        max_age=300,
        httponly=True,
        secure=request.url.scheme == "https",
        samesite="lax",
        path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback",
    )
{% if provider.pkce %}
    response.set_cookie(
        "{{ sym }}_pkce_verifier",
        verifier,
        max_age=300,
        httponly=True,
        secure=request.url.scheme == "https",
        samesite="lax",
        path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback",
    )
{% endif %}
    return response


{% set _binding_target_cols = [] %}
{% for rel in binding.relations %}
{% if rel.collection not in _binding_target_cols and rel.collection != col.name %}{% set _ = _binding_target_cols.append(rel.collection) %}{% endif %}
{% endfor %}
@router.get("/{{ col.name }}/auth/{{ provider_name }}/callback")
async def oidc_{{ sym }}_callback(request: Request, code: str, state: str | None = None, repo=Depends(get_{{ col.name }}_repository){% for target_col in _binding_target_cols %}, {{ target_col }}_repo=Depends(get_{{ target_col }}_repository){% endfor %}) -> Any:
    expected_state = request.cookies.get("{{ sym }}_state")
    if not state or not expected_state or not secrets.compare_digest(state, expected_state):
        raise HTTPException(status_code=400, detail="Invalid OIDC state")
{% if provider.pkce %}
    verifier = request.cookies.get("{{ sym }}_pkce_verifier")
    if not verifier:
        raise HTTPException(status_code=400, detail="Missing PKCE verifier")
{% endif %}
    discovery = await _get_{{ sym }}_discovery()
    token_endpoint = discovery["token_endpoint"]
    callback_url = str(request.base_url).rstrip("/") + "{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback"

    async with httpx.AsyncClient() as client:
        _token_data = {
            "grant_type": "authorization_code",
            "code": code,
            "redirect_uri": callback_url,
            "client_id": "{{ provider.client_id }}",
        }
        {% if provider.client_secret %}
        _token_data["client_secret"] = settings.{{ provider_name | upper }}_CLIENT_SECRET.get_secret_value()
        {% endif %}
        {% if provider.pkce %}
        _token_data["code_verifier"] = verifier
        {% endif %}
        {% if provider.dpop %}
        token_resp = await request_with_dpop(
            client,
            "POST",
            token_endpoint,
            _{{ provider_name | py_identifier }}_dpop,
            data=_token_data,
        )
        {% else %}
        token_resp = await client.post(token_endpoint, data=_token_data)
        {% endif %}
        if token_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Token exchange failed")
        token_data = token_resp.json()
        {% if provider.dpop %}
        if token_data.get("token_type", "").lower() != "dpop":
            raise HTTPException(status_code=401, detail="Provider did not issue a DPoP-bound token")
        {% endif %}

        {% if provider_name == "github" %}
        {% if provider.dpop %}
        userinfo_resp = await request_with_dpop(
            client,
            "GET",
            "https://api.github.com/user",
            _{{ provider_name | py_identifier }}_dpop,
            access_token=token_data["access_token"],
            headers={
                "Authorization": f"DPoP {token_data['access_token']}",
            },
        )
        {% else %}
        userinfo_resp = await client.get(
            "https://api.github.com/user",
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% endif %}
        {% else %}
        userinfo_endpoint = discovery.get("userinfo_endpoint", "")
        {% if provider.dpop %}
        userinfo_resp = await request_with_dpop(
            client,
            "GET",
            userinfo_endpoint,
            _{{ provider_name | py_identifier }}_dpop,
            access_token=token_data["access_token"],
            headers={
                "Authorization": f"DPoP {token_data['access_token']}",
            },
        )
        {% else %}
        userinfo_resp = await client.get(
            userinfo_endpoint,
            headers={"Authorization": f"Bearer {token_data['access_token']}"},
        )
        {% endif %}
        {% endif %}
        if userinfo_resp.status_code != 200:
            raise HTTPException(status_code=401, detail="Failed to fetch user info")
        claims = userinfo_resp.json()

    exp = claims.get("exp")
    if exp is not None and int(exp) < int(time.time()):
        raise HTTPException(status_code=401, detail="Token expired")

    claim_mapping: dict[str, str] = {{ binding.claim_mapping | tojson }}
    user_fields: dict[str, Any] = {
        local_field: resolved
        for local_field, oidc_claim in claim_mapping.items()
        if (resolved := resolve_claim_path(claims, oidc_claim)) is not None
    }

    if "{{ binding.identifier }}" not in user_fields:
        user_fields["{{ binding.identifier }}"] = claims.get("email") or claims.get("login") or claims.get("sub")

{% set _relations_json = binding.relations_data | tojson %}
{% if binding.relations %}
    _repo_by_collection: dict[str, Any] = {"{{ col.name }}": repo{% for target_col in _binding_target_cols %}, "{{ target_col }}": {{ target_col }}_repo{% endfor %}}

    async def _lookup_{{ sym }}(coll: str, query: dict) -> dict | None:
        target_repo = _repo_by_collection[coll]
        if len(query) == 1:
            field, value = next(iter(query.items()))
            return await target_repo.find_by(field, value)
        records = await target_repo.list()
        return next((r for r in records if all(r.get(f) == v for f, v in query.items())), None)

    _fk_fields = await resolve_relations(claims, {{ _relations_json }}, _lookup_{{ sym }})
{% else %}
    _fk_fields: dict[str, Any] = {}
{% endif %}

    frontend_url = settings.FRONTEND_URL or str(request.base_url).rstrip("/")

{% if binding.auto_provision %}
    record = await repo.upsert_by("{{ binding.identifier }}", {**user_fields, **_fk_fields})
    subject = record.get("{{ col.id_field }}")
{% else %}
    existing = await repo.find_by("{{ binding.identifier }}", user_fields.get("{{ binding.identifier }}"))
    if existing is None:
        raise HTTPException(status_code=403, detail="User not found and auto-provisioning is disabled")
{% if binding.relations %}
    if _fk_fields:
        await repo.update(existing.get("{{ col.id_field }}"), _fk_fields)
{% endif %}
    subject = existing.get("{{ col.id_field }}")
{% endif %}

    code = await issue_login_code(str(subject), "{{ col.name }}", "{{ 'sql' if col.is_sql else 'mongo' }}")
    response = RedirectResponse(url=f"{frontend_url}/auth/callback?code={code}")
    response.delete_cookie("{{ sym }}_state", path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback")
{% if provider.pkce %}
    response.delete_cookie("{{ sym }}_pkce_verifier", path="{{ base_prefix }}/{{ col.name }}/auth/{{ provider_name }}/callback")
{% endif %}
    return response


@router.get("/{{ col.name }}/auth/{{ provider_name }}/logout")
async def oidc_{{ sym }}_logout(request: Request) -> RedirectResponse:
    discovery = await _get_{{ sym }}_discovery()
    end_session = discovery.get("end_session_endpoint")
    if not end_session:
        raise HTTPException(status_code=501, detail="Provider does not support end-session logout")
    post_logout = settings.FRONTEND_URL or str(request.base_url).rstrip("/")
    params = {"client_id": "{{ provider.client_id }}", "post_logout_redirect_uri": post_logout}
    return RedirectResponse(url=f"{end_session}?{urlencode(params)}")

{% endif %}
{% endfor %}
{% endfor %}
