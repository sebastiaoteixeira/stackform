{% from "handler_call.jinja" import call_with_request %}
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Request

from dependencies.handler_requests import HandlerRequest, invoke
from dependencies.service_inputs import prepare_service_inputs, resolve_access_bind
{% set ns_where = namespace(collections=[]) %}
{% for route in routes %}{% for where_collection in route.where_collections %}
{% if where_collection not in ns_where.collections %}{% set _ = ns_where.collections.append(where_collection) %}{% endif %}
{% endfor %}{% endfor %}
{% for where_collection in ns_where.collections %}
from dependencies.repositories import get_{{ where_collection }}_repository
{% endfor %}
{% if routes | selectattr("needs_auth") | list %}
from dependencies.auth import require_principal
{% endif %}
{% if routes | selectattr("access_rules") | list %}
from dependencies.authorization import _principal_has_role, _values_equal
{% endif %}


router = APIRouter(tags=["Handlers"])

{% for route in routes %}
@router.{{ route.method | lower }}("{{ route.relative_path }}")
async def {{ route.operation | py_identifier }}_{{ loop.index }}(
    request: Request{% if route.needs_auth %}, principal: dict[str, Any] = Depends(require_principal){% endif %}{% for where_collection in route.where_collections %}, _where_{{ where_collection }}_repo=Depends(get_{{ where_collection }}_repository){% endfor %}
) -> Any:
    body: dict[str, Any] = {}
    try:
        body = await request.json()
    except (UnicodeDecodeError, ValueError):
        pass
{% if route.access_rules %}
    _request_body = body
    _request_path = dict(request.path_params)
    _request_query = dict(request.query_params)
    _request_header = dict(request.headers)
    _request_cookie = dict(request.cookies)
{% set ns_symbols = namespace(identity=[], request=[]) %}
{% for rule in route.access_rules %}
{% for symbol in rule.identity_symbols %}
{% if symbol not in ns_symbols.identity %}{% set _ = ns_symbols.identity.append(symbol) %}{% endif %}
{% endfor %}
{% for symbol in rule.request_symbols %}
{% if symbol.name not in (ns_symbols.request | map(attribute="name") | list) %}{% set _ = ns_symbols.request.append(symbol) %}{% endif %}
{% endfor %}
{% endfor %}
{% for symbol in ns_symbols.identity %}
    {{ symbol }} = principal
{% endfor %}
{% for symbol in ns_symbols.request %}
    {{ symbol | request_symbol_binding }}
{% endfor %}
    _access_granted = False
    _access_bindings = {}
{% for rule in route.access_rules %}
    if not _access_granted:
{% for binding in rule.document_bindings %}
        {{ binding.name }} = await _where_{{ binding.collection }}_repo.find_one(
            resolve_access_bind({{ binding.where | py_literal }}, {**dict(request.path_params), **locals()})
        )
{% endfor %}
        if {% for binding in rule.document_bindings %}{{ binding.name }} is not None and {% endfor %}{{ rule | rule_to_python }}:
{% if rule.effect == "deny" %}
            raise HTTPException(status_code=403, detail={{ (rule.reason or "Forbidden") | py_literal }})
{% else %}
            _access_granted = True
            _access_bindings = {{ rule.bind | py_literal }}
{% endif %}
{% endfor %}
    if not _access_granted:
        raise HTTPException(status_code=403, detail="Forbidden")
    bound_inputs = resolve_access_bind(_access_bindings, locals())
{% else %}
    bound_inputs = {}
{% endif %}
    try:
        service_inputs = prepare_service_inputs(
            dict(request.path_params),
            body,
            {{ route.service_input | py_literal }},
            {{ route.service_forwarding | py_literal }},
            bound_inputs,
        )
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=str(exc)) from exc
{{ call_with_request("invoke(" ~ (route.handler | py_literal) ~ ", _request)", "principal" if route.needs_auth else "None", "body", "service_inputs") }}

{% endfor %}
