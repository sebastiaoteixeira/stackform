async def _resolve_idp_principal(bearer_token: str) -> dict[str, Any]:
    token_issuer = idp_auth.unverified_issuer(bearer_token)
    provider_meta = await _find_idp_provider_for_issuer(token_issuer) if token_issuer else None
    if provider_meta is None:
        raise HTTPException(status_code=401, detail="Untrusted token issuer")

    audiences = provider_meta["audiences"] or [provider_meta["client_id"]]
    claims = await idp_auth.verify_idp_token(
        bearer_token,
        discovery_url=provider_meta["discovery_url"],
        client_id=provider_meta["client_id"],
        issuer=provider_meta["issuer"],
        audiences=audiences,
    )
    if claims is None:
        raise HTTPException(status_code=401, detail="Invalid IdP token")

    sign_in = next((s for s in _IDP_SIGN_INS if s.binding.provider == provider_meta["name"]), None)
    if sign_in is None:
        raise HTTPException(status_code=401, detail="Untrusted token issuer")
    binding = sign_in.binding
    sub = str(claims["sub"])
    roles = _roles_from_claims(claims, sign_in.roles_claim)
    if resolve_claim_path(claims, binding.claim_mapping.get(binding.identifier, binding.identifier)) is None:
        return {
            "sub": sub,
            "client_id": claims.get("azp") or claims.get("client_id") or sub,
            "is_service": True,
            "roles": roles,
            "record": None,
            "identity_collection": None,
        }
    try:
        record = await binding.sign_in(claims, repository, sign_in.collection, sign_in.id_field)
    except (SignInRefused, ConflictError) as error:
        raise HTTPException(status_code=401, detail=str(error)) from error
    if record is None:
        raise HTTPException(status_code=401, detail="User not found and auto-provisioning is disabled")
    return {"sub": sub, "identity_collection": sign_in.collection, "record": record, "roles": roles}

{% endif %}

async def resolve_principal(
    request: Request,
    repositories: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    repositories = repositories or {}
    pre_resolved = getattr(request.state, "principal", None)
    if pre_resolved is not None:
        return pre_resolved

    headers = {k.lower(): v for k, v in request.headers.items()}
    bearer_token = _extract_bearer_token(headers)
{% if ctx is defined and ctx.session.uses_cookie %}
    if bearer_token is None:
        bearer_token = session_token_from_request(request)
{% endif %}

{% if auth.has_idp_auth %}
    if bearer_token is not None and idp_auth.unverified_issuer(bearer_token) is not None:
        return await _resolve_idp_principal(bearer_token)
{% endif %}

{% if auth.uses_jwt %}
    if bearer_token is not None:
        claims = decode_jwt_token(bearer_token)
        if claims is not None:
            sub = claims.get("sub")
            collection_name = claims.get("identity_collection")
            if sub and collection_name:
                repository = repositories.get(collection_name)
{% for identity in auth.identity_collections %}
{% if identity.issues_jwt %}
                if collection_name == "{{ identity.name }}" and repository is not None:
                    doc = await repository.find_by("{{ identity.id_field }}", sub)
                    if doc is not None:
                        return {"sub": sub, "identity_collection": collection_name, "record": doc, "roles": _extract_roles(doc, {{ identity.roles_field | py_literal }}, {{ (identity.roles is not none) | py_literal }})}
{% endif %}
{% endfor %}
{% endif %}

{% for identity in auth.identity_collections %}
{% if identity.has_api_key %}
    token = _extract_api_key(headers)
    if token is not None:
        doc = await repositories["{{ identity.name }}"].find_by("apiKey", token)
        if doc is not None:
            subject = doc.get("{{ identity.id_field }}")
            if subject is not None:
                return {"sub": str(subject), "identity_collection": "{{ identity.name }}", "record": doc, "roles": _extract_roles(doc, {{ identity.roles_field | py_literal }}, {{ (identity.roles is not none) | py_literal }})}
{% endif %}
{% set pw_binding = identity.bindings | selectattr('provider', 'equalto', 'password') | first | default(none) %}
{% if pw_binding %}
    credentials = _extract_basic_credentials(headers)
    if credentials is not None:
        identifier_value, password = credentials
        doc = await repositories["{{ identity.name }}"].find_by(
            "{{ pw_binding.identifier }}", identifier_value
        )
        if doc is not None:
            auth_data = doc.get("_auth")
            stored_hash = auth_data.get("passwordHash") if isinstance(auth_data, dict) else None
            if isinstance(stored_hash, str) and verify_password(password, stored_hash):
                subject = doc.get("{{ identity.id_field }}")
                if subject is not None:
                    return {"sub": str(subject), "identity_collection": "{{ identity.name }}", "record": doc, "roles": _extract_roles(doc, {{ identity.roles_field | py_literal }}, {{ (identity.roles is not none) | py_literal }})}
{% endif %}
{% endfor %}

    return None


async def get_optional_principal(
    request: Request,
{% for identity in auth.identity_collections %}
    {{ identity.name }}_repository=Depends(get_{{ identity.name }}_repository),
{% endfor %}
) -> dict[str, Any] | None:
    repositories = {
{% for identity in auth.identity_collections %}
        "{{ identity.name }}": {{ identity.name }}_repository,
{% endfor %}
    }
    return await resolve_principal(request, repositories=repositories)


async def require_principal(
    principal: dict[str, Any] | None = Depends(get_optional_principal),
) -> dict[str, Any]:
    if principal is None:
        raise HTTPException(status_code=401, detail="Unauthorized")
    return principal
