{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaml-spec-v0.3.schema.json",
  "title": "YAML API Generator Structure Spec v0.3",
  "$comment": "Extends v0.2 with files, pagination, service input:/with:, the where binding form and access-rule bind:. Definitions v0.3 leaves unchanged are referenced from v0.2.",
  "type": "object",
  "required": [
    "version",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "0.3"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePath": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "operations": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/ApiOperations"
        },
        "cors": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/CorsConfig"
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSize": {
              "$ref": "#/$defs/FileSize"
            },
            "types": {
              "$ref": "#/$defs/MimeTypes"
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "package"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "requires": {
            "$ref": "yaml-spec-v0.2.schema.json#/$defs/StringList"
          }
        }
      }
    },
    "mongo": {
      "$ref": "yaml-spec-v0.2.schema.json#/$defs/MongoConfig"
    },
    "datastores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DatastoreConfig"
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EntityConfig"
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RepositoryConfig"
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      }
    },
    "controllers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ControllerConfig"
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "dto": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DtoConfig"
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "yaml-spec-v0.2.schema.json#/$defs/PolicyConfig"
      }
    },
    "ui": {
      "$ref": "ui.schema.json"
    },
    "deploy": {
      "$ref": "yaml-spec-v0.2.schema.json#/$defs/DeployConfig"
    },
    "session": {
      "$ref": "yaml-spec-v0.2.schema.json#/$defs/SessionConfig"
    }
  },
  "$defs": {
    "FileSize": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?\\s*([kKmMgG]?[bB])?$"
        }
      ]
    },
    "MimeTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/(\\*|[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*)$"
      }
    },
    "FileLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSize": {
          "$ref": "#/$defs/FileSize"
        },
        "types": {
          "$ref": "#/$defs/MimeTypes"
        }
      }
    },
    "WhereExpression": {
      "type": "string",
      "pattern": "^[\\w$][\\w$.'\"\\s=<>!,()+\\\\-]*$",
      "description": "Where binding form used as a given: value: '<collection> where <field> = <rhs> [and <field> = <rhs>]*'. The where parser owns the grammar; this pattern only bounds the character set."
    },
    "SymbolBinding": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Map of names to $-sigil symbols or scalar literals, backing access-rule bind: and service with:."
    },
    "InputConfig": {
      "description": "Named inputs a service requires.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "datetime",
                  "enum",
                  "array",
                  "object",
                  "ref"
                ]
              },
              {
                "$ref": "#/$defs/FieldConfig"
              }
            ]
          }
        }
      ]
    },
    "EntityConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "base",
            "auth"
          ],
          "default": "base"
        },
        "extends": {
          "type": "string"
        },
        "abstract": {
          "type": "boolean"
        },
        "pk": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "auth": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/EntityAuthConfig"
        },
        "roles": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/RolesConfig"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "extends"
              ]
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "auth"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "auth"
            ]
          }
        }
      ]
    },
    "ProviderConfig": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "oidc",
            "saml"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/OIDCProviderConfig"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "saml"
              }
            }
          },
          "then": {
            "$ref": "yaml-spec-v0.2.schema.json#/$defs/SAMLProviderConfig"
          }
        }
      ]
    },
    "OIDCProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "client_id",
        "discovery_url"
      ],
      "properties": {
        "type": {
          "const": "oidc"
        },
        "trust": {
          "type": "string",
          "enum": [
            "app",
            "idp"
          ],
          "default": "app"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "discovery_url": {
          "type": "string",
          "description": "OIDC discovery document URL; issuer is derived from it automatically"
        },
        "issuer": {
          "type": "string"
        },
        "audiences": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/StringList",
          "description": "Accepted token audiences; defaults to [client_id] when omitted"
        },
        "pkce": {
          "type": "boolean",
          "default": false,
          "description": "Emit PKCE (S256 code_challenge on authorization, code_verifier on token exchange)"
        },
        "dpop": {
          "type": "boolean",
          "default": false,
          "description": "Emit DPoP (RFC 9449) proofs on the token and userinfo calls, switching them from Bearer to DPoP-bound"
        }
      },
      "if": {
        "properties": {
          "trust": {
            "const": "idp"
          }
        },
        "required": [
          "trust"
        ]
      },
      "then": {
        "properties": {
          "pkce": false,
          "dpop": false
        }
      },
      "else": {
        "properties": {
          "issuer": false
        }
      }
    },
    "DtoConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        }
      }
    },
    "FieldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "datetime",
            "enum",
            "array",
            "object",
            "ref",
            "id",
            "file"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "unique": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "format": {
          "enum": [
            "email",
            "e164",
            "uri",
            "uuidv7",
            "uuidv4"
          ]
        },
        "values": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/StringList"
        },
        "items": {
          "$ref": "#/$defs/FieldConfig"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "ref": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean"
        },
        "maxSize": {
          "$ref": "#/$defs/FileSize"
        },
        "types": {
          "$ref": "#/$defs/MimeTypes"
        },
        "disposition": {
          "enum": [
            "attachment",
            "inline"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        }
      ]
    },
    "DatastoreConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "mongodb",
            "mongo",
            "postgres",
            "postgresql",
            "filesystem",
            "s3"
          ]
        },
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "dsn": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "accessKey": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "files": {
          "$ref": "#/$defs/FileLimits"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "filesystem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "s3"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "bucket"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "mongodb",
                  "mongo",
                  "postgres",
                  "postgresql"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "files"
              ]
            }
          }
        }
      ]
    },
    "RepositoryConfig": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "yaml-spec-v0.2.schema.json#/$defs/RepositoryLifecycleRules" }],
      "properties": {
        "softDelete": {
          "type": "string"
        },
        "ttl": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/TtlConfig"
        },
        "abstract": {
          "type": "boolean"
        },
        "extends": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "files": {
          "type": "string"
        },
        "crud": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "create",
              "update",
              "replace",
              "delete"
            ]
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "yaml-spec-v0.2.schema.json#/$defs/OperationConfig"
          },
          "propertyNames": {
            "$ref": "yaml-spec-v0.2.schema.json#/$defs/OperationName"
          }
        }
      }
    },
    "ServiceConfig": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "required": [
          "handler",
          "operation"
        ]
      },
      "properties": {
        "abstract": {
          "type": "boolean"
        },
        "extends": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputConfig"
        },
        "with": {
          "$ref": "#/$defs/SymbolBinding"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handler"
                ],
                "properties": {
                  "handler": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "$ref": "yaml-spec-v0.2.schema.json#/$defs/OperationName"
          }
        }
      }
    },
    "ControllerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string"
        },
        "base_path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/OperationOverride"
              }
            ]
          }
        },
        "routes": {
          "type": "object"
        }
      },
      "if": {
        "required": [
          "service"
        ]
      },
      "then": {
        "properties": {
          "routes": {
            "additionalProperties": {
              "$ref": "#/$defs/RouteOverride"
            }
          },
          "operations": {
            "propertyNames": {
              "$ref": "yaml-spec-v0.2.schema.json#/$defs/OperationName"
            }
          }
        }
      },
      "else": {
        "properties": {
          "routes": {
            "additionalProperties": {
              "$ref": "#/$defs/RouteConfig"
            }
          }
        }
      }
    },
    "OperationOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/HttpMethod"
        },
        "path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationConfig"
        }
      }
    },
    "RouteOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationConfig"
        }
      }
    },
    "RouteConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "method",
        "path"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "method": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/HttpMethod"
        },
        "path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationConfig"
        }
      }
    },
    "PaginationConfig": {
      "description": "Controller pagination.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "size"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "offset",
            "keyset"
          ]
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "max"
          ],
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "count": {
          "type": "string",
          "enum": [
            "none",
            "exact"
          ],
          "default": "none"
        },
        "onOverflow": {
          "type": "string",
          "enum": [
            "clamp",
            "reject"
          ],
          "default": "clamp"
        },
        "envelope": {
          "type": "boolean",
          "default": false
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "dir": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "default": "asc"
              }
            }
          }
        }
      }
    },
    "AccessConfig": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/AccessRule"
              }
            ]
          }
        }
      ]
    },
    "AccessRule": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "given"
          ]
        },
        {
          "required": [
            "then"
          ]
        },
        {
          "required": [
            "when"
          ]
        }
      ],
      "properties": {
        "given": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^identity:[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "type": "string",
                "pattern": "^request(\\.(body|path|query|header|cookie))?(:[A-Za-z_][A-Za-z0-9_]*)?$"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\s+by\\s+[A-Za-z_][A-Za-z0-9_]*)?$"
              },
              {
                "$ref": "#/$defs/WhereExpression"
              }
            ]
          }
        },
        "when": {
          "$ref": "yaml-spec-v0.2.schema.json#/$defs/WhenConfig"
        },
        "then": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "default": "allow"
        },
        "reason": {
          "type": "string"
        },
        "bind": {
          "$ref": "#/$defs/SymbolBinding"
        }
      }
    }
  }
}
