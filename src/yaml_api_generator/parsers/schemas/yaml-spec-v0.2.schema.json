{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaml-spec-v0.2.schema.json",
  "title": "YAML API Generator Structure Spec v0.2",
  "type": "object",
  "required": ["version", "entities"],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.2"
    },
    "api": {
      "type": "object",
      "properties": {
        "basePath": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "operations": {
          "type": "object",
          "properties": {
            "defaults": {
              "$ref": "#/$defs/OperationFlags"
            },
            "auth": {
              "$ref": "#/$defs/OperationFlags"
            }
          }
        },
        "cors": {
          "type": "object",
          "properties": {
            "origins": {
              "type": "array",
              "items": { "type": "string" }
            },
            "methods": {
              "type": "array",
              "items": { "type": "string" }
            },
            "headers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "credentials": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mongo": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EntityConfig"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RepositoryConfig"
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      }
    },
    "controllers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ControllerConfig"
      }
    },
    "deploy": { "$ref": "#/$defs/DeployConfig" },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "ui": {
      "type": "object"
    }
  },
  "$defs": {
    "OperationFlags": {
      "type": "object",
      "properties": {
        "list": { "type": "boolean" },
        "get": { "type": "boolean" },
        "create": { "type": "boolean" },
        "update": { "type": "boolean" },
        "replace": { "type": "boolean" },
        "delete": { "type": "boolean" },
        "register": { "type": "boolean" },
        "login": { "type": "boolean" }
      }
    },
    "EntityConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["base", "auth"],
          "default": "base"
        },
        "extends": {
          "type": "string"
        },
        "abstract": {
          "type": "boolean"
        },
        "pk": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "via": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderBinding" },
          "minItems": 1
        },
        "roles": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "not": { "required": ["extends"] }
          },
          "then": {
            "required": ["fields"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "auth" } },
            "required": ["type"]
          },
          "then": {
            "required": ["via"]
          }
        }
      ]
    },
    "ProviderBinding": {
      "type": "object",
      "required": ["provider", "identifier"],
      "properties": {
        "provider": { "type": "string" },
        "identifier": { "type": "string" },
        "claim_mapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "auto_provision": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ProviderConfig": {
      "oneOf": [
        { "$ref": "#/$defs/OIDCProviderConfig" },
        { "$ref": "#/$defs/SAMLProviderConfig" }
      ]
    },
    "OIDCProviderConfig": {
      "type": "object",
      "required": ["type", "client_id", "client_secret"],
      "properties": {
        "type": { "type": "string", "const": "oidc" },
        "client_id": { "type": "string" },
        "client_secret": { "type": "string" },
        "discovery_url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SAMLProviderConfig": {
      "type": "object",
      "required": ["type", "idp_metadata_url", "sp_entity_id"],
      "properties": {
        "type": { "type": "string", "const": "saml" },
        "idp_metadata_url": { "type": "string" },
        "sp_entity_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FieldConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "datetime", "enum", "array", "object", "ref", "id"]
        },
        "required": { "type": "boolean" },
        "default": {},
        "unique": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer" },
        "maxLength": { "type": "integer" },
        "format": {
          "enum": ["email", "e164", "uri", "uuidv7", "uuidv4"]
        },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items": { "$ref": "#/$defs/FieldConfig" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FieldConfig" }
        },
        "additionalProperties": { "type": "boolean" },
        "ref": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["values"] }
        },
        {
          "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "then": { "required": ["items"] }
        },
        {
          "if": { "properties": { "type": { "const": "ref" } }, "required": ["type"] },
          "then": { "required": ["ref"] }
        }
      ]
    },
    "RepositoryConfig": {
      "type": "object",
      "required": ["entity"],
      "properties": {
        "entity": {
          "type": "string"
        },
        "operations": {
          "$ref": "#/$defs/OperationFlags"
        }
      }
    },
    "ServiceConfig": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "properties": {
                  "handler": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "ControllerConfig": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "base_path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "operations": {
          "type": "object"
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RouteConfig"
          }
        }
      }
    },
    "RouteConfig": {
      "type": "object",
      "required": ["service", "method", "path"],
      "properties": {
        "service": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": { "type": "string" },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        }
      }
    },
    "AccessConfig": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/AccessRule" }
            ]
          }
        }
      ]
    },
    "DeployConfig": {
      "type": "object",
      "required": ["runtime"],
      "properties": {
        "name": { "type": "string" },
        "port": { "type": "integer", "default": 8000 },
        "runtime": { "type": "string", "enum": ["docker", "systemd"] },
        "mongo": {
          "type": "object",
          "properties": {
            "local": { "type": "boolean", "default": false }
          }
        },
        "docker": {
          "type": "object",
          "properties": {
            "image": { "type": "string" }
          }
        },
        "systemd": {
          "type": "object",
          "properties": {
            "user": { "type": "string" },
            "restart": { "type": "string" }
          }
        }
      }
    },
    "AccessRule": {
      "type": "object",
      "anyOf": [
        { "required": ["given"] },
        { "required": ["then"] }
      ],
      "properties": {
        "given": {
          "type": "object",
          "required": ["principal"],
          "properties": {
            "principal": {
              "oneOf": [
                { "type": "string", "enum": ["public", "authenticated"] },
                { "type": "string", "pattern": "^identity:[A-Za-z_][A-Za-z0-9_]*$" }
              ]
            },
            "document": { "type": "string" }
          },
          "additionalProperties": false
        },
        "when": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "then": {
          "type": "string",
          "enum": ["allow", "deny"],
          "default": "allow"
        },
        "filter": { "type": "string" },
        "writeFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" }
      }
    }
  }
}
