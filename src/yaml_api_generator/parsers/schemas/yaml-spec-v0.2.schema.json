{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaml-spec-v0.2.schema.json",
  "title": "YAML API Generator Structure Spec v0.2",
  "type": "object",
  "required": [
    "version",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "0.2"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePath": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "operations": {
          "$ref": "#/$defs/ApiOperations"
        },
        "cors": {
          "$ref": "#/$defs/CorsConfig"
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mongo": {
      "$ref": "#/$defs/MongoConfig"
    },
    "datastores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DatastoreConfig"
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EntityConfig"
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RepositoryConfig"
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      }
    },
    "controllers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ControllerConfig"
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "dto": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DtoConfig"
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PolicyConfig"
      }
    },
    "ui": {
      "$ref": "ui.schema.json"
    },
    "deploy": {
      "$ref": "#/$defs/DeployConfig"
    },
    "session": {
      "$ref": "#/$defs/SessionConfig"
    }
  },
  "$defs": {
    "ApiOperations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/CrudFlags"
        },
        "auth": {
          "$ref": "#/$defs/AuthFlags"
        }
      }
    },
    "CrudFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "boolean"
        },
        "get": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "replace": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      }
    },
    "AuthFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "register": {
          "type": "boolean"
        },
        "login": {
          "type": "boolean"
        }
      }
    },
    "CorsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origins": {
          "$ref": "#/$defs/StringList"
        },
        "methods": {
          "$ref": "#/$defs/StringList"
        },
        "headers": {
          "$ref": "#/$defs/StringList"
        },
        "credentials": {
          "type": "boolean"
        }
      }
    },
    "StringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "MongoConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        }
      }
    },
    "SessionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "HS256",
            "RS256"
          ],
          "default": "HS256"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        },
        "refresh": {
          "type": "boolean",
          "default": false
        },
        "delivery": {
          "type": "string",
          "enum": [
            "token-url",
            "cookie"
          ],
          "default": "token-url"
        }
      }
    },
    "EntityConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "base",
            "auth"
          ],
          "default": "base"
        },
        "extends": {
          "type": "string"
        },
        "abstract": {
          "type": "boolean"
        },
        "pk": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "auth": {
          "$ref": "#/$defs/EntityAuthConfig"
        },
        "roles": {
          "$ref": "#/$defs/RolesConfig"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "extends"
              ]
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "auth"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "auth"
            ]
          }
        }
      ]
    },
    "EntityAuthConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "via": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProviderBinding"
              },
              "minItems": 1
            }
          ]
        },
        "roles": {
          "type": "string"
        }
      },
      "if": {
        "not": {
          "required": [
            "identifier"
          ]
        }
      },
      "then": {
        "properties": {
          "via": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "identifier"
              ]
            }
          }
        }
      }
    },
    "RolesConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "default"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "default": {
          "type": "string"
        },
        "hierarchy": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StringList"
          }
        }
      }
    },
    "ProviderBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "claim_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auto_provision": {
          "type": "boolean"
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collection",
              "match"
            ],
            "properties": {
              "collection": {
                "type": "string"
              },
              "match": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ProviderConfig": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "oidc",
            "saml"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/OIDCProviderConfig"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "saml"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/SAMLProviderConfig"
          }
        }
      ]
    },
    "OIDCProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "client_id",
        "discovery_url"
      ],
      "properties": {
        "type": {
          "const": "oidc"
        },
        "trust": {
          "type": "string",
          "enum": [
            "app",
            "idp"
          ],
          "default": "app"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "discovery_url": {
          "type": "string",
          "description": "OIDC discovery document URL; issuer is derived from it automatically"
        },
        "issuer": {
          "type": "string"
        },
        "audiences": {
          "$ref": "#/$defs/StringList",
          "description": "Accepted token audiences; defaults to [client_id] when omitted"
        }
      },
      "if": {
        "properties": {
          "trust": {
            "const": "idp"
          }
        },
        "required": [
          "trust"
        ]
      },
      "then": {
        "properties": {
          "client_secret": false
        }
      },
      "else": {
        "properties": {
          "issuer": false,
          "audiences": false
        }
      }
    },
    "SAMLProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "idp_metadata_url",
        "sp_entity_id"
      ],
      "properties": {
        "type": {
          "const": "saml"
        },
        "idp_metadata_url": {
          "type": "string"
        },
        "sp_entity_id": {
          "type": "string"
        }
      }
    },
    "DtoConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        }
      }
    },
    "PolicyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "given": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "params": {
          "$ref": "#/$defs/StringList"
        },
        "when": {
          "$ref": "#/$defs/WhenConfig"
        }
      }
    },
    "WhenConfig": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "FieldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "datetime",
            "enum",
            "array",
            "object",
            "ref",
            "id"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "unique": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "format": {
          "enum": [
            "email",
            "e164",
            "uri",
            "uuidv7",
            "uuidv4"
          ]
        },
        "values": {
          "$ref": "#/$defs/StringList"
        },
        "items": {
          "$ref": "#/$defs/FieldConfig"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "ref": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        }
      ]
    },
    "OperationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/QueryConfig"
        },
        "handler": {
          "type": "string"
        }
      }
    },
    "QueryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "filter": {},
        "pipeline": {},
        "document": {},
        "documents": {},
        "update": {},
        "replacement": {},
        "requests": {},
        "params": {
          "type": "object"
        }
      },
      "description": "Repository query. Values other than the names may be a {{placeholder}} resolved from the request at call time."
    },
    "DatastoreConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "mongodb",
            "mongo",
            "postgres",
            "postgresql"
          ]
        },
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "dsn": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "RepositoryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abstract": {
          "type": "boolean"
        },
        "extends": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "crud": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "create",
              "update",
              "replace",
              "delete"
            ]
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/OperationConfig"
          }
        }
      }
    },
    "ServiceConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abstract": {
          "type": "boolean"
        },
        "extends": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handler"
                ],
                "properties": {
                  "handler": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "ControllerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string"
        },
        "base_path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/OperationOverride"
              }
            ]
          }
        },
        "routes": {
          "type": "object"
        }
      },
      "if": {
        "required": [
          "service"
        ]
      },
      "then": {
        "properties": {
          "routes": {
            "additionalProperties": {
              "$ref": "#/$defs/RouteOverride"
            }
          }
        }
      },
      "else": {
        "properties": {
          "access": false,
          "operations": false,
          "routes": {
            "additionalProperties": {
              "$ref": "#/$defs/RouteConfig"
            }
          }
        }
      }
    },
    "OperationOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        }
      }
    },
    "RouteOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/AccessConfig"
        }
      }
    },
    "RouteConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "method",
        "path"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "path": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/AccessConfig"
        }
      }
    },
    "HttpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "AccessConfig": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/AccessRule"
              }
            ]
          }
        }
      ]
    },
    "AccessRule": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "given"
          ]
        },
        {
          "required": [
            "then"
          ]
        },
        {
          "required": [
            "when"
          ]
        }
      ],
      "properties": {
        "given": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^identity:[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "type": "string",
                "pattern": "^request(\\.(body|path|query|header|cookie))?(:[A-Za-z_][A-Za-z0-9_]*)?$"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\s+by\\s+[A-Za-z_][A-Za-z0-9_]*)?$"
              }
            ]
          }
        },
        "when": {
          "$ref": "#/$defs/WhenConfig"
        },
        "then": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "default": "allow"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "DeployConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "default": 8000
        },
        "runtime": {
          "type": "string",
          "enum": [
            "docker",
            "systemd"
          ]
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DeployService"
          }
        },
        "include": {
          "$ref": "#/$defs/StringList"
        },
        "mongo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            }
          }
        },
        "systemd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user": {
              "type": "string"
            },
            "restart": {
              "type": "string"
            }
          }
        }
      }
    },
    "DeployService": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "build"
          ]
        }
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "build": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "context": {
                  "type": "string"
                },
                "dockerfile": {
                  "type": "string"
                },
                "args": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "environment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/StringList"
            }
          ]
        },
        "volumes": {
          "$ref": "#/$defs/StringList"
        },
        "depends_on": {
