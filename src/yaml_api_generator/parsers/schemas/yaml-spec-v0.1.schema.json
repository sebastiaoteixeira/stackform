{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaml-spec-v0.1.schema.json",
  "title": "YAML API Generator Structure Spec v0.1",
  "type": "object",
  "required": ["version", "collections"],
  "properties": {
    "version": {
      "type": "string"
    },
    "api": {
      "type": "object",
      "properties": {
        "basePath": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "pagination": {
          "type": "object",
          "properties": {
            "defaultPageSize": {
              "type": "integer"
            },
            "maxPageSize": {
              "type": "integer"
            }
          }
        },
        "operations": {
          "type": "object",
          "properties": {
            "defaults": {
              "$ref": "#/$defs/OperationFlags"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowCredentials": {
              "type": "boolean"
            },
            "allowedMethods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "properties": {
            "enableStandard": {
              "type": "boolean"
            }
          }
        },
        "redaction": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CollectionConfig"
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "strict": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "OperationFlags": {
      "type": "object",
      "properties": {
        "list": {
          "type": "boolean"
        },
        "get": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "replace": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      }
    },
    "CollectionConfig": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["base", "auth"],
          "default": "base"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "auth": {
          "$ref": "#/$defs/AuthCollectionConfig"
        },
        "operations": {
          "$ref": "#/$defs/OperationFlags"
        },
        "access": {
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/AccessOperationConfig"
            },
            "get": {
              "$ref": "#/$defs/AccessOperationConfig"
            },
            "create": {
              "$ref": "#/$defs/AccessOperationConfig"
            },
            "update": {
              "$ref": "#/$defs/AccessOperationConfig"
            },
            "replace": {
              "$ref": "#/$defs/AccessOperationConfig"
            },
            "delete": {
              "$ref": "#/$defs/AccessOperationConfig"
            }
          }
        },
        "softDelete": {
          "type": "boolean"
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexConfig"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "auth"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["auth"]
          }
        }
      ]
    },
    "AuthCollectionConfig": {
      "type": "object",
      "required": ["identifier", "via"],
      "properties": {
        "identifier": {
          "type": "string"
        },
        "via": {
          "oneOf": [
            {
              "$ref": "#/$defs/AuthMethod"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AuthMethod"
              }
            }
          ]
        }
      }
    },
    "AuthMethod": {
      "type": "string",
      "enum": ["password", "apiKey"]
    },
    "FieldConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "datetime", "enum", "array", "object", "ref", "id"]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "unique": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "format": {
          "enum": ["email", "e164", "uri", "uuidv7", "uuidv4"]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "$ref": "#/$defs/FieldConfigLite"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldConfig"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "ref": {
          "type": "string"
        },
        "store": {
          "enum": ["id", "embed"]
        },
        "expand": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "always": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxDepth": {
              "type": "integer"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["values"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["items"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["ref"]
          }
        }
      ]
    },
    "FieldConfigLite": {
      "$ref": "#/$defs/FieldConfig"
    },
    "AccessRule": {
      "type": "object",
      "required": ["principal"],
      "properties": {
        "principal": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["public", "authenticated"]
            },
            {
              "type": "string",
              "pattern": "^identity:[A-Za-z_][A-Za-z0-9_]*$"
            }
          ]
        },
        "when": {
          "type": "string"
        },
        "filter": {
          "type": "string"
        },
        "writeFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "AccessOperationConfig": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessRule"
          }
        },
        {
          "type": "string",
          "enum": ["public", "authenticated"]
        },
        {
          "type": "string",
          "pattern": "^identity:[A-Za-z_][A-Za-z0-9_]*$"
        }
      ]
    },
    "IndexConfig": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexField"
          }
        },
        "unique": {
          "type": "boolean"
        },
        "sparse": {
          "type": "boolean"
        },
        "ttlSeconds": {
          "type": "integer"
        },
        "text": {
          "type": "boolean"
        }
      }
    },
    "IndexField": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string"
        },
        "order": {
          "enum": ["asc", "desc"]
        }
      }
    }
  }
}
