{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaml-spec-v0.1.schema.json",
  "title": "YAML API Generator Structure Spec v0.1",
  "type": "object",
  "required": ["version", "collections"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePath": { "type": "string" },
        "version": { "type": "string" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultPageSize": { "type": "integer" },
            "maxPageSize": { "type": "integer" }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaults": { "$ref": "#/$defs/OperationFlags" }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": { "$ref": "#/$defs/StringList" },
            "allowCredentials": { "type": "boolean" },
            "allowedMethods": { "$ref": "#/$defs/StringList" }
          },
          "if": { "properties": { "allowCredentials": { "const": true } }, "required": ["allowCredentials"] },
          "then": { "properties": { "allowedOrigins": { "not": { "contains": { "const": "*" } } } } }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enableStandard": { "type": "boolean" }
          }
        }
      }
    },
    "collections": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/CollectionConfig" }
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ProviderConfig" }
    },
    "mongo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "database": { "type": "string" }
      }
    },
    "ui": { "$ref": "ui.schema.json" }
  },
  "$defs": {
    "StringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "OperationFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": { "type": "boolean" },
        "get": { "type": "boolean" },
        "create": { "type": "boolean" },
        "update": { "type": "boolean" },
        "replace": { "type": "boolean" },
        "delete": { "type": "boolean" }
      }
    },
    "CollectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["base", "auth"],
          "default": "base"
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FieldConfig" }
        },
        "auth": { "$ref": "#/$defs/AuthCollectionConfig" },
        "roles": { "$ref": "#/$defs/RolesConfig" },
        "operations": { "$ref": "#/$defs/OperationFlags" },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "list": { "$ref": "#/$defs/AccessOperationConfig" },
            "get": { "$ref": "#/$defs/AccessOperationConfig" },
            "create": { "$ref": "#/$defs/AccessOperationConfig" },
            "update": { "$ref": "#/$defs/AccessOperationConfig" },
            "replace": { "$ref": "#/$defs/AccessOperationConfig" },
            "delete": { "$ref": "#/$defs/AccessOperationConfig" }
          }
        },
        "softDelete": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "auth" } },
            "required": ["type"]
          },
          "then": { "required": ["auth"] }
        }
      ]
    },
    "AuthCollectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "via"],
      "properties": {
        "identifier": { "type": "string" },
        "via": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/StringList" }
          ]
        }
      }
    },
    "ProviderConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["oidc", "saml"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "oidc" } } },
          "then": { "$ref": "#/$defs/OIDCProviderConfig" }
        },
        {
          "if": { "properties": { "type": { "const": "saml" } } },
          "then": { "$ref": "#/$defs/SAMLProviderConfig" }
        }
      ]
    },
    "OIDCProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "client_id", "client_secret"],
      "properties": {
        "type": { "const": "oidc" },
        "client_id": { "type": "string" },
        "client_secret": { "type": "string" }
      }
    },
    "SAMLProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "idp_metadata_url", "sp_entity_id"],
      "properties": {
        "type": { "const": "saml" },
        "idp_metadata_url": { "type": "string" },
        "sp_entity_id": { "type": "string" }
      }
    },
    "FieldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "datetime", "enum", "array", "object", "ref", "id"]
        },
        "required": { "type": "boolean" },
        "default": {},
        "unique": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer" },
        "maxLength": { "type": "integer" },
        "format": {
          "enum": ["email", "e164", "uri", "uuidv7", "uuidv4"]
        },
        "values": { "$ref": "#/$defs/StringList" },
        "items": { "$ref": "#/$defs/FieldConfig" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FieldConfig" }
        },
        "additionalProperties": { "type": "boolean" },
        "ref": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["values"] }
        },
        {
          "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "then": { "required": ["items"] }
        },
        {
          "if": { "properties": { "type": { "const": "ref" } }, "required": ["type"] },
          "then": { "required": ["ref"] }
        }
      ]
    },
    "RolesConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "default"],
      "properties": {
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "default": { "type": "string" },
        "hierarchy": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/StringList" }
        }
      }
    },
    "Principal": {
      "anyOf": [
        { "type": "string", "enum": ["public", "*"] },
        { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*:(?:[A-Za-z_][A-Za-z0-9_]*|\\*)$" },
        { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      ]
    },
    "AccessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal"],
      "properties": {
        "principal": { "$ref": "#/$defs/Principal" },
        "when": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "AccessOperationConfig": {
      "anyOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/AccessRule" }
        },
        { "$ref": "#/$defs/Principal" }
      ]
    }
  }
}
